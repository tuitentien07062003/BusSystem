@import "tailwindcss";
@import "leaflet/dist/leaflet.css";

/* ═══════════════════════════════════════════════════════════════
   TBus Design System
   Brand color: #169BA2 (teal) — no gradient
   ═══════════════════════════════════════════════════════════════ */
@theme {
  /* ─── Primary (TBus brand) ─── */
  --color-brand-50: #e6f4f5;
  --color-brand-100: #c2e4e6;
  --color-brand-200: #a8d5d8;
  --color-brand-300: #7bc0c4;
  --color-brand-400: #4dabb0;
  --color-brand-500: #169ba2; /* MAIN */
  --color-brand-600: #12868c;
  --color-brand-700: #0f7075;
  --color-brand-800: #0b5a5e;
  --color-brand-900: #084447;

  /* ─── Accent (orange from logo) ─── */
  --color-accent-400: #f5b778;
  --color-accent-500: #f5a25d;
  --color-accent-600: #e08940;

  /* ─── Neutrals ─── */
  --color-page: #eef2f6;
  --color-panel: #ffffff;
  --color-surface: #f8fafc;
  --color-line: #d0d7e2;
  --color-line-soft: #e5eaf0;

  --color-ink-900: #1a2332;
  --color-ink-700: #38445a;
  --color-ink-500: #6a7a9a;
  --color-ink-400: #8a9aaa;
  --color-ink-300: #b0bcca;
}

/* ─── Reset ─── */
* {
  box-sizing: border-box;
}
html,
body,
#root {
  min-height: 100%;
  margin: 0;
  padding: 0;
}
body {
  font-family: "Inter", "Segoe UI", Roboto, system-ui, sans-serif;
  background: var(--color-page);
  color: var(--color-ink-900);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  overflow-x: hidden;
}

/* ─── Slider ─── */
input[type="range"].slider-custom {
  -webkit-appearance: none;
  appearance: none;
  height: 4px;
  border-radius: 2px;
  background: var(--color-line);
  outline: none;
  cursor: pointer;
}
input[type="range"].slider-custom::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: var(--color-brand-500);
  cursor: pointer;
  transition: transform 0.15s;
}
input[type="range"].slider-custom::-webkit-slider-thumb:hover {
  transform: scale(1.15);
}

/* ─── Scrollbar ─── */
.scrollbar-thin::-webkit-scrollbar {
  width: 4px;
  height: 4px;
}
.scrollbar-thin::-webkit-scrollbar-thumb {
  background: var(--color-line);
  border-radius: 4px;
}
.scrollbar-thin::-webkit-scrollbar-thumb:hover {
  background: var(--color-ink-400);
}

/* ─── Leaflet popup ─── */
.bus-popup b {
  font-size: 14px;
  color: var(--color-ink-900);
}
.bus-popup .sub {
  color: var(--color-ink-500);
  font-size: 11px;
  margin-top: 2px;
}

/* ─── Animations ─── */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
.animate-fade-up {
  animation: fadeInUp 0.3s ease-out both;
}
