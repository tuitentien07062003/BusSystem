<file path="src/passenger/pages/SearchPage.jsx">
import { useState, useEffect } from "react";
import { useNavigate, useSearchParams } from "react-router-dom";
import {
  Navigation,
  Search,
  Loader2,
  ArrowRight,
  Map as MapIcon,
  List,
  X,
  ChevronRight,
  Clock,
  Bus,
  AlertCircle,
} from "lucide-react";
import {
  getNearbyStops,
  getAllStops,
  searchDirectRoutes,
  searchTransferRoutes,
} from "../api/discoveryApi";
import { StopPickerDialog } from "../components/search/StopPickerDialog";
import { PassengerMap } from "../components/map/PassengerMap";
import { toast } from "sonner";

export function SearchPage() {
  const navigate = useNavigate();
  const [urlParams] = useSearchParams();

  const [userPos, setUserPos] = useState(null);
  const [nearbyStops, setNearbyStops] = useState([]);
  const [isLocating, setIsLocating] = useState(true);

  const [fromStop, setFromStop] = useState(null);
  const [toStop, setToStop] = useState(null);
  const [pickerMode, setPickerMode] = useState(null);

  const [isSearching, setIsSearching] = useState(false);
  const [results, setResults] = useState(null);
  const [view, setView] = useState("map");

  useEffect(() => {
    const stopId = urlParams.get("stopId");
    if (stopId) {
      getAllStops()
        .then((res) => {
          const s = (res.data || []).find(
            (x) => String(x.id) === String(stopId),
          );
          if (s) setFromStop(s);
        })
        .catch(() => {});
    }
  }, [urlParams]);

  useEffect(() => {
    if (!navigator.geolocation) {
      setIsLocating(false);
      return;
    }
    navigator.geolocation.getCurrentPosition(
      async (pos) => {
        const { latitude, longitude } = pos.coords;
        setUserPos([latitude, longitude]);
        try {
          const res = await getNearbyStops({
            lat: latitude,
            lng: longitude,
            radius: 2000,
            limit: 30,
          });
          setNearbyStops(res.data || []);
        } catch {}
        setIsLocating(false);
      },
      () => setIsLocating(false),
      { timeout: 10000 },
    );
  }, []);

  const handleSearch = async () => {
    if (!fromStop || !toStop) {
      toast.error("Vui lòng chọn điểm đi và điểm đến.");
      return;
    }
    setIsSearching(true);
    setResults(null);
    try {
      const [direct, transfer] = await Promise.all([
        searchDirectRoutes({ from: fromStop.id, to: toStop.id }).catch(() => ({
          data: [],
        })),
        searchTransferRoutes({
          from: fromStop.id,
          to: toStop.id,
          limit: 5,
        }).catch(() => ({ data: [] })),
      ]);
      setResults({
        direct: direct.data || [],
        transfer: transfer.data || [],
      });
      setView("list");
    } catch (err) {
      toast.error(err?.response?.data?.error || "Không tìm được đường.");
    } finally {
      setIsSearching(false);
    }
  };

  const mapCenter = userPos || [10.7769, 106.7009];
  const totalResults =
    (results?.direct?.length || 0) + (results?.transfer?.length || 0);

  return (
    <div className="min-h-screen pb-20">
      <div className="sticky top-0 z-20 bg-white border-b border-[#E5EAF0]">
        <div className="px-5 pt-4 pb-2">
          <h1 className="text-xl font-bold text-[#1A2332]">Tìm đường</h1>
          <p className="text-xs text-[#8A9AAA] mt-0.5">
            Nhập điểm đi và điểm đến để nhận gợi ý lộ trình
          </p>
        </div>

        <div className="px-4 py-3 space-y-2">
          <button
            onClick={() => setPickerMode("from")}
            className="w-full flex items-center gap-3 p-3 rounded-xl bg-[#F8FAFC] hover:bg-[#EEF2F6] transition-colors text-left"
          >
            <div className="w-8 h-8 rounded-full bg-[#169BA2] text-white flex items-center justify-center flex-shrink-0 text-xs font-bold">
              A
            </div>
            <div className="flex-1 min-w-0">
              {fromStop ? (
                <>
                  <div className="text-sm font-bold text-[#1A2332] truncate">
                    {fromStop.name}
                  </div>
                  <div className="text-xs text-[#8A9AAA]">{fromStop.code}</div>
                </>
              ) : (
                <span className="text-sm text-[#8A9AAA]">Chọn điểm đi</span>
              )}
            </div>
            <ChevronRight size={16} className="text-[#B0BCCA]" />
          </button>

          <button
            onClick={() => setPickerMode("to")}
            className="w-full flex items-center gap-3 p-3 rounded-xl bg-[#F8FAFC] hover:bg-[#EEF2F6] transition-colors text-left"
          >
            <div className="w-8 h-8 rounded-full bg-[#C62828] text-white flex items-center justify-center flex-shrink-0 text-xs font-bold">
              B
            </div>
            <div className="flex-1 min-w-0">
              {toStop ? (
                <>
                  <div className="text-sm font-bold text-[#1A2332] truncate">
                    {toStop.name}
                  </div>
                  <div className="text-xs text-[#8A9AAA]">{toStop.code}</div>
                </>
              ) : (
                <span className="text-sm text-[#8A9AAA]">Chọn điểm đến</span>
              )}
            </div>
            <ChevronRight size={16} className="text-[#B0BCCA]" />
          </button>

          <div className="flex gap-2">
            <button
              onClick={handleSearch}
              disabled={isSearching || !fromStop || !toStop}
              className="flex-1 h-11 rounded-xl bg-[#169BA2] text-white font-bold text-sm hover:bg-[#0F7075] disabled:opacity-50 flex items-center justify-center gap-2"
            >
              {isSearching ? (
                <Loader2 size={16} className="animate-spin" />
              ) : (
                <Search size={16} />
              )}
              {isSearching ? "Đang tìm..." : "Tìm đường"}
            </button>
            {(fromStop || toStop || results) && (
              <button
                onClick={() => {
                  setFromStop(null);
                  setToStop(null);
                  setResults(null);
                  setView("map");
                }}
                className="px-3 h-11 rounded-xl border border-[#D0D7E2] text-[#6A7A9A] font-semibold text-sm hover:bg-[#F8FAFC]"
              >
                <X size={16} />
              </button>
            )}
          </div>
        </div>

        {results && totalResults > 0 && (
          <div className="px-4 pb-3">
            <div className="inline-flex bg-[#F8FAFC] p-1 rounded-lg border border-[#E5EAF0] w-full">
              <button
                onClick={() => setView("map")}
                className={`flex-1 py-1.5 text-xs font-semibold rounded-md transition-colors flex items-center justify-center gap-1.5 ${
                  view === "map"
                    ? "bg-white text-[#169BA2] shadow-sm"
                    : "text-[#6A7A9A]"
                }`}
              >
                <MapIcon size={14} /> Bản đồ
              </button>
              <button
                onClick={() => setView("list")}
                className={`flex-1 py-1.5 text-xs font-semibold rounded-md transition-colors flex items-center justify-center gap-1.5 ${
                  view === "list"
                    ? "bg-white text-[#169BA2] shadow-sm"
                    : "text-[#6A7A9A]"
                }`}
              >
                <List size={14} /> Danh sách
              </button>
            </div>
          </div>
        )}
      </div>

      {view === "map" && (
        <div className="p-3">
          <PassengerMap
            center={mapCenter}
            userPosition={userPos}
            stops={nearbyStops}
            onStopClick={(s) => {
              if (!fromStop) setFromStop(s);
              else if (!toStop) setToStop(s);
            }}
            height={420}
          />
          {isLocating && (
            <div className="mt-2 text-xs text-[#8A9AAA] flex items-center gap-1">
              <Loader2 size={12} className="animate-spin" /> Đang định vị...
            </div>
          )}
          {!isLocating && !userPos && (
            <div className="mt-2 text-xs text-[#C62828] flex items-center gap-1">
              <AlertCircle size={12} /> Không lấy được vị trí. Bấm trạm để chọn.
            </div>
          )}
          {nearbyStops.length > 0 && !results && (
            <div className="mt-3 text-xs text-[#6A7A9A] leading-relaxed bg-[#F8FAFC] p-3 rounded-xl border border-[#E5EAF0]">
              💡 Bấm vào icon trạm trên bản đồ để chọn <b>điểm đi</b> hoặc{" "}
              <b>điểm đến</b> nhanh
            </div>
          )}
        </div>
      )}

      {view === "list" && results && (
        <div className="p-4 space-y-4">
          {results.direct?.length > 0 && (
            <div>
              <h3 className="text-sm font-bold text-[#1A2332] mb-2 flex items-center gap-2">
                <Bus size={16} className="text-[#169BA2]" />
                Tuyến trực tiếp ({results.direct.length})
              </h3>
              <div className="space-y-2">
                {results.direct.map((r, i) => (
                  <div
                    key={i}
                    onClick={() =>
                      navigate(`/passenger/routes/${r.route_id || r.id}`)
                    }
                    className="p-3 rounded-xl border border-[#E5EAF0] bg-white hover:border-[#169BA2]/40 cursor-pointer transition-colors"
                  >
                    <div className="flex items-start gap-3">
                      <div className="w-12 h-12 rounded-lg bg-[#E6F4F5] text-[#0F7075] flex items-center justify-center font-bold text-sm flex-shrink-0">
                        {r.short_name || r.route_short_name || "?"}
                      </div>
                      <div className="flex-1 min-w-0">
                        <div className="text-sm font-bold text-[#1A2332] truncate">
                          {r.full_name || r.route_full_name || "(Chưa có tên)"}
                        </div>
                        <div className="text-xs text-[#8A9AAA] mt-0.5 flex items-center gap-2 flex-wrap">
                          {r.duration_min && (
                            <span className="inline-flex items-center gap-1">
                              <Clock size={11} /> {r.duration_min} phút
                            </span>
                          )}
                          {r.stops_count && <span>{r.stops_count} trạm</span>}
                        </div>
                      </div>
                      <ChevronRight
                        size={16}
                        className="text-[#B0BCCA] flex-shrink-0"
                      />
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

          {results.transfer?.length > 0 && (
            <div>
              <h3 className="text-sm font-bold text-[#1A2332] mb-2 flex items-center gap-2">
                <Navigation size={16} className="text-[#B45309]" />
                Cần chuyển tuyến ({results.transfer.length})
              </h3>
              <div className="space-y-2">
                {results.transfer.map((t, i) => (
                  <div
                    key={i}
                    className="p-3 rounded-xl border border-[#E5EAF0] bg-white"
                  >
                    <div className="flex items-center gap-2 text-xs font-semibold text-[#1A2332] mb-2 flex-wrap">
                      <span className="px-2 py-0.5 rounded bg-[#E6F4F5] text-[#0F7075]">
                        {t.legs?.[0]?.route_short_name ||
                          t.route1_short_name ||
                          "?"}
                      </span>
                      <ArrowRight size={12} className="text-[#8A9AAA]" />
                      <span className="px-2 py-0.5 rounded bg-[#FEF3E2] text-[#B45309]">
                        {t.legs?.[1]?.route_short_name ||
                          t.route2_short_name ||
                          "?"}
                      </span>
                    </div>
                    <div className="text-xs text-[#6A7A9A]">
                      Chuyển tại:{" "}
                      <span className="font-semibold text-[#1A2332]">
                        {t.transfer_stop_name || t.transfer_stop?.name || "N/A"}
                      </span>
                    </div>
                    {t.duration_min && (
                      <div className="text-xs text-[#8A9AAA] mt-1 flex items-center gap-1">
                        <Clock size={11} /> ~{t.duration_min} phút
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </div>
          )}

          {totalResults === 0 && (
            <div className="text-center py-12">
              <AlertCircle size={32} className="mx-auto mb-2 text-[#B0BCCA]" />
              <p className="text-sm text-[#8A9AAA]">
                Không tìm thấy lộ trình phù hợp.
              </p>
            </div>
          )}
        </div>
      )}
    </div>
  );
}
</file>

<file path="src/passenger/pages/TicketsPage.jsx">
import { useState, useEffect } from "react";
import {
  Ticket as TicketIcon,
  Plus,
  Loader2,
  Calendar,
  Hash,
  CheckCircle2,
  History,
  Clock,
} from "lucide-react";
import QRCodeSVG from "react-qr-code";
import { listMyTickets, getTicketDetail } from "../api/ticketsApi";
import { BuyTicketDialog } from "../components/tickets/BuyTicketDialog";
import { format } from "date-fns";
import { vi } from "date-fns/locale";

export function TicketsPage() {
  const [activeTab, setActiveTab] = useState("active");
  const [tickets, setTickets] = useState([]);
  const [isLoading, setIsLoading] = useState(true);
  const [buyOpen, setBuyOpen] = useState(false);

  const [selectedTicketId, setSelectedTicketId] = useState(null);
  const [liveTicket, setLiveTicket] = useState(null);
  const [isVerified, setIsVerified] = useState(false);

  const fetchTickets = () => {
    setIsLoading(true);
    listMyTickets()
      .then((res) => setTickets(res.data || []))
      .catch((err) => console.error(err))
      .finally(() => setIsLoading(false));
  };

  useEffect(() => {
    fetchTickets();
  }, []);

  useEffect(() => {
    if (!selectedTicketId || isVerified || activeTab === "history") return;

    const interval = setInterval(async () => {
      try {
        const res = await getTicketDetail(selectedTicketId);
        setLiveTicket(res);

        const original = tickets.find((t) => t.id === selectedTicketId);
        if (
          res.status !== "active" ||
          (original && res.remaining_uses < original.remaining_uses)
        ) {
          setIsVerified(true);
          clearInterval(interval);
          fetchTickets();
        }
      } catch (err) {
        console.error("Polling error", err);
      }
    }, 2000);

    return () => clearInterval(interval);
  }, [selectedTicketId, isVerified, tickets, activeTab]);

  const openTicket = async (ticket) => {
    setSelectedTicketId(ticket.id);
    setLiveTicket(null);
    setIsVerified(false);

    try {
      const detail = await getTicketDetail(ticket.id);
      setLiveTicket(detail);
    } catch (err) {
      console.error(err);
    }
  };

  const closeTicket = () => {
    setSelectedTicketId(null);
    setLiveTicket(null);
    setIsVerified(false);
  };

  const filteredTickets = tickets.filter((t) =>
    activeTab === "active" ? t.status === "active" : t.status !== "active",
  );

  return (
    <div className="p-5 md:p-8 max-w-[800px] mx-auto min-h-screen pb-24">
      <div className="flex items-center justify-between mb-6">
        <h1 className="text-xl font-bold text-[#1A2332]">Ví vé của tôi</h1>
        {activeTab === "active" && (
          <button
            onClick={() => setBuyOpen(true)}
            className="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#169BA2] text-white text-xs font-bold hover:bg-[#0F7075] transition-colors shadow-sm"
          >
            <Plus size={16} /> Mua vé
          </button>
        )}
      </div>

      <div className="flex bg-[#F8FAFC] p-1 rounded-xl mb-6 border border-[#E5EAF0]">
        <button
          onClick={() => setActiveTab("active")}
          className={`flex-1 py-2 text-sm font-bold rounded-lg transition-colors ${activeTab === "active" ? "bg-white text-[#169BA2] shadow-sm" : "text-[#8A9AAA]"}`}
        >
          Đang hoạt động
        </button>
        <button
          onClick={() => setActiveTab("history")}
          className={`flex-1 py-2 text-sm font-bold rounded-lg transition-colors ${activeTab === "history" ? "bg-white text-[#169BA2] shadow-sm" : "text-[#8A9AAA]"}`}
        >
          Lịch sử
        </button>
      </div>

      {isLoading ? (
        <div className="flex justify-center py-20">
          <Loader2 size={24} className="animate-spin text-[#169BA2]" />
        </div>
      ) : filteredTickets.length === 0 ? (
        <div className="text-center py-20">
          <TicketIcon size={24} className="mx-auto text-[#B0BCCA] mb-2" />
          <p className="text-sm text-[#8A9AAA]">Chưa có vé nào.</p>
        </div>
      ) : (
        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
          {filteredTickets.map((ticket) => {
            const isHistory = activeTab === "history";
            return (
              <div
                key={ticket.id}
                onClick={() => openTicket(ticket)}
                className={`bg-white border border-[#E5EAF0] rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow cursor-pointer flex ${isHistory ? "grayscale opacity-80" : ""}`}
              >
                <div className="p-4 flex-1">
                  <div className="flex items-center justify-between mb-2">
                    <span
                      className={`text-[10px] font-bold px-2 py-0.5 rounded-full ${ticket.is_student ? "bg-[#E6F4F5] text-[#0F7075]" : "bg-[#FEF3E2] text-[#B45309]"}`}
                    >
                      {ticket.is_student ? "Sinh viên" : "Thường"}
                    </span>
                    <span
                      className={`text-[10px] font-bold uppercase ${ticket.status === "active" ? "text-[#2E7D32]" : "text-[#8A9AAA]"}`}
                    >
                      {ticket.status === "active"
                        ? "Khả dụng"
                        : ticket.status === "used"
                          ? "Hết lượt"
                          : "Hết hạn"}
                    </span>
                  </div>
                  <h3 className="font-bold text-[#1A2332] text-sm mb-1 capitalize">
                    {ticket.ticket_type === "single"
                      ? "Vé lượt"
                      : ticket.ticket_type === "bundle"
                        ? "Vé tập 30"
                        : "Vé tháng"}
                  </h3>
                  <div className="text-xs text-[#8A9AAA] flex items-center gap-1 mt-2">
                    <Calendar size={12} /> HSD:{" "}
                    {format(new Date(ticket.expires_at), "dd/MM/yyyy", {
                      locale: vi,
                    })}
                  </div>
                  <div className="text-xs text-[#8A9AAA] flex items-center gap-1 mt-1">
                    <Hash size={12} /> Còn lại: {ticket.remaining_uses} lượt
                  </div>
                </div>

                {isHistory ? (
                  <div className="w-10 bg-[#B0BCCA] flex items-center justify-center border-l border-dashed border-white/40">
                    <History size={18} className="text-white" />
                  </div>
                ) : (
                  <div className="w-10 bg-[#169BA2] flex items-center justify-center border-l border-dashed border-white/40">
                    <span className="text-white text-[10px] font-bold uppercase tracking-wider rotate-90 whitespace-nowrap">
                      Quét QR
                    </span>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      )}

      {liveTicket && (
        <div className="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm">
          <div className="bg-white rounded-3xl w-full max-w-[340px] overflow-hidden animate-in zoom-in-95 text-center relative">
            {isVerified && activeTab === "active" && (
              <div className="absolute inset-0 z-50 bg-white/95 flex flex-col items-center justify-center animate-in fade-in zoom-in duration-300">
                <div className="w-24 h-24 bg-[#F1F8F1] rounded-full flex items-center justify-center mb-4">
                  <CheckCircle2
                    size={56}
                    className="text-[#2E7D32] animate-bounce"
                  />
                </div>
                <h3 className="text-xl font-bold text-[#2E7D32]">
                  Đã soát vé!
                </h3>
                <p className="text-sm text-[#8A9AAA] mt-1">
                  Chúc bạn chuyến đi vui vẻ
                </p>
                <button
                  onClick={closeTicket}
                  className="mt-8 px-6 py-2 bg-[#F0F3F7] text-[#4A5A7A] font-semibold rounded-lg"
                >
                  Đóng
                </button>
              </div>
            )}

            <div
              className={`h-2 w-full ${liveTicket.is_student ? "bg-[#169BA2]" : "bg-[#E08940]"} ${activeTab === "history" ? "bg-gray-300" : ""}`}
            />

            <div className="p-6">
              <h2 className="text-xl font-bold text-[#1A2332] mb-1">
                {activeTab === "active" ? "Vé xe buýt" : "Lịch sử vé"}
              </h2>
              <p className="text-xs text-[#8A9AAA] mb-6">
                {activeTab === "active"
                  ? "Đưa mã này cho nhân viên soát vé"
                  : `Mã vé: ${liveTicket.qr_code}`}
              </p>

              {activeTab === "active" ? (
                <>
                  <div className="bg-white p-4 rounded-2xl border-2 border-[#169BA2] border-dashed inline-block mb-4">
                    <QRCodeSVG value={liveTicket.qr_code} size={180} />
                  </div>
                  <div className="bg-[#F0F9FA] py-2 px-4 rounded-lg inline-block mb-6 border border-[#A8D5D8]">
                    <span className="text-[10px] text-[#0F7075] font-bold uppercase block mb-0.5">
                      Mã soát vé
                    </span>
                    <span className="font-mono text-lg font-bold text-[#1A2332] tracking-widest">
                      {liveTicket.qr_code}
                    </span>
                  </div>
                </>
              ) : (
                <div className="mb-6">
                  <div className="w-16 h-16 bg-[#F8FAFC] rounded-full flex items-center justify-center mx-auto mb-4 border border-[#E5EAF0]">
                    <History size={24} className="text-[#B0BCCA]" />
                  </div>

                  <h3 className="text-sm font-bold text-[#1A2332] mb-3 text-left">
                    Lịch sử quét vé
                  </h3>
                  <div className="space-y-3 max-h-[200px] overflow-y-auto pr-1 text-left">
                    {liveTicket.usage_logs &&
                    liveTicket.usage_logs.length > 0 ? (
                      liveTicket.usage_logs.map((log) => (
                        <div
                          key={log.id}
                          className="flex items-start gap-3 p-3 rounded-xl bg-[#F8FAFC] border border-[#E5EAF0]"
                        >
                          <Clock
                            size={16}
                            className="text-[#169BA2] mt-0.5 flex-shrink-0"
                          />
                          <div>
                            <div className="text-sm font-bold text-[#1A2332]">
                              {format(
                                new Date(log.scanned_at),
                                "HH:mm - dd/MM/yyyy",
                              )}
                            </div>
                            <div className="text-xs text-[#8A9AAA] mt-1">
                              Xe buýt tuyến {log.route_id || "?"} (Chuyến #
                              {log.trip_id || "?"})
                            </div>
                          </div>
                        </div>
                      ))
                    ) : (
                      <div className="text-center text-xs text-[#8A9AAA] py-4">
                        Chưa có lịch sử sử dụng.
                      </div>
                    )}
                  </div>
                </div>
              )}

              <div className="text-left space-y-2 bg-[#F8FAFC] p-4 rounded-xl mb-6">
                <div className="flex justify-between text-xs">
                  <span className="text-[#8A9AAA]">Loại vé:</span>
                  <span className="font-bold text-[#1A2332] capitalize">
                    {liveTicket.ticket_type}
                  </span>
                </div>
                <div className="flex justify-between text-xs">
                  <span className="text-[#8A9AAA]">Trạng thái:</span>
                  <span
                    className={`font-bold capitalize ${liveTicket.status === "active" ? "text-[#2E7D32]" : "text-[#C62828]"}`}
                  >
                    {liveTicket.status === "active"
                      ? "Khả dụng"
                      : liveTicket.status === "used"
                        ? "Đã hết lượt"
                        : "Hết hạn"}
                  </span>
                </div>
              </div>

              <button
                onClick={closeTicket}
                className="w-full h-11 rounded-xl bg-[#F0F3F7] text-[#4A5A7A] font-bold text-sm"
              >
                Đóng
              </button>
            </div>
          </div>
        </div>
      )}

      <BuyTicketDialog
        isOpen={buyOpen}
        onClose={() => setBuyOpen(false)}
        onSuccess={fetchTickets}
      />
    </div>
  );
}
