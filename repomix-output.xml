import { useState, useEffect, useMemo, useCallback } from 'react';
import { toast } from 'sonner';
import { useStopsList, useChangeStopStatus } from '@/hooks/useStops';
import { StopsStats } from '../components/StopsStats';
import { StopsFilters } from '../components/StopsFilters';
import { StopsTable } from '../components/StopsTable';
import { StopsTableSkeleton } from '../components/StopsTableSkeleton';
import { StopsEmptyState } from '../components/StopsEmptyState';
import { StopsPagination } from '../components/StopsPagination';
import { StopsBulkActions } from '../components/StopsBulkActions';
import { StopEditDialog } from '../components/StopEditDialog';
import { DepotsSection } from '../components/DepotsSection';
import { exportStopsToCsv } from '../utils/exportCsv';

const PAGE_SIZE = 20;

export function StopsAdminPage() {
  const [page, setPage] = useState(1);
  const [searchInput, setSearchInput] = useState('');
  const [keyword, setKeyword] = useState('');
  const [statusFilter, setStatusFilter] = useState('all');

  const [sortBy, setSortBy] = useState('id');
  const [sortOrder, setSortOrder] = useState('asc');

  const [selectedIds, setSelectedIds] = useState(new Set());
  const [editingStop, setEditingStop] = useState(null);

  // Debounce search
  useEffect(() => {
    const t = setTimeout(() => {
      setKeyword(searchInput);
      setPage(1);
    }, 250);
    return () => clearTimeout(t);
  }, [searchInput]);

  // Reset khi đổi filter
  useEffect(() => {
    setPage(1);
    setSelectedIds(new Set());
  }, [statusFilter]);

  const isActiveParam =
    statusFilter === 'all' ? undefined : statusFilter === 'true';

  // Bảng chính CHỈ lấy trạm dừng (stop_type = 0)
  const { data, isLoading, isFetching, refetch } = useStopsList({
    page,
    limit: PAGE_SIZE,
    keyword,
    is_active: isActiveParam,
    stop_type: 0, // ← CHỈ TRẠM DỪNG
  });

  const rawStops = data?.data ?? [];
  const total = data?.total ?? 0;
  const totalPages = data?.totalPages ?? 1;

  const stops = useMemo(() => {
    const list = [...rawStops];
    list.sort((a, b) => {
      const av = a[sortBy];
      const bv = b[sortBy];
      if (av == null) return 1;
      if (bv == null) return -1;
      if (typeof av === 'string') {
        return sortOrder === 'asc'
          ? av.localeCompare(bv, 'vi')
          : bv.localeCompare(av, 'vi');
      }
      return sortOrder === 'asc' ? av - bv : bv - av;
    });
    return list;
  }, [rawStops, sortBy, sortOrder]);

  const handleSort = useCallback(
    (field) => {
      if (sortBy === field) setSortOrder((o) => (o === 'asc' ? 'desc' : 'asc'));
      else {
        setSortBy(field);
        setSortOrder('asc');
      }
    },
    [sortBy]
  );

  const toggleSelect = useCallback((id) => {
    setSelectedIds((prev) => {
      const next = new Set(prev);
      if (next.has(id)) next.delete(id);
      else next.add(id);
      return next;
    });
  }, []);

  const toggleSelectAll = useCallback(
    (checked) => {
      if (checked) setSelectedIds(new Set(stops.map((s) => s.id)));
      else setSelectedIds(new Set());
    },
    [stops]
  );

  const clearSelection = useCallback(() => setSelectedIds(new Set()), []);

  const statusMutation = useChangeStopStatus();

  const bulkChange = async (is_active) => {
    const ids = Array.from(selectedIds);
    if (ids.length === 0) return;
    if (ids.length > 20 && !confirm(`Đổi trạng thái ${ids.length} trạm?`)) return;

    toast.promise(
      Promise.all(ids.map((id) => statusMutation.mutateAsync({ id, is_active }))),
      {
        loading: `Đang cập nhật ${ids.length} trạm...`,
        success: `Đã cập nhật ${ids.length} trạm`,
        error: 'Có lỗi khi cập nhật',
      }
    );
    clearSelection();
  };

  const handleExport = () => {
    exportStopsToCsv(stops, `tram-dung-trang-${page}.csv`);
    toast.success(`Đã xuất ${stops.length} trạm ra CSV`);
  };

  const handleResetFilters = () => {
    setSearchInput('');
    setKeyword('');
    setStatusFilter('all');
    setPage(1);
  };

  const hasFilter = keyword.trim() !== '' || statusFilter !== 'all';

  return (
    <div className="h-full overflow-y-auto bg-[#eef2f6]">
      <div className="max-w-[1400px] mx-auto px-6 py-6 space-y-4">
        {/* Header trang */}
        <div>
          <h1 className="text-xl font-bold text-[#1a2332]">
            Quản lý trạm dừng &amp; Depot
          </h1>
          <p className="text-xs text-[#6a7a9a] mt-1">
            Xem, tìm kiếm, chỉnh sửa và quản lý trạng thái các trạm xe buýt và bãi đỗ.
          </p>
        </div>

        <StopsStats />

        {/* ─────────────── BẢNG TRẠM DỪNG (stop_type = 0) ─────────────── */}
        <section className="space-y-3">
          <div className="flex items-center justify-between gap-2 pt-2">
            <div>
              <h2 className="text-base font-bold text-[#1a2332]">
                Danh sách trạm dừng
              </h2>
              <p className="text-[11px] text-[#6a7a9a]">
                Điểm đón / trả khách
              </p>
            </div>
            <div className="text-xs text-[#6a7a9a]">
              Tổng <b className="text-[#1a2332]">{total.toLocaleString('vi-VN')}</b> trạm
            </div>
          </div>

          <StopsFilters
            searchInput={searchInput}
            onSearchChange={setSearchInput}
            statusFilter={statusFilter}
            onStatusChange={setStatusFilter}
            onRefresh={refetch}
            onExport={handleExport}
            canExport={stops.length > 0}
            isFetching={isFetching}
            placeholder="Tìm theo tên trạm...  (nhấn / để focus)"
            enableShortcut={true}
          />

          {isLoading ? (
            <StopsTableSkeleton rows={PAGE_SIZE} />
          ) : stops.length === 0 ? (
            <StopsEmptyState hasFilter={hasFilter} onReset={handleResetFilters} />
          ) : (
            <StopsTable
              stops={stops}
              onEdit={(s) => setEditingStop(s)}
              selectedIds={selectedIds}
              onToggleSelect={toggleSelect}
              onToggleSelectAll={toggleSelectAll}
              sortBy={sortBy}
              sortOrder={sortOrder}
              onSort={handleSort}
              onFocusMap={(s) => setEditingStop(s)}
            />
          )}

          <StopsPagination
            page={page}
            totalPages={totalPages}
            total={total}
            limit={PAGE_SIZE}
            onChange={setPage}
          />
        </section>

        {/* ─────────────── BẢNG DEPOT (stop_type = 1) ─────────────── */}
        <DepotsSection onEdit={(s) => setEditingStop(s)} />
      </div>

      {/* Bulk actions cho bảng trạm dừng */}
      <StopsBulkActions
        count={selectedIds.size}
        onActivate={() => bulkChange(true)}
        onDeactivate={() => bulkChange(false)}
        onClear={clearSelection}
        isLoading={statusMutation.isPending}
      />

      {/* Dialog sửa — dùng chung cho cả 2 bảng */}
      <StopEditDialog
        stop={editingStop}
        open={!!editingStop}
        onOpenChange={(v) => !v && setEditingStop(null)}
      />
    </div>
  );
}
</file>

<file path="src/admin/pages/StudentVerificationPage.jsx">
import { useState, useEffect, useCallback } from "react";
import {
  GraduationCap,
  Check,
  X,
  Search,
  Loader2,
  AlertCircle,
} from "lucide-react";
import { getStudentVerifications, verifyStudent } from "@/api/adminStudentsApi";
import { PageHeader } from "../components/PageHeader";
import { toast } from "sonner";
import { format } from "date-fns";

export function StudentVerificationPage() {
  const [tab, setTab] = useState("pending");
  const [data, setData] = useState([]);
  const [isLoading, setIsLoading] = useState(true);
  const [search, setSearch] = useState("");

  const [rejectingId, setRejectingId] = useState(null);
  const [rejectReason, setRejectReason] = useState("");
  const [isProcessing, setIsProcessing] = useState(false);
  const [viewImage, setViewImage] = useState(null);

  const fetchData = useCallback(() => {
    setIsLoading(true);
    getStudentVerifications({ status: tab, q: search })
      .then((res) => setData(res.data || []))
      .catch(console.error)
      .finally(() => setIsLoading(false));
  }, [tab, search]);

  useEffect(() => {
    fetchData();
  }, [fetchData]);

  const handleVerify = async (id, status, reason = null) => {
    setIsProcessing(true);
    try {
      await verifyStudent(id, { status, rejection_reason: reason });
      toast.success(
        status === "verified" ? "Đã duyệt sinh viên" : "Đã từ chối",
      );
      setRejectingId(null);
      setRejectReason("");
      fetchData();
    } catch (err) {
      toast.error(err?.response?.data?.error || "Thao tác thất bại");
    } finally {
      setIsProcessing(false);
    }
  };

  const TABS = [
    { id: "pending", label: "Chờ duyệt" },
    { id: "verified", label: "Đã duyệt" },
    { id: "rejected", label: "Từ chối" },
  ];

  return (
    <div className="h-full overflow-y-auto bg-[#EEF2F6]">
      <div className="max-w-[1400px] mx-auto px-6 py-6 space-y-4">
        <PageHeader
          title="Xác minh Sinh viên"
          description="Quản lý và phê duyệt thông tin để mua vé ưu đãi"
        />

        <div className="bg-white rounded-xl border border-[#E5EAF0] flex flex-col">
          <div className="p-4 border-b border-[#E5EAF0] flex flex-col sm:flex-row items-center justify-between gap-4">
            <div className="flex bg-[#F8FAFC] p-1 rounded-lg border border-[#E5EAF0]">
              {TABS.map((t) => (
                <button
                  key={t.id}
                  onClick={() => setTab(t.id)}
                  className={`px-4 py-1.5 text-sm font-semibold rounded-md transition-colors ${
                    tab === t.id
                      ? "bg-white text-[#169BA2] shadow-sm"
                      : "text-[#6A7A9A] hover:text-[#1A2332]"
                  }`}
                >
                  {t.label}
                </button>
              ))}
            </div>

            <div className="relative w-full sm:w-[300px]">
              <Search
                className="absolute left-3 top-1/2 -translate-y-1/2 text-[#8A9AAA]"
                size={16}
              />
              <input
                type="text"
                placeholder="Tìm MSSV, tên..."
                value={search}
                onChange={(e) => setSearch(e.target.value)}
                className="w-full h-9 pl-9 pr-3 rounded-md border border-[#D0D7E2] text-sm outline-none focus:border-[#169BA2]"
              />
            </div>
          </div>

          <div className="overflow-x-auto">
            <table className="w-full text-sm text-left">
              <thead className="bg-[#F8FAFC] border-b border-[#E5EAF0] text-[#6A7A9A] uppercase text-[11px] font-bold tracking-wider">
                <tr>
                  <th className="px-4 py-3">MSSV / CCCD</th>
                  <th className="px-4 py-3">Họ tên / Năm sinh</th>
                  <th className="px-4 py-3">Trường</th>
                  <th className="px-4 py-3">Ngày gửi</th>
                  <th className="px-4 py-3 text-right">Thao tác</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-[#F0F3F7]">
                {data.map((item) => (
                  <tr
                    key={item.id}
                    className="hover:bg-[#F8FAFC] transition-colors"
                  >
                    <td className="px-4 py-3">
                      <div className="font-bold text-[#1A2332] font-mono">
                        {item.mssv}
                      </div>
                      <div className="text-xs text-[#8A9AAA] mt-0.5">
                        {item.cccd}
                      </div>
                    </td>
                    <td className="px-4 py-3">
                      <div className="font-semibold text-[#1A2332]">
                        {item.full_name}
                      </div>
                      <div className="text-xs text-[#8A9AAA] mt-0.5">
                        {item.birth_year}
                      </div>
                    </td>
                    <td className="px-4 py-3 text-[#4A5A7A]">
                      <div>{item.school}</div>
                      <div className="text-xs text-[#8A9AAA] mt-0.5">
                        {item.enrollment_year} - {item.graduation_year}
                      </div>
                    </td>
                    <td className="px-4 py-3 text-[#4A5A7A]">
                      {format(new Date(item.created_at), "dd/MM/yyyy HH:mm")}
                    </td>
                    <td className="px-4 py-3 text-right">
                      <div className="flex items-center justify-end gap-2">
                        <button
                          onClick={() => setViewImage(item.student_card_image)}
                          className="px-2.5 py-1.5 rounded bg-[#E6F4F5] text-[#169BA2] hover:bg-[#A8D5D8] font-semibold text-xs transition-colors"
                        >
                          Xem ảnh
                        </button>

                        {tab === "pending" ? (
                          <>
                            <button
                              onClick={() => handleVerify(item.id, "verified")}
                              disabled={isProcessing}
                              className="px-2.5 py-1.5 rounded bg-[#F1F8F1] text-[#2E7D32] hover:bg-[#A8D5A8] font-semibold text-xs transition-colors disabled:opacity-50"
