<file path="src/admin/components/routes/RouteOperationsPanel.jsx">
import { useState } from "react";
import {
  Loader2,
  Play,
  Pause,
  Edit3,
  X,
  Save,
  Sparkles,
  RefreshCw,
  Clock,
  DollarSign,
  Timer,
  FileText,
  Info,
  CheckCircle2,
  Ruler,
  Activity,
  AlertTriangle,
  ListOrdered,
} from "lucide-react";
import { useForm } from "react-hook-form";
import { zodResolver } from "@hookform/resolvers/zod";
import { z } from "zod";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Badge } from "@/components/ui/badge";
import {
  useRouteOperations,
  useUpdateRouteOperations,
  useDeactivateRoute,
  useRecomputeRouteStats,
} from "@/hooks/useRouteOperations";
import { useTripsList } from "@/hooks/useTrips";
import { RouteOperationForm } from "./RouteOperationForm";
import { TripGenerationDialog } from "./TripGenerationDialog";
import { RouteStatsPanel } from "./RouteStatsPanel";

// ═══════════════════════════════════════════════════════════════
// Schema cho edit form
// ═══════════════════════════════════════════════════════════════
const editSchema = z
  .object({
    description: z.string().trim().max(500).optional(),
    operating_start_time: z.string().regex(/^\d{1,2}:\d{2}$/, "HH:MM"),
    operating_end_time: z.string().regex(/^\d{1,2}:\d{2}$/, "HH:MM"),
    base_fare: z.coerce.number().int().min(0),
    min_headway_minutes: z.coerce.number().int().min(1).max(180),
    max_headway_minutes: z.coerce.number().int().min(1).max(180),
  })
  .refine((d) => d.operating_start_time < d.operating_end_time, {
    message: "Giờ mở phải nhỏ hơn giờ đóng",
    path: ["operating_end_time"],
  })
  .refine((d) => d.min_headway_minutes <= d.max_headway_minutes, {
    message: "Min phải <= Max",
    path: ["max_headway_minutes"],
  });

// ═══════════════════════════════════════════════════════════════
// Helper: format thời gian
// ═══════════════════════════════════════════════════════════════
function fmtTime(t) {
  if (!t) return "—";
  return String(t).slice(0, 5);
}

function fmtDuration(sec) {
  if (!sec) return "—";
  const h = Math.floor(sec / 3600);
  const m = Math.floor((sec % 3600) / 60);
  if (h > 0) return `${h}h ${m}p`;
  return `${m} phút`;
}

function fmtDistance(m) {
  if (!m) return "—";
  return `${(m / 1000).toFixed(2)} km`;
}

function fmtCurrency(n) {
  if (n == null) return "—";
  return n.toLocaleString("vi-VN") + " đ";
}

// ═══════════════════════════════════════════════════════════════
// Sub: InfoTile
// ═══════════════════════════════════════════════════════════════
function InfoTile({ icon: Icon, label, value, accent }) {
  return (
    <div className="flex items-start gap-3 p-4 rounded-lg bg-[#F8FAFC] border border-[#E5EAF0]">
      <div
        className={`w-9 h-9 rounded-lg flex items-center justify-center flex-shrink-0 ${
          accent ? "bg-[#E6F4F5] text-[#169BA2]" : "bg-white text-[#6A7A9A]"
        }`}
      >
        <Icon size={16} />
      </div>
      <div className="min-w-0">
        <div className="text-[10px] font-semibold uppercase tracking-wider text-[#8A9AAA] mb-0.5">
          {label}
        </div>
        <div className="text-sm font-bold text-[#1A2332] leading-tight">
          {value}
        </div>
      </div>
    </div>
  );
}

// ═══════════════════════════════════════════════════════════════
// Sub: Edit Form (inline)
// ═══════════════════════════════════════════════════════════════
function EditOperationsForm({ routeId, operations, onCancel, onSuccess }) {
  const updateMut = useUpdateRouteOperations();

  const {
    register,
    handleSubmit,
    formState: { errors, isSubmitting },
  } = useForm({
    resolver: zodResolver(editSchema),
    defaultValues: {
      description: operations.description || "",
      operating_start_time: fmtTime(operations.operating_start_time),
      operating_end_time: fmtTime(operations.operating_end_time),
      base_fare: operations.base_fare,
      min_headway_minutes: Math.floor(operations.min_headway_seconds / 60),
      max_headway_minutes: Math.floor(operations.max_headway_seconds / 60),
    },
  });

  const onSubmit = async (values) => {
    await updateMut.mutateAsync({
      routeId,
      payload: {
        description: values.description || null,
        operating_start_time: values.operating_start_time,
        operating_end_time: values.operating_end_time,
        base_fare: values.base_fare,
        min_headway_seconds: values.min_headway_minutes * 60,
        max_headway_seconds: values.max_headway_minutes * 60,
      },
    });
    onSuccess?.();
  };

  return (
    <form
      onSubmit={handleSubmit(onSubmit)}
      className="bg-white rounded-xl border-2 border-[#169BA2] p-5 space-y-4"
    >
      <div className="flex items-center gap-2 pb-3 border-b border-[#E5EAF0]">
        <Edit3 size={14} className="text-[#169BA2]" />
        <h3 className="text-sm font-bold text-[#1A2332]">
          Chỉnh sửa thông tin vận hành
        </h3>
      </div>

      {/* Mô tả */}
      <div className="space-y-1.5">
        <Label className="text-[11px] font-semibold uppercase tracking-wider text-[#8A9AAA]">
          Mô tả tuyến
        </Label>
        <textarea
          {...register("description")}
          rows={2}
          className="w-full px-3.5 py-2 rounded-lg border border-[#D0D7E2] text-sm outline-none focus:border-[#169BA2] focus:ring-2 focus:ring-[#169BA2]/20 resize-none"
        />
      </div>

      {/* Grid 2 cột */}
      <div className="grid grid-cols-2 gap-4">
        <div className="space-y-1.5">
          <Label className="text-[11px] font-semibold uppercase tracking-wider text-[#8A9AAA]">
            Giờ mở
          </Label>
          <Input
            type="time"
            {...register("operating_start_time")}
            className="font-mono"
          />
          {errors.operating_start_time && (
            <p className="text-[11px] text-rose-600">
              {errors.operating_start_time.message}
            </p>
          )}
        </div>

        <div className="space-y-1.5">
          <Label className="text-[11px] font-semibold uppercase tracking-wider text-[#8A9AAA]">
            Giờ đóng
          </Label>
          <Input
            type="time"
            {...register("operating_end_time")}
            className="font-mono"
          />
          {errors.operating_end_time && (
            <p className="text-[11px] text-rose-600">
              {errors.operating_end_time.message}
            </p>
          )}
        </div>

        <div className="space-y-1.5">
          <Label className="text-[11px] font-semibold uppercase tracking-wider text-[#8A9AAA]">
            Giá vé (VNĐ)
          </Label>
          <Input
            type="number"
            step="500"
            {...register("base_fare")}
            className="font-mono"
          />
          {errors.base_fare && (
            <p className="text-[11px] text-rose-600">
              {errors.base_fare.message}
            </p>
          )}
        </div>

        <div className="space-y-1.5">
          <Label className="text-[11px] font-semibold uppercase tracking-wider text-[#8A9AAA]">
            Giãn cách min (phút)
          </Label>
          <Input
            type="number"
            {...register("min_headway_minutes")}
            className="font-mono"
          />
          {errors.min_headway_minutes && (
            <p className="text-[11px] text-rose-600">
              {errors.min_headway_minutes.message}
            </p>
          )}
        </div>

        <div className="space-y-1.5">
          <Label className="text-[11px] font-semibold uppercase tracking-wider text-[#8A9AAA]">
            Giãn cách max (phút)
          </Label>
          <Input
            type="number"
            {...register("max_headway_minutes")}
            className="font-mono"
          />
          {errors.max_headway_minutes && (
            <p className="text-[11px] text-rose-600">
              {errors.max_headway_minutes.message}
            </p>
          )}
        </div>
      </div>

      <div className="flex items-center justify-end gap-2 pt-2">
        <Button type="button" variant="secondary" onClick={onCancel}>
          <X size={13} />
          Hủy
        </Button>
        <Button
          type="submit"
          variant="primary"
          disabled={isSubmitting}
          className="bg-[#169BA2] hover:bg-[#12868C] text-white"
        >
          {isSubmitting ? (
            <>
              <Loader2 size={13} className="animate-spin" />
              Đang lưu...
            </>
          ) : (
            <>
              <Save size={13} />
              Lưu thay đổi
            </>
          )}
        </Button>
      </div>
    </form>
  );
}

// ═══════════════════════════════════════════════════════════════
// MAIN COMPONENT
// ═══════════════════════════════════════════════════════════════
export function RouteOperationsPanel({ routeId }) {
  const [editing, setEditing] = useState(false);
  const [genDialogOpen, setGenDialogOpen] = useState(false);

  const { data, isLoading, refetch } = useRouteOperations(routeId);
  const deactivateMut = useDeactivateRoute();
  const recomputeMut = useRecomputeRouteStats();

  // Đếm trips để biết có trips chưa
  const { data: tripsData } = useTripsList({ page: 1, limit: 1 });
  const hasExistingTrips = (data?.trip_count ?? 0) > 0;

  // ─── LOADING ───
  if (isLoading) {
    return (
      <div className="flex items-center justify-center py-12">
        <Loader2 size={22} className="animate-spin text-[#169BA2]" />
      </div>
    );
  }

  if (!data) {
    return (
      <div className="text-center py-12 text-sm text-[#8A9AAA]">
        Không tải được thông tin vận hành.
      </div>
    );
  }

  const isOperating = data.is_operating;
  const ops = data.operations;
  const stats = data.stats;

  // ═══════════════════════════════════════════════════════════════
  // TRƯỜNG HỢP 1: DRAFT — hiển thị form kích hoạt
  // ═══════════════════════════════════════════════════════════════
  if (!isOperating) {
    return <RouteOperationForm routeId={routeId} onSuccess={() => refetch()} />;
  }

  // ═══════════════════════════════════════════════════════════════
  // TRƯỜNG HỢP 2: OPERATING — hiển thị metadata + actions
  // ═══════════════════════════════════════════════════════════════

  // Nếu đang edit → hiển thị form inline
  if (editing) {
    return (
      <EditOperationsForm
        routeId={routeId}
        operations={ops}
        onCancel={() => setEditing(false)}
        onSuccess={() => {
          setEditing(false);
          refetch();
        }}
      />
    );
  }

  return (
    <div className="space-y-5">
      {/* ═══════════ BANNER STATUS ═══════════ */}
      <div className="flex items-start justify-between gap-4 p-4 rounded-xl bg-[#E6F4F5] border border-[#A8D5D8]">
        <div className="flex items-start gap-3 min-w-0">
          <div className="w-10 h-10 rounded-lg bg-[#169BA2] flex items-center justify-center flex-shrink-0">
            <CheckCircle2 size={18} className="text-white" />
          </div>
          <div className="min-w-0">
            <div className="text-sm font-bold text-[#0F7075] mb-0.5">
              Tuyến đang ở trạng thái vận hành
            </div>
            <div className="text-xs text-[#12868C]">
              {hasExistingTrips
                ? `Đã có ${data.trip_count} chuyến`
                : "Chưa có chuyến nào — hãy sinh chuyến tự động"}
            </div>
          </div>
        </div>

        <Badge variant="success">
          <Activity size={10} />
          Hoạt động
        </Badge>
      </div>

      {/* ═══════════ METADATA INFO ═══════════ */}
      <div className="bg-white rounded-xl border border-[#E5EAF0]">
        {/* Header */}
        <div className="flex items-center justify-between gap-3 px-5 py-4 border-b border-[#E5EAF0]">
          <div className="flex items-center gap-2">
            <FileText size={13} className="text-[#169BA2]" />
            <h3 className="text-[11px] font-bold uppercase tracking-wider text-[#4A5A7A]">
              Thông tin vận hành
            </h3>
          </div>
          <div className="flex items-center gap-2">
            <button
              onClick={() => recomputeMut.mutate(routeId)}
              disabled={recomputeMut.isPending}
              className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-[11px] font-semibold text-[#6A7A9A] hover:bg-[#F8FAFC] hover:text-[#169BA2] cursor-pointer transition-colors disabled:opacity-50"
            >
              <RefreshCw
                size={12}
                className={recomputeMut.isPending ? "animate-spin" : ""}
              />
              Tính lại
            </button>
            <button
              onClick={() => setEditing(true)}
              className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-[11px] font-semibold text-[#169BA2] bg-[#E6F4F5] hover:bg-[#A8D5D8] cursor-pointer transition-colors"
            >
              <Edit3 size={12} />
              Chỉnh sửa
            </button>
          </div>
        </div>

        {/* Mô tả */}
        {ops.description && (
          <div className="px-5 pt-4">
            <div className="text-xs text-[#6A7A9A] leading-relaxed">
              {ops.description}
            </div>
          </div>
        )}

        {/* Grid info */}
        <div className="grid grid-cols-2 md:grid-cols-3 gap-3 p-5">
          <InfoTile
            icon={Clock}
            label="Giờ hoạt động"
            value={`${fmtTime(ops.operating_start_time)} – ${fmtTime(
              ops.operating_end_time,
            )}`}
            accent
          />
          <InfoTile
            icon={DollarSign}
            label="Giá vé"
            value={fmtCurrency(ops.base_fare)}
            accent
          />
          <InfoTile
            icon={Timer}
            label="Giãn cách thiết kế"
            value={`${Math.floor(ops.min_headway_seconds / 60)}–${Math.floor(
              ops.max_headway_seconds / 60,
            )} phút`}
            accent
          />
        </div>
      </div>

      {/* ═══════════ STATS CACHE ═══════════ */}
      {stats && (
        <div className="bg-white rounded-xl border border-[#E5EAF0]">
          <div className="flex items-center gap-2 px-5 py-4 border-b border-[#E5EAF0]">
            <Ruler size={13} className="text-[#169BA2]" />
            <h3 className="text-[11px] font-bold uppercase tracking-wider text-[#4A5A7A]">
              Số liệu tuyến
            </h3>
          </div>

          <div className="grid grid-cols-2 md:grid-cols-4 gap-3 p-5">
            <InfoTile
              icon={Ruler}
              label="Chiều đi"
              value={`${fmtDistance(stats.go_length_m)} · ${fmtDuration(
                stats.go_travel_time_sec,
              )}`}
            />
            <InfoTile
              icon={Ruler}
              label="Chiều về"
              value={`${fmtDistance(stats.return_length_m)} · ${fmtDuration(
                stats.return_travel_time_sec,
              )}`}
            />
            <InfoTile
              icon={ListOrdered}
              label="Số chuyến"
              value={data.trip_count ?? 0}
              accent
            />
            <InfoTile
              icon={Info}
              label="Cập nhật"
              value={
                stats.computed_at
                  ? new Date(stats.computed_at).toLocaleDateString("vi-VN")
                  : "—"
              }
            />
          </div>
        </div>
      )}

      {/* ═══════════ GENERATE TRIPS CTA ═══════════ */}
      <div className="bg-white rounded-xl border border-[#E5EAF0] p-5">
        <div className="flex items-start gap-3 mb-4">
          <div className="w-9 h-9 rounded-lg bg-[#FFF3E0] flex items-center justify-center flex-shrink-0">
            <Sparkles size={16} className="text-[#E08940]" />
          </div>
          <div className="min-w-0 flex-1">
            <div className="text-sm font-bold text-[#1A2332] mb-1">
              {hasExistingTrips ? "Sinh lại chuyến" : "Sinh chuyến tự động"}
            </div>
            <div className="text-xs text-[#6A7A9A] leading-relaxed">
              {hasExistingTrips
                ? "Hệ thống sẽ sinh lại danh sách chuyến dựa trên metadata. Bạn có thể chọn xóa hết hoặc thêm vào."
                : "Hệ thống sẽ tự động tạo danh sách chuyến dựa trên giờ hoạt động, giãn cách và lịch phục vụ."}
            </div>
          </div>
        </div>

        <div className="flex items-center gap-2">
          <Button
            variant="primary"
            onClick={() => setGenDialogOpen(true)}
            className="bg-[#169BA2] hover:bg-[#12868C] text-white"
          >
            <Sparkles size={14} />
            {hasExistingTrips ? "Sinh lại chuyến" : "Sinh chuyến"}
          </Button>

          {!hasExistingTrips && (
            <div className="flex items-center gap-1.5 text-[11px] text-[#E08940]">
              <AlertTriangle size={12} />
              <span>Chưa có chuyến nào</span>
            </div>
          )}
        </div>
      </div>

      {/* ═══════════ STATS BY DATE ═══════════ */}
      {hasExistingTrips && (
        <div>
          <div className="flex items-center gap-2 mb-3">
            <Activity size={13} className="text-[#169BA2]" />
            <h3 className="text-[11px] font-bold uppercase tracking-wider text-[#4A5A7A]">
              Số liệu khai thác theo ngày
            </h3>
          </div>
          <RouteStatsPanel routeId={routeId} />
        </div>
      )}

      {/* ═══════════ DANGER ZONE ═══════════ */}
      <div className="bg-white rounded-xl border border-[#FFCDD2] p-5">
        <div className="flex items-start justify-between gap-4">
          <div className="min-w-0">
            <div className="text-sm font-bold text-[#C62828] mb-1">
              Hủy kích hoạt tuyến
            </div>
            <div className="text-xs text-[#6A7A9A] leading-relaxed">
              Tuyến sẽ chuyển về trạng thái nháp. Các chuyến đã sinh vẫn được
              giữ lại nhưng tuyến sẽ không hoạt động.
            </div>
          </div>
          <Button
            variant="secondary"
            onClick={() => {
              if (
                confirm(
                  "Bạn chắc chắn muốn hủy kích hoạt tuyến? Các chuyến vẫn được giữ lại.",
                )
              ) {
                deactivateMut.mutate(routeId, {
                  onSuccess: () => refetch(),
                });
              }
            }}
            disabled={deactivateMut.isPending}
            className="border-[#FFCDD2] text-[#C62828] hover:bg-[#FFEBEE] flex-shrink-0"
          >
            {deactivateMut.isPending ? (
              <Loader2 size={13} className="animate-spin" />
            ) : (
              <Pause size={13} />
            )}
            Hủy kích hoạt
          </Button>
        </div>
      </div>

      {/* ═══════════ DIALOG ═══════════ */}
      <TripGenerationDialog
        open={genDialogOpen}
        onClose={() => setGenDialogOpen(false)}
        routeId={routeId}
        operations={ops}
        hasExistingTrips={hasExistingTrips}
      />
    </div>
  );
}
</file>

<file path="src/admin/components/routes/RoutePreviewMap.jsx">
import { useEffect, useRef } from "react";
import L from "leaflet";

const DEFAULT_CENTER = [10.7769, 106.7009];
const DEFAULT_ZOOM = 12;

const STYLE = `
  .rte-via {
    width: 12px; height: 12px; border-radius: 50%;
    background: #9c27b0; border: 2px solid #fff;
    box-shadow: 0 1px 4px rgba(0,0,0,0.5);
    cursor: grab;
    transition: transform 0.15s ease;
  }
  .rte-via:hover { transform: scale(1.3); }
  .rte-via:active { cursor: grabbing; transform: scale(1.5); }
  .route-preview-basemap {
  filter: grayscale(1) brightness(1.08) contrast(0.78);
}
`;

function ensureStyle() {
  if (document.getElementById("rte-style-v3")) return;
  const s = document.createElement("style");
  s.id = "rte-style-v3";
  s.textContent = STYLE;
  document.head.appendChild(s);
}

function makeDepotIcon(color, label) {
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="34" height="42" viewBox="0 0 34 42">
    <path d="M17 0C7.6 0 0 7.6 0 17c0 12 17 25 17 25s17-13 17-25c0-9.4-7.6-17-17-17z" fill="${color}" stroke="#fff" stroke-width="2"/>
    <text x="17" y="22" font-size="13" font-weight="bold" text-anchor="middle" fill="white">${label}</text>
  </svg>`;
  return L.divIcon({
    html: svg,
    className: "",
    iconSize: [34, 42],
    iconAnchor: [17, 42],
  });
}

function makeStopIcon(seq) {
  // Giọt nước với số bên trong
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="32" viewBox="0 0 34 42">
    <path d="M17 0C7.6 0 0 7.6 0 17c0 12 17 25 17 25s17-13 17-25c0-9.4-7.6-17-17-17z"
          fill="#169BA2" stroke="#fff" stroke-width="2.5"/>
    <circle cx="17" cy="17" r="9" fill="#fff" opacity="0.95"/>
    <text x="17" y="21" font-size="11" font-weight="bold" text-anchor="middle" fill="#169BA2">${seq}</text>
  </svg>`;
  return L.divIcon({
    html: svg,
    className: "",
    iconSize: [26, 32],
    iconAnchor: [13, 32],
  });
}

function makeViaIcon() {
  return L.divIcon({
    html: `<div class="rte-via"></div>`,
    className: "",
    iconSize: [12, 12],
    iconAnchor: [6, 6],
  });
}

// ─── Helpers ───
function haversine(lat1, lng1, lat2, lng2) {
  const R = 6371000;
  const toRad = (d) => (d * Math.PI) / 180;
  const dLat = toRad(lat2 - lat1);
  const dLng = toRad(lng2 - lng1);
  const a =
    Math.sin(dLat / 2) ** 2 +
    Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLng / 2) ** 2;
  return 2 * R * Math.asin(Math.sqrt(a));
}

function cumulativeDistancesCoords(coords) {
  if (!coords?.length) return [];
  const dists = [0];
  for (let i = 1; i < coords.length; i++) {
    dists.push(
      dists[i - 1] +
        haversine(
          coords[i - 1][1],
          coords[i - 1][0],
          coords[i][1],
          coords[i][0],
        ),
    );
  }
  return dists;
}

// Tìm nearest coord index trên shape
function findNearestShapeIdx(coords, lat, lng) {
  let bestIdx = 0;
  let bestD = Infinity;
  for (let i = 0; i < coords.length; i++) {
    const dx = coords[i][0] - lng;
    const dy = coords[i][1] - lat;
    const d = dx * dx + dy * dy;
    if (d < bestD) {
      bestD = d;
      bestIdx = i;
    }
  }
  return bestIdx;
}

// Xác định segment_index = giữa points[i] và points[i+1] mà vị trí (lat,lng) thuộc về
function findSegmentIndex(preview, lat, lng) {
  if (!preview?.shape?.coordinates?.length || !preview?.points?.length)
    return 0;
  const coords = preview.shape.coordinates;
  const cum = cumulativeDistancesCoords(coords);
  const idx = findNearestShapeIdx(coords, lat, lng);
  const dragDist = cum[idx];

  const pts = preview.points;
  // pts[i].distance_from_start_m — dùng để so sánh
  for (let i = 0; i < pts.length - 1; i++) {
    const dA = pts[i].distance_from_start_m ?? 0;
    const dB = pts[i + 1].distance_from_start_m ?? 0;
    if (dragDist >= dA && dragDist <= dB) return i;
  }
  return pts.length - 2 >= 0 ? pts.length - 2 : 0;
}

// Tính offset trong segment (0 → 1) để BE sort đúng
function computeOffsetInSegment(preview, segIdx, lat, lng) {
  if (!preview?.shape?.coordinates?.length) return 0.5;
  const coords = preview.shape.coordinates;
  const cum = cumulativeDistancesCoords(coords);
  const idx = findNearestShapeIdx(coords, lat, lng);
  const dragDist = cum[idx];
  const pts = preview.points;
  const dA = pts[segIdx]?.distance_from_start_m ?? 0;
  const dB = pts[segIdx + 1]?.distance_from_start_m ?? 0;
  if (dB - dA < 1) return 0.5;
  return Math.max(0, Math.min(1, (dragDist - dA) / (dB - dA)));
}

function buildTempCoords(coords, idx, lat, lng) {
  const clamped = Math.max(0, Math.min(idx, coords.length - 2));
  const before = coords.slice(0, clamped + 1);
  const after = coords.slice(clamped + 1);
  return [...before, [lng, lat], ...after];
}

function coordsToLatLngs(coords) {
  return coords.map((c) => [c[1], c[0]]);
}

export function RoutePreviewMap({
  preview,
  startDepot,
  endDepot,
  hoveredStop,
  focusedStop,
  viaPoints = [],
  onAddViaPoint,
  onMoveViaPoint,
  onRemoveViaPoint,
  readOnly = false,
}) {
  const containerRef = useRef(null);
  const mapRef = useRef(null);
  const routeLayerRef = useRef(null);
  const tempLayerRef = useRef(null);
  const markersRef = useRef([]);
  const viaMarkersRef = useRef([]);
  const hoverLayerRef = useRef(null);
  const hasFittedRef = useRef(false);
  const isDraggingRef = useRef(false);

  const callbacksRef = useRef({
    onAddViaPoint,
    onMoveViaPoint,
    onRemoveViaPoint,
  });
  useEffect(() => {
    callbacksRef.current = { onAddViaPoint, onMoveViaPoint, onRemoveViaPoint };
  }, [onAddViaPoint, onMoveViaPoint, onRemoveViaPoint]);

  const previewRef = useRef(preview);
  useEffect(() => {
    previewRef.current = preview;
  }, [preview]);

  useEffect(() => {
    ensureStyle();
  }, []);

  // Init map
  useEffect(() => {
    if (mapRef.current || !containerRef.current) return;
    const map = L.map(containerRef.current, { zoomControl: true }).setView(
      DEFAULT_CENTER,
      DEFAULT_ZOOM,
    );
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      attribution:
        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
      maxZoom: 19,
      className: "route-preview-basemap",
    }).addTo(map);
    mapRef.current = map;
    return () => {
      map.remove();
      mapRef.current = null;
    };
  }, []);

  useEffect(() => {
    hasFittedRef.current = false;
  }, [startDepot?.id, endDepot?.id]);

  // ─── Drag line ───
  function startLineDrag(map, lat, lng) {
    const previewData = previewRef.current;
    if (!previewData?.shape?.coordinates?.length) return;

    isDraggingRef.current = true;
    map.getContainer().style.cursor = "grabbing";
    if (map.dragging) map.dragging.disable();

    const coords = previewData.shape.coordinates;
    const nearestIdx = findNearestShapeIdx(coords, lat, lng);

    routeLayerRef.current?.setStyle({ opacity: 0.15 });

    const tempLayer = L.polyline(
      coordsToLatLngs(buildTempCoords(coords, nearestIdx, lat, lng)),
      { color: "#0d6efd", weight: 5, opacity: 0.95 },
    ).addTo(map);
    tempLayer.bringToFront();
    tempLayerRef.current = tempLayer;

    const onMove = (ev) => {
      const newCoords = buildTempCoords(
        coords,
        nearestIdx,
        ev.latlng.lat,
        ev.latlng.lng,
      );
      tempLayer.setLatLngs(coordsToLatLngs(newCoords));
    };

    const onUp = (ev) => {
      map.off("mousemove", onMove);
      map.off("mouseup", onUp);
      if (map.dragging) map.dragging.enable();
      map.getContainer().style.cursor = "";
      isDraggingRef.current = false;

      if (tempLayerRef.current) {
        map.removeLayer(tempLayerRef.current);
        tempLayerRef.current = null;
      }
      routeLayerRef.current?.setStyle({ opacity: 0.85 });

      const moved = haversine(lat, lng, ev.latlng.lat, ev.latlng.lng) > 15;
      if (moved) {
        const segmentIdx = findSegmentIndex(
          previewData,
          ev.latlng.lat,
          ev.latlng.lng,
        );
        const offsetInSeg = computeOffsetInSegment(
          previewData,
          segmentIdx,
          ev.latlng.lat,
          ev.latlng.lng,
        );
        callbacksRef.current.onAddViaPoint?.({
          latitude: ev.latlng.lat,
          longitude: ev.latlng.lng,
          segment_index: segmentIdx,
          offset_in_segment: offsetInSeg,
        });
      }
    };

    map.on("mousemove", onMove);
    map.on("mouseup", onUp);
  }

  // ─── Drag via marker ───
  function startViaDrag(map, viaIdx) {
    const previewData = previewRef.current;
    if (!previewData?.shape?.coordinates?.length) return;

    isDraggingRef.current = true;
    map.getContainer().style.cursor = "grabbing";

    const coords = previewData.shape.coordinates;
    const vp = viaPoints[viaIdx];
    if (!vp) return;

    const vMarker = viaMarkersRef.current[viaIdx];
    if (vMarker) vMarker.setOpacity(0);

    routeLayerRef.current?.setStyle({ opacity: 0.15 });

    let nearestIdx = findNearestShapeIdx(coords, vp.latitude, vp.longitude);
    const tempLayer = L.polyline(
      coordsToLatLngs(
        buildTempCoords(coords, nearestIdx, vp.latitude, vp.longitude),
      ),
      { color: "#9c27b0", weight: 5, opacity: 0.95 },
    ).addTo(map);
    tempLayer.bringToFront();
    tempLayerRef.current = tempLayer;

    const onMove = (ev) => {
      nearestIdx = findNearestShapeIdx(coords, ev.latlng.lat, ev.latlng.lng);
      const newCoords = buildTempCoords(
        coords,
        nearestIdx,
        ev.latlng.lat,
        ev.latlng.lng,
      );
      tempLayer.setLatLngs(coordsToLatLngs(newCoords));
    };

    const onUp = (ev) => {
      map.off("mousemove", onMove);
      map.off("mouseup", onUp);
      map.getContainer().style.cursor = "";
      isDraggingRef.current = false;

      if (vMarker) vMarker.setOpacity(1);
      if (tempLayerRef.current) {
        map.removeLayer(tempLayerRef.current);
        tempLayerRef.current = null;
      }
      routeLayerRef.current?.setStyle({ opacity: 0.85 });

      const segmentIdx = findSegmentIndex(
        previewData,
        ev.latlng.lat,
        ev.latlng.lng,
      );
      const offsetInSeg = computeOffsetInSegment(
        previewData,
        segmentIdx,
        ev.latlng.lat,
        ev.latlng.lng,
      );
      callbacksRef.current.onMoveViaPoint?.(viaIdx, {
        latitude: ev.latlng.lat,
        longitude: ev.latlng.lng,
        segment_index: segmentIdx,
        offset_in_segment: offsetInSeg,
      });
    };

    map.on("mousemove", onMove);
    map.on("mouseup", onUp);
  }

  // Vẽ route + markers
  useEffect(() => {
    const map = mapRef.current;
    if (!map) return;

    if (routeLayerRef.current) {
      map.removeLayer(routeLayerRef.current);
      routeLayerRef.current = null;
    }
    if (tempLayerRef.current) {
      map.removeLayer(tempLayerRef.current);
      tempLayerRef.current = null;
    }
    markersRef.current.forEach((m) => map.removeLayer(m));
    markersRef.current = [];

    if (!preview) {
      if (startDepot && endDepot) {
        const s = L.marker([startDepot.latitude, startDepot.longitude], {
          icon: makeDepotIcon("#169BA2", "Đ"),
        })
          .addTo(map)
          .bindPopup(`<b>${startDepot.stop_name}</b>`);
        const e = L.marker([endDepot.latitude, endDepot.longitude], {
          icon: makeDepotIcon("#c0392b", "C"),
        })
          .addTo(map)
          .bindPopup(`<b>${endDepot.stop_name}</b>`);
        markersRef.current.push(s, e);
        if (!hasFittedRef.current) {
          map.fitBounds(
            L.latLngBounds([
              [startDepot.latitude, startDepot.longitude],
              [endDepot.latitude, endDepot.longitude],
            ]),
            { padding: [60, 60], maxZoom: 15 },
          );
          hasFittedRef.current = true;
        }
      } else if (startDepot) {
        const s = L.marker([startDepot.latitude, startDepot.longitude], {
          icon: makeDepotIcon("#169BA2", "Đ"),
        }).addTo(map);
        markersRef.current.push(s);
        if (!hasFittedRef.current) {
          map.setView([startDepot.latitude, startDepot.longitude], 14);
          hasFittedRef.current = true;
        }
      }
      return;
    }

    const routeLayer = L.geoJSON(preview.shape, {
      style: { color: "#169BA2", weight: 5, opacity: 0.85 },
    }).addTo(map);
    routeLayerRef.current = routeLayer;

    if (!readOnly && preview.shape?.coordinates?.length > 1) {
      routeLayer.eachLayer((layer) => {
        layer.on("mouseover", () => {
          if (!isDraggingRef.current) map.getContainer().style.cursor = "grab";
        });
        layer.on("mouseout", () => {
          if (!isDraggingRef.current) map.getContainer().style.cursor = "";
        });
        layer.on("mousedown", (e) => {
          L.DomEvent.stopPropagation(e);
          if (isDraggingRef.current) return;
          startLineDrag(map, e.latlng.lat, e.latlng.lng);
        });
      });
    }

    (preview.points || []).forEach((p, idx) => {
      const isDepot = p.stop_type === 1;
      const isFirst = idx === 0;
      const isLast = idx === preview.points.length - 1;
      const icon = isDepot
        ? makeDepotIcon(
            isFirst ? "#169BA2" : isLast ? "#c0392b" : "#d48c2c",
            isFirst ? "Đ" : isLast ? "C" : "·",
          )
        : makeStopIcon(p.sequence - 1);
      const m = L.marker([p.latitude, p.longitude], {
        icon,
        zIndexOffset: 1000,
      })
        .addTo(map)
        .bindPopup(
          `<div class="bus-popup"><b>${p.stop_name}</b>
            <div class="sub">${isDepot ? "Depot" : `Trạm #${p.sequence - 1}`}</div>
          </div>`,
        );
      markersRef.current.push(m);
    });

    if (!hasFittedRef.current && preview.points?.length > 0) {
      map.fitBounds(
        L.latLngBounds(preview.points.map((p) => [p.latitude, p.longitude])),
        {
          padding: [60, 60],
          maxZoom: 15,
        },
      );
      hasFittedRef.current = true;
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [preview, startDepot, endDepot, readOnly]);

  // ─── Hover marker — pin giọt nước nhỏ ───
  useEffect(() => {
    const map = mapRef.current;
    if (!map) return;
    if (hoverLayerRef.current) {
      map.removeLayer(hoverLayerRef.current);
      hoverLayerRef.current = null;
    }
    if (!hoveredStop) return;

    // Pin giọt nước nhỏ màu xanh (giống depot nhưng nhỏ hơn)
    const pinSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="28" viewBox="0 0 34 42">
      <path d="M17 0C7.6 0 0 7.6 0 17c0 12 17 25 17 25s17-13 17-25c0-9.4-7.6-17-17-17z"
            fill="#169BA2" stroke="#fff" stroke-width="2.5"/>
      <circle cx="17" cy="17" r="5.5" fill="#fff"/>
    </svg>`;

    const marker = L.marker([hoveredStop.latitude, hoveredStop.longitude], {
      icon: L.divIcon({
        html: pinSvg,
        className: "",
        iconSize: [22, 28],
        iconAnchor: [11, 28],
      }),
      zIndexOffset: 9999,
      interactive: false,
    }).addTo(map);

    const group = L.layerGroup([marker]).addTo(map);
    hoverLayerRef.current = group;

    return () => {
      if (hoverLayerRef.current === group) {
        map.removeLayer(group);
        hoverLayerRef.current = null;
      }
    };
  }, [hoveredStop]);

  // ─── Focus stop (click vào row) ───
  useEffect(() => {
    const map = mapRef.current;
    if (!map || !focusedStop) return;
    map.flyTo([focusedStop.latitude, focusedStop.longitude], 17, {
      animate: true,
      duration: 0.6,
    });
  }, [focusedStop]);

  // Via markers
  useEffect(() => {
    const map = mapRef.current;
    if (!map) return;
    viaMarkersRef.current.forEach((m) => map.removeLayer(m));
    viaMarkersRef.current = [];
    if (readOnly || !viaPoints?.length) return;

    viaPoints.forEach((vp, idx) => {
      const marker = L.marker([vp.latitude, vp.longitude], {
        icon: makeViaIcon(),
        zIndexOffset: 3000,
        title: "Kéo để di chuyển · Double-click để xoá",
      }).addTo(map);

      marker.on("mousedown", (e) => {
        L.DomEvent.stopPropagation(e);
        if (isDraggingRef.current) return;
        startViaDrag(map, idx);
      });

      marker.on("dblclick", (e) => {
        L.DomEvent.stopPropagation(e);
        if (confirm(`Xoá điểm điều hướng #${idx + 1}?`)) {
          callbacksRef.current.onRemoveViaPoint?.(idx);
        }
      });

      viaMarkersRef.current.push(marker);
    });
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [viaPoints, readOnly]);

  return <div ref={containerRef} className="h-full w-full rounded-lg" />;
}
</file>

<file path="src/admin/components/routes/RoutesTable.jsx">
import { Pencil, Power, PowerOff, Trash2, Eye } from 'lucide-react';
import { Badge } from '@/components/ui/badge';
import { DataTable } from '@/components/ui/data-table';
import { useChangeRouteStatus, useDeleteComposedRoute } from '@/hooks/useRoutes';

export function RoutesTable({
  routes,
  isLoading,
  onEdit,
  onView,
  sortBy,
  sortOrder,
  onSort,
}) {
  const statusMut = useChangeRouteStatus();
  const deleteMut = useDeleteComposedRoute();

  const columns = [
    {
      key: 'id',
      label: 'ID',
      sortable: true,
      width: 60,
      render: (r) => <span className="text-[#6a7a9a] font-mono text-xs">{r.id}</span>,
    },
    {
      key: 'route_id',
      label: 'Mã tuyến',
      sortable: true,
      width: 110,
      render: (r) => (
        <button
          onClick={(e) => {
            e.stopPropagation();
            onView?.(r);
          }}
          className="font-mono text-xs text-[#169BA2] font-semibold hover:underline cursor-pointer"
        >
          {r.route_id}
        </button>
      ),
    },
    {
      key: 'route_short_name',
      label: 'Tên ngắn',
      sortable: true,
      width: 130,
      render: (r) => (
        <button
          onClick={(e) => {
            e.stopPropagation();
            onView?.(r);
          }}
          className="font-medium text-[#1a2332] hover:text-[#169BA2] hover:underline cursor-pointer text-left"
        >
          {r.route_short_name}
        </button>
      ),
    },
    {
      key: 'route_full_name',
      label: 'Tên đầy đủ',
      render: (r) => (
        <span
          className="text-xs text-[#4a5a7a] truncate block max-w-[280px]"
          title={r.route_full_name}
        >
          {r.route_full_name}
        </span>
      ),
    },
    {
      key: 'route_color',
      label: 'Màu',
      width: 70,
      align: 'center',
      render: (r) => (
        <div className="flex items-center justify-center">
          <span
            className="w-5 h-5 rounded border border-[#d0d7e2]"
            style={{ background: r.route_color || '#ccc' }}
          />
        </div>
      ),
    },
    {
      key: 'is_active',
      label: 'Trạng thái',
      align: 'center',
      width: 110,
      render: (r) =>
        r.is_active ? (
          <Badge variant="success">Hoạt động</Badge>
        ) : (
          <Badge variant="danger">Ngưng</Badge>
        ),
    },
    {
      key: 'actions',
      label: 'Hành động',
      align: 'center',
      width: 140,
      render: (r) => (
        <div className="flex items-center justify-center gap-1">
          <button
            onClick={(e) => {
              e.stopPropagation();
              onView?.(r);
            }}
            title="Xem chi tiết"
            className="h-7 w-7 rounded-md border border-[#cbd5e1] bg-white hover:bg-[#eef2f6] flex items-center justify-center cursor-pointer"
          >
            <Eye size={12} className="text-[#4a5a7a]" />
          </button>
          <button
            onClick={(e) => {
              e.stopPropagation();
              onEdit(r);
            }}
            title="Sửa"
            className="h-7 w-7 rounded-md border border-[#cbd5e1] bg-white hover:bg-[#eef2f6] flex items-center justify-center cursor-pointer"
          >
            <Pencil size={12} className="text-[#169BA2]" />
          </button>
          <button
            onClick={(e) => {
              e.stopPropagation();
              statusMut.mutate({ id: r.id, is_active: !r.is_active });
            }}
            disabled={statusMut.isPending}
            title={r.is_active ? 'Ngưng' : 'Kích hoạt'}
            className={`h-7 w-7 rounded-md border flex items-center justify-center cursor-pointer disabled:opacity-50 ${
              r.is_active
                ? 'border-[#f5b7b1] bg-white hover:bg-[#fde8e8]'
                : 'border-[#A8D5D8] bg-white hover:bg-[#E6F4F5]'
            }`}
          >
            {r.is_active ? (
              <PowerOff size={12} className="text-[#c0392b]" />
            ) : (
              <Power size={12} className="text-[#169BA2]" />
            )}
          </button>
          <button
            onClick={(e) => {
              e.stopPropagation();
              if (confirm(`Xoá tuyến "${r.route_id}" và toàn bộ patterns, shapes, trips liên quan?`)) {
                deleteMut.mutate(r.id);
              }
            }}
            disabled={deleteMut.isPending}
            title="Xoá"
            className="h-7 w-7 rounded-md border border-[#f5b7b1] bg-white hover:bg-[#fde8e8] flex items-center justify-center cursor-pointer disabled:opacity-50"
          >
            <Trash2 size={12} className="text-[#c0392b]" />
          </button>
        </div>
      ),
    },
  ];

  return (
    <DataTable
      columns={columns}
      rows={routes}
      isLoading={isLoading}
      emptyMessage="Chưa có tuyến nào"
      sortBy={sortBy}
      sortOrder={sortOrder}
      onSort={onSort}
      rowKey="id"
      onRowClick={(r) => onView?.(r)}
    />
  );
}
</file>

