function viNorm(s) {
  if (!s) return "";
  return String(s)
    .toLowerCase()
    .split("")
    .map((c) => VI_MAP[c] || c)
    .join("");
}
function viMatch(text, kw) {
  if (!kw) return true;
  return viNorm(text).includes(viNorm(kw));
}

