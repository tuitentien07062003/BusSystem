<file path="src/admin/components/agencies/AgenciesTable.jsx">
import { Pencil, Power, PowerOff } from 'lucide-react';
import { Badge } from '@/components/ui/badge';
import { DataTable } from '@/components/ui/data-table';
import { useChangeAgencyStatus } from '@/hooks/useAgencies';

function formatDate(s) {
  if (!s) return '—';
  try {
    return new Date(s).toLocaleDateString('vi-VN');
  } catch {
    return '—';
  }
}

export function AgenciesTable({ agencies, isLoading, onEdit, sortBy, sortOrder, onSort }) {
  const statusMut = useChangeAgencyStatus();

  const columns = [
    { key: 'id', label: 'ID', sortable: true, width: 60,
      render: (r) => <span className="text-[#6a7a9a] font-mono text-xs">{r.id}</span> },
    { key: 'agency_id', label: 'Mã', sortable: true, width: 100,
      render: (r) => <span className="font-mono text-xs text-[#169BA2] font-semibold">{r.agency_id}</span> },
    { key: 'agency_name', label: 'Tên nhà vận hành', sortable: true,
      render: (r) => <span className="font-medium text-[#1a2332]">{r.agency_name}</span> },
    { key: 'agency_url', label: 'Website',
      render: (r) =>
        r.agency_url ? (
          <a href={r.agency_url} target="_blank" rel="noreferrer" className="text-xs text-[#169BA2] hover:underline truncate block max-w-[220px]">
            {r.agency_url}
          </a>
        ) : <span className="text-[#8a9aaa] text-xs">—</span> },
    { key: 'agency_timezone', label: 'Múi giờ',
      render: (r) => <span className="text-xs text-[#4a5a7a] font-mono">{r.agency_timezone || '—'}</span> },
    { key: 'created_at', label: 'Ngày tạo', sortable: true,
      render: (r) => <span className="text-xs text-[#6a7a9a]">{formatDate(r.created_at)}</span> },
    { key: 'is_active', label: 'Trạng thái', align: 'center', width: 110,
      render: (r) => r.is_active ? <Badge variant="success">Hoạt động</Badge> : <Badge variant="danger">Ngưng</Badge> },
    { key: 'actions', label: 'Hành động', align: 'center', width: 100,
      render: (r) => (
        <div className="flex items-center justify-center gap-1">
          <button onClick={() => onEdit(r)} title="Sửa" className="h-7 w-7 rounded-md border border-[#cbd5e1] bg-white hover:bg-[#eef2f6] flex items-center justify-center cursor-pointer">
            <Pencil size={12} className="text-[#169BA2]" />
          </button>
          <button
            onClick={() => statusMut.mutate({ id: r.id, is_active: !r.is_active })}
            disabled={statusMut.isPending}
            title={r.is_active ? 'Ngưng' : 'Kích hoạt'}
            className={`h-7 w-7 rounded-md border flex items-center justify-center cursor-pointer disabled:opacity-50 ${
              r.is_active ? 'border-[#f5b7b1] bg-white hover:bg-[#fde8e8]' : 'border-[#A8D5D8] bg-white hover:bg-[#E6F4F5]'
            }`}
          >
            {r.is_active ? <PowerOff size={12} className="text-[#c0392b]" /> : <Power size={12} className="text-[#169BA2]" />}
          </button>
        </div>
      ) },
  ];

  return (
    <DataTable
      columns={columns}
      rows={agencies}
      isLoading={isLoading}
      emptyMessage="Chưa có nhà vận hành nào"
      sortBy={sortBy}
      sortOrder={sortOrder}
      onSort={onSort}
    />
  );
}
</file>

<file path="src/admin/components/agencies/AgencyFormDialog.jsx">
import { useEffect } from 'react';
import { useForm } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';
import { z } from 'zod';
import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
  DialogDescription,
  DialogFooter,
} from '@/components/ui/dialog';
import { Input } from '@/components/ui/input';
import { Label } from '@/components/ui/label';
import { Button } from '@/components/ui/button';
import { Switch } from '@/components/ui/switch';
import { useCreateAgency, useUpdateAgency } from '@/hooks/useAgencies';

const schema = z.object({
  agency_id: z.string().trim().min(1, 'Mã không được để trống'),
  agency_name: z.string().trim().min(1, 'Tên không được để trống'),
  agency_url: z
    .string()
    .trim()
    .optional()
    .refine((v) => !v || /^https?:\/\//i.test(v), 'URL phải bắt đầu bằng http:// hoặc https://'),
  agency_timezone: z.string().trim().optional(),
  is_active: z.boolean(),
});

export function AgencyFormDialog({ agency, open, onOpenChange }) {
  const isEdit = !!agency;
  const createMut = useCreateAgency();
  const updateMut = useUpdateAgency();

  const {
    register,
    handleSubmit,
    reset,
    watch,
    setValue,
    formState: { errors, isSubmitting },
  } = useForm({
    resolver: zodResolver(schema),
    defaultValues: {
      agency_id: '',
      agency_name: '',
      agency_url: '',
      agency_timezone: 'Asia/Ho_Chi_Minh',
      is_active: true,
    },
  });

  useEffect(() => {
    if (open) {
      reset(
        agency
          ? {
              agency_id: agency.agency_id || '',
              agency_name: agency.agency_name || '',
              agency_url: agency.agency_url || '',
              agency_timezone: agency.agency_timezone || '',
              is_active: agency.is_active ?? true,
            }
          : {
              agency_id: '',
              agency_name: '',
              agency_url: '',
              agency_timezone: 'Asia/Ho_Chi_Minh',
              is_active: true,
            }
      );
    }
  }, [open, agency, reset]);

  const isActive = watch('is_active');

  const onSubmit = async (values) => {
    const payload = {
      ...values,
      agency_url: values.agency_url || null,
      agency_timezone: values.agency_timezone || null,
    };
    if (isEdit) await updateMut.mutateAsync({ id: agency.id, payload });
    else await createMut.mutateAsync(payload);
    onOpenChange(false);
  };

  return (
    <Dialog open={open} onOpenChange={onOpenChange}>
      <DialogContent className="max-w-lg">
        <DialogHeader>
          <DialogTitle>{isEdit ? `Sửa agency #${agency.id}` : 'Thêm nhà vận hành'}</DialogTitle>
          <DialogDescription>Trường có dấu * là bắt buộc.</DialogDescription>
        </DialogHeader>

        <form onSubmit={handleSubmit(onSubmit)} className="px-5 py-4 space-y-3">
          <div className="grid grid-cols-2 gap-3">
            <div className="space-y-1">
              <Label>Mã agency *</Label>
              <Input {...register('agency_id')} placeholder="TBUS" />
              {errors.agency_id && <p className="text-[11px] text-[#c0392b]">{errors.agency_id.message}</p>}
            </div>
            <div className="space-y-1">
              <Label>Tên *</Label>
              <Input {...register('agency_name')} placeholder="TBus Vietnam" />
              {errors.agency_name && <p className="text-[11px] text-[#c0392b]">{errors.agency_name.message}</p>}
            </div>
          </div>

          <div className="space-y-1">
            <Label>Website</Label>
            <Input {...register('agency_url')} placeholder="https://tbus.vn" />
            {errors.agency_url && <p className="text-[11px] text-[#c0392b]">{errors.agency_url.message}</p>}
          </div>

          <div className="space-y-1">
            <Label>Múi giờ</Label>
            <Input {...register('agency_timezone')} placeholder="Asia/Ho_Chi_Minh" />
          </div>

          <div className="flex items-center justify-between py-2">
            <Label>Đang hoạt động</Label>
            <Switch checked={isActive} onCheckedChange={(v) => setValue('is_active', v)} />
          </div>

          <DialogFooter className="-mx-5 -mb-4">
            <Button type="button" variant="secondary" onClick={() => onOpenChange(false)} disabled={isSubmitting}>
              Hủy
            </Button>
            <Button type="submit" variant="primary" disabled={isSubmitting}>
              {isSubmitting ? 'Đang lưu...' : isEdit ? 'Lưu thay đổi' : 'Tạo mới'}
            </Button>
          </DialogFooter>
        </form>
      </DialogContent>
    </Dialog>
  );
}
</file>

<file path="src/admin/components/assignments/AssignmentBlock.jsx">
import { useState } from "react";
import {
  getRouteColor,
  getStatusStyle,
  timeToPixel,
  timeToHourFloat,
  fmtTime,
} from "./assignmentConstants";

export function AssignmentBlock({
  assignment,
  pixelsPerHour,
  isPast,
  isRunning,
  onClick,
  onEdit,
  onDelete,
}) {
  const [hovered, setHovered] = useState(false);

  const routeColor = getRouteColor(assignment.route_id);
  const statusStyle = getStatusStyle(assignment.status);

  const startPx = timeToPixel(assignment.start_time, { pixelsPerHour });
  const endPx = timeToPixel(assignment.end_time, { pixelsPerHour });
  const widthPx = Math.max(40, endPx - startPx);

  const shiftLabel = assignment.shift?.code === "MORNING" ? "Sáng" : "Tối";
  const driverCode = assignment.driver?.employee_code || "—";
  const driverName = assignment.driver?.full_name || "";
  const routeShort = assignment.route_id;
  const vehicleCode = assignment.vehicle?.vehicle_code || "";

  const isNarrow = widthPx < 130;
  const isVeryNarrow = widthPx < 80;

  const labelMain = isVeryNarrow
    ? `${routeShort}`
    : `${shiftLabel} · ${routeShort} · ${driverCode}`;

  return (
    <div
      className="absolute top-1.5 bottom-1.5 transition-all cursor-pointer"
      style={{
        left: `${startPx}px`,
        width: `${widthPx}px`,
      }}
      onMouseEnter={() => setHovered(true)}
      onMouseLeave={() => setHovered(false)}
      onClick={() => onClick?.(assignment)}
    >
      <div
        className={`h-full rounded-lg ${routeColor.bg} ${routeColor.text} px-2.5 flex items-center overflow-hidden transition-all ${
          isPast && !isRunning ? "opacity-50" : ""
        } ${hovered ? "shadow-lg scale-[1.02]" : "shadow-sm"} ${
          isRunning ? "ring-2 ring-[#E08940] ring-offset-1" : ""
        }`}
      >
        {isRunning && (
          <span className="relative flex h-2 w-2 mr-2 flex-shrink-0">
            <span className="absolute inline-flex h-full w-full rounded-full bg-white opacity-75 animate-ping" />
            <span className="relative inline-flex rounded-full h-2 w-2 bg-white" />
          </span>
        )}
        <span className="text-xs font-bold truncate flex-1">{labelMain}</span>
        <span
          className={`w-1.5 h-1.5 rounded-full ${statusStyle.dot} flex-shrink-0 ml-2`}
        />
      </div>

      {hovered && (
        <div
          className="absolute left-0 top-full mt-1.5 z-[100] w-[280px] bg-white rounded-xl border border-[#E5EAF0] shadow-xl p-3 pointer-events-none"
          onClick={(e) => e.stopPropagation()}
        >
          <div className="flex items-start justify-between gap-2 mb-2.5">
            <div className="flex items-center gap-2 min-w-0">
              <span
                className={`w-2 h-2 rounded-full flex-shrink-0 ${statusStyle.dot} ${
                  isRunning ? "animate-pulse" : ""
                }`}
              />
              <span className="text-[11px] font-bold text-[#1A2332]">
                {vehicleCode}
              </span>
              <span className="text-[11px] text-[#8A9AAA] font-mono">
                {assignment.vehicle?.license_plate}
              </span>
            </div>
            <span
              className={`text-[10px] font-bold px-1.5 py-0.5 rounded ${statusStyle.bg} ${statusStyle.text} border ${statusStyle.border}`}
            >
              {statusStyle.label}
            </span>
          </div>

          <div className={`h-1 rounded-full mb-2.5 ${routeColor.bg}`} />

          <div className="space-y-1.5 text-[11px]">
            <div className="flex items-center justify-between gap-2">
              <span className="text-[#8A9AAA]">Tuyến</span>
              <span className="font-semibold text-[#1A2332] truncate">
                {routeShort}
              </span>
            </div>
            <div className="flex items-center justify-between gap-2">
              <span className="text-[#8A9AAA]">Tài xế</span>
              <span className="font-semibold text-[#1A2332] truncate max-w-[140px]">
                {driverName}
              </span>
            </div>
            {assignment.co_driver && (
              <div className="flex items-center justify-between gap-2">
                <span className="text-[#8A9AAA]">Lơ xe</span>
                <span className="text-[#4A5A7A] truncate max-w-[140px]">
                  {assignment.co_driver.full_name}
                </span>
              </div>
            )}
            <div className="flex items-center justify-between gap-2 pt-1.5 border-t border-[#F0F3F7]">
              <span className="text-[#8A9AAA]">Thời gian</span>
              <span className="font-mono font-semibold text-[#1A2332]">
                {fmtTime(assignment.start_time)} –{" "}
                {fmtTime(assignment.end_time)}
              </span>
            </div>
          </div>

          <div className="mt-2.5 pt-2 border-t border-[#F0F3F7] text-[10px] text-[#8A9AAA] text-center">
            Click để xem chi tiết
          </div>
        </div>
      )}
    </div>
  );
}
