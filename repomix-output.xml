                  </div>
                  <div className="text-sm font-bold font-mono text-[#1A2332]">
                    {stats.operating_window?.first_trip || "—"}
                  </div>
                </div>
              </div>

              <ArrowRight size={14} className="text-[#B0BCCA]" />

              <div className="flex items-center gap-2">
                <div className="w-7 h-7 rounded-md bg-[#E6F4F5] flex items-center justify-center">
                  <Clock size={12} className="text-[#169BA2]" />
                </div>
                <div>
                  <div className="text-[10px] text-[#8A9AAA] uppercase tracking-wider">
                    Chuyến cuối
                  </div>
                  <div className="text-sm font-bold font-mono text-[#1A2332]">
                    {stats.operating_window?.last_trip || "—"}
                  </div>
                </div>
              </div>
            </div>
          </div>

          {/* ═══════════ CHI TIẾT GIÃN CÁCH ═══════════ */}
          <div className="bg-white rounded-xl border border-[#E5EAF0] p-4">
            <div className="flex items-center gap-2 mb-4">
              <TrendingUp size={13} className="text-[#169BA2]" />
              <h3 className="text-[11px] font-bold uppercase tracking-wider text-[#4A5A7A]">
                Chi tiết giãn cách
              </h3>
            </div>

            <div className="space-y-5">
              {/* GO */}
              {stats.headway?.go && stats.headway.go.count > 0 && (
                <div>
                  <HeadwayTimeline
                    trips={stats.headway.go.details}
                    label="Chiều đi"
                    icon={ArrowRight}
                  />

                  <div className="grid grid-cols-3 gap-2 mt-3">
                    <StatBox
                      label="Min"
                      value={stats.headway.go.min_min}
                      suffix="p"
                    />
                    <StatBox
                      label="Trung bình"
                      value={stats.headway.go.avg_min}
                      suffix="p"
                    />
                    <StatBox
                      label="Max"
                      value={stats.headway.go.max_min}
                      suffix="p"
                    />
                  </div>
                </div>
              )}

              {/* Divider */}
              {stats.headway?.go?.count > 0 &&
                stats.headway?.return?.count > 0 && (
                  <div className="border-t border-dashed border-[#E5EAF0]" />
                )}

              {/* RETURN */}
              {stats.headway?.return && stats.headway.return.count > 0 && (
                <div>
                  <HeadwayTimeline
                    trips={stats.headway.return.details}
                    label="Chiều về"
                    icon={ArrowLeftRight}
                  />

                  <div className="grid grid-cols-3 gap-2 mt-3">
                    <StatBox
                      label="Min"
                      value={stats.headway.return.min_min}
                      suffix="p"
                    />
                    <StatBox
                      label="Trung bình"
                      value={stats.headway.return.avg_min}
                      suffix="p"
                    />
                    <StatBox
                      label="Max"
                      value={stats.headway.return.max_min}
                      suffix="p"
                    />
                  </div>
                </div>
              )}
            </div>
          </div>

          {/* ═══════════ SERVICES ACTIVE ═══════════ */}
          {stats.services_active?.length > 0 && (
            <div className="bg-white rounded-xl border border-[#E5EAF0] p-4">
              <div className="flex items-center gap-2 mb-2">
                <CalendarDays size={13} className="text-[#169BA2]" />
                <h3 className="text-[11px] font-bold uppercase tracking-wider text-[#4A5A7A]">
                  Lịch áp dụng
                </h3>
              </div>
              <div className="flex flex-wrap gap-1.5">
                {stats.services_active.map((svc, i) => (
                  <Badge key={i} variant="info">
                    {svc}
                  </Badge>
                ))}
              </div>
            </div>
          )}
        </>
      )}
    </div>
  );
}
</file>

<file path="frontend/src/admin/components/routes/TripGenerationDialog.jsx">
import { useState, useEffect, useMemo } from "react";
import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
  DialogDescription,
  DialogFooter,
} from "@/components/ui/dialog";
import {
  Loader2,
  Sparkles,
  CalendarDays,
  Timer,
  AlertTriangle,
  Info,
  ListOrdered,
  RefreshCw,
  CheckCircle2,
} from "lucide-react";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Badge } from "@/components/ui/badge";
import { Checkbox } from "@/components/ui/checkbox";
import {
  usePreviewTrips,
  useGenerateTrips,
  useRegenerateTrips,
} from "@/hooks/useRouteOperations";
import { useCalendarsList } from "@/hooks/useServiceCalendars";

// ═══════════════════════════════════════════════════════════════
// MAIN DIALOG
// ═══════════════════════════════════════════════════════════════
export function TripGenerationDialog({
  open,
  onClose,
  routeId,
  operations,
  hasExistingTrips = false,
}) {
  // ─── State ───
  const [selectedServiceIds, setSelectedServiceIds] = useState([]);
  const [headwayMinutes, setHeadwayMinutes] = useState(15);
  const [mode, setMode] = useState(hasExistingTrips ? "reset" : "reset");
  const [preview, setPreview] = useState(null);

  // ─── Data ───
  const { data: calendarsData, isLoading: loadingCalendars } = useCalendarsList(
    { page: 1, limit: 100 },
  );
  const calendars = calendarsData?.data ?? [];

  // ─── Mutations ───
  const previewMut = usePreviewTrips();
  const generateMut = useGenerateTrips();
  const regenerateMut = useRegenerateTrips();

  // ─── Reset khi mở dialog ───
  useEffect(() => {
    if (open) {
      // Auto-select tất cả services
      setSelectedServiceIds(calendars.map((c) => c.id));
      // Default headway = min_headway_seconds
      if (operations?.min_headway_seconds) {
        setHeadwayMinutes(Math.floor(operations.min_headway_seconds / 60));
      }
      setMode(hasExistingTrips ? "reset" : "reset");
      setPreview(null);
    }
  }, [open, calendars, operations, hasExistingTrips]);

  // ─── Auto preview khi config thay đổi ───
  useEffect(() => {
    if (!open || !routeId) return;
    if (selectedServiceIds.length === 0) {
      setPreview(null);
      return;
    }

    const t = setTimeout(() => {
      previewMut.mutate(
        {
          routeId,
          payload: {
            service_ids: selectedServiceIds,
            headway_seconds: headwayMinutes * 60,
          },
        },
        {
          onSuccess: (data) => setPreview(data),
        },
      );
    }, 400);

    return () => clearTimeout(t);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [open, routeId, selectedServiceIds, headwayMinutes]);

  // ─── Handlers ───
  const toggleService = (id) => {
    setSelectedServiceIds((prev) =>
      prev.includes(id) ? prev.filter((x) => x !== id) : [...prev, id],
    );
  };

  const selectAllServices = () => {
    setSelectedServiceIds(calendars.map((c) => c.id));
  };

  const clearAllServices = () => {
    setSelectedServiceIds([]);
  };

  const handleGenerate = async () => {
    if (selectedServiceIds.length === 0) return;

    const payload = {
      service_ids: selectedServiceIds,
      headway_seconds: headwayMinutes * 60,
      mode,
    };

    if (hasExistingTrips && mode === "reset") {
      await regenerateMut.mutateAsync({ routeId, payload });
    } else {
      await generateMut.mutateAsync({ routeId, payload });
    }

    onClose?.();
  };

  const isGenerating = generateMut.isPending || regenerateMut.isPending;
  const canGenerate =
    selectedServiceIds.length > 0 && preview && preview.total_count > 0;

  return (
    <Dialog open={open} onOpenChange={(v) => !v && onClose?.()}>
      <DialogContent className="!max-w-[640px] w-[95vw] p-0">
        {/* ═══════════ HEADER ═══════════ */}
        <DialogHeader className="px-6 pt-6 pb-4">
          <div className="flex items-start gap-3">
            <div className="w-11 h-11 rounded-xl bg-[#E6F4F5] flex items-center justify-center flex-shrink-0">
              <Sparkles size={20} className="text-[#169BA2]" />
            </div>
            <div className="min-w-0">
              <DialogTitle className="text-base font-bold text-[#1A2332]">
                Sinh chuyến tự động
              </DialogTitle>
              <DialogDescription className="text-xs text-[#6A7A9A] mt-1">
                Hệ thống sẽ tạo danh sách chuyến dựa trên thông tin vận hành của
                tuyến. Bạn có thể chỉnh sửa sau khi sinh.
              </DialogDescription>
            </div>
          </div>
        </DialogHeader>

        {/* ═══════════ BODY ═══════════ */}
        <div className="px-6 pb-4 space-y-5 max-h-[60vh] overflow-y-auto scrollbar-thin">
          {/* ─── SECTION 1: SERVICES ─── */}
          <div className="space-y-3">
            <div className="flex items-center justify-between">
              <Label className="flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-[#8A9AAA]">
                <CalendarDays size={11} />
                Lịch phục vụ
              </Label>
              <div className="flex items-center gap-2 text-[11px]">
                <button
                  type="button"
                  onClick={selectAllServices}
                  className="text-[#169BA2] hover:text-[#0F7075] font-semibold cursor-pointer"
                >
                  Chọn tất cả
                </button>
                <span className="text-[#C2C8D4]">·</span>
                <button
                  type="button"
                  onClick={clearAllServices}
                  className="text-[#8A9AAA] hover:text-[#6A7A9A] cursor-pointer"
                >
                  Bỏ chọn
                </button>
              </div>
            </div>

            {loadingCalendars ? (
              <div className="flex items-center gap-2 py-4 text-xs text-[#8A9AAA]">
                <Loader2 size={12} className="animate-spin" />
                Đang tải lịch...
              </div>
            ) : calendars.length === 0 ? (
              <div className="flex items-start gap-2 p-3 rounded-lg bg-[#FFF8E1] border border-[#FFE0A3] text-xs text-[#8B6914]">
                <AlertTriangle size={12} className="flex-shrink-0 mt-0.5" />
                <span>
                  Chưa có lịch phục vụ nào. Vui lòng tạo lịch ở mục{" "}
                  <b>Lịch phục vụ</b> trước.
                </span>
              </div>
            ) : (
              <div className="grid grid-cols-2 gap-2">
                {calendars.map((cal) => {
                  const checked = selectedServiceIds.includes(cal.id);
                  const dayLabels = ["T2", "T3", "T4", "T5", "T6", "T7", "CN"];
                  const dayKeys = [
                    "monday",
                    "tuesday",
                    "wednesday",
                    "thursday",
                    "friday",
                    "saturday",
                    "sunday",
                  ];
                  const activeDays = dayKeys.filter((k) => cal[k]);

                  return (
                    <button
                      key={cal.id}
                      type="button"
                      onClick={() => toggleService(cal.id)}
                      className={`flex items-center gap-3 p-3 rounded-lg border text-left transition-all ${
                        checked
                          ? "bg-[#E6F4F5] border-[#169BA2] shadow-sm"
                          : "bg-white border-[#E5EAF0] hover:border-[#A8D5D8]"
                      }`}
                    >
                      <Checkbox
                        checked={checked}
                        onCheckedChange={() => toggleService(cal.id)}
                      />
                      <div className="flex-1 min-w-0">
                        <div className="text-sm font-bold text-[#1A2332] truncate">
                          {cal.service_id}
                        </div>
                        <div className="flex gap-0.5 mt-1">
                          {dayLabels.map((lbl, i) => (
                            <span
                              key={i}
                              className={`text-[9px] w-4 h-4 rounded flex items-center justify-center font-bold ${
                                activeDays.includes(dayKeys[i])
                                  ? "bg-[#169BA2] text-white"
                                  : "bg-[#F0F3F7] text-[#B0BCCA]"
                              }`}
                            >
                              {lbl}
                            </span>
                          ))}
                        </div>
                      </div>
                    </button>
                  );
                })}
              </div>
            )}
          </div>

          {/* ─── SECTION 2: HEADWAY ─── */}
          <div className="space-y-3">
            <Label className="flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-[#8A9AAA]">
              <Timer size={11} />
              Giãn cách sinh chuyến
            </Label>

            <div className="flex items-center gap-3">
              <div className="relative flex-1">
                <Input
                  type="number"
                  min="1"
                  max="180"
                  value={headwayMinutes}
                  onChange={(e) =>
                    setHeadwayMinutes(parseInt(e.target.value) || 1)
                  }
                  className="pr-14 font-mono text-base font-semibold"
                />
                <span className="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-semibold text-[#8A9AAA] pointer-events-none">
                  phút
                </span>
              </div>

              {operations && (
                <div className="text-[11px] text-[#8A9AAA] whitespace-nowrap">
                  Thiết kế:{" "}
                  <span className="font-semibold text-[#169BA2]">
                    {Math.floor(operations.min_headway_seconds / 60)}–
                    {Math.floor(operations.max_headway_seconds / 60)} phút
                  </span>
                </div>
              )}
            </div>

            {/* Quick presets */}
            <div className="flex gap-1.5">
              {[10, 15, 20, 30].map((m) => (
                <button
                  key={m}
                  type="button"
                  onClick={() => setHeadwayMinutes(m)}
                  className={`px-3 py-1 rounded-md text-[11px] font-semibold border transition-all ${
                    headwayMinutes === m
                      ? "bg-[#169BA2] text-white border-[#169BA2]"
                      : "bg-white text-[#6A7A9A] border-[#E5EAF0] hover:border-[#A8D5D8]"
                  }`}
                >
                  {m} phút
                </button>
              ))}
            </div>
          </div>

          {/* ─── SECTION 3: MODE (chỉ khi đã có trips) ─── */}
          {hasExistingTrips && (
            <div className="space-y-3">
              <Label className="flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-[#8A9AAA]">
                <RefreshCw size={11} />
                Chế độ sinh
              </Label>

              <div className="grid grid-cols-2 gap-2">
                <button
                  type="button"
                  onClick={() => setMode("reset")}
                  className={`p-3 rounded-lg border text-left transition-all ${
                    mode === "reset"
                      ? "bg-[#FFF3E0] border-[#FFB74D]"
                      : "bg-white border-[#E5EAF0] hover:border-[#FFB74D]"
                  }`}
                >
                  <div className="flex items-center gap-2 mb-1">
                    <RefreshCw
                      size={12}
                      className={
                        mode === "reset" ? "text-[#E08940]" : "text-[#8A9AAA]"
                      }
                    />
                    <span className="text-xs font-bold text-[#1A2332]">
                      Sinh lại hoàn toàn
                    </span>
                  </div>
                  <div className="text-[10px] text-[#6A7A9A] leading-relaxed">
                    Xóa hết chuyến cũ, tạo mới toàn bộ
                  </div>
                </button>

                <button
                  type="button"
                  onClick={() => setMode("additive")}
                  className={`p-3 rounded-lg border text-left transition-all ${
                    mode === "additive"
                      ? "bg-[#E6F4F5] border-[#169BA2]"
                      : "bg-white border-[#E5EAF0] hover:border-[#A8D5D8]"
                  }`}
                >
                  <div className="flex items-center gap-2 mb-1">
                    <ListOrdered
                      size={12}
                      className={
                        mode === "additive"
                          ? "text-[#169BA2]"
                          : "text-[#8A9AAA]"
                      }
                    />
                    <span className="text-xs font-bold text-[#1A2332]">
                      Thêm vào
                    </span>
                  </div>
                  <div className="text-[10px] text-[#6A7A9A] leading-relaxed">
                    Giữ chuyến cũ, chỉ thêm chuyến mới
                  </div>
                </button>
              </div>
            </div>
          )}

          {/* ─── SECTION 4: PREVIEW ─── */}
          <div className="space-y-3">
            <Label className="flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-[#8A9AAA]">
              <Info size={11} />
              Xem trước
            </Label>

            {previewMut.isPending ? (
              <div className="flex items-center justify-center gap-2 py-6 text-xs text-[#8A9AAA]">
                <Loader2 size={14} className="animate-spin text-[#169BA2]" />
                Đang tính toán...
              </div>
            ) : !preview || preview.total_count === 0 ? (
              <div className="flex items-start gap-2 p-3 rounded-lg bg-[#FFF8E1] border border-[#FFE0A3] text-xs text-[#8B6914]">
                <AlertTriangle size={12} className="flex-shrink-0 mt-0.5" />
                <span>
                  {selectedServiceIds.length === 0
                    ? "Vui lòng chọn ít nhất 1 lịch phục vụ."
                    : "Không có chuyến nào được sinh. Kiểm tra lại giãn cách và giờ hoạt động."}
                </span>
              </div>
            ) : (
              <div className="rounded-xl bg-[#E6F4F5] border border-[#A8D5D8] p-4">
                <div className="flex items-center gap-2 mb-3">
                  <CheckCircle2 size={14} className="text-[#169BA2]" />
                  <span className="text-sm font-bold text-[#0F7075]">
                    Sẽ sinh {preview.total_count} chuyến
                  </span>
                </div>

                <div className="grid grid-cols-3 gap-3">
                  <div>
                    <div className="text-[10px] uppercase tracking-wider text-[#12868C] font-semibold mb-0.5">
                      Chiều đi
                    </div>
                    <div className="text-lg font-bold text-[#0F7075] leading-none">
                      {preview.counts_by_direction?.go ?? 0}
                    </div>
                  </div>
                  <div>
                    <div className="text-[10px] uppercase tracking-wider text-[#12868C] font-semibold mb-0.5">
                      Chiều về
                    </div>
                    <div className="text-lg font-bold text-[#0F7075] leading-none">
                      {preview.counts_by_direction?.return ?? 0}
                    </div>
                  </div>
                  <div>
                    <div className="text-[10px] uppercase tracking-wider text-[#12868C] font-semibold mb-0.5">
                      Khung giờ
                    </div>
                    <div className="text-xs font-bold text-[#0F7075] font-mono leading-none pt-1">
                      {preview.first_trip_time?.slice(0, 5)} –{" "}
                      {preview.last_trip_time?.slice(0, 5)}
                    </div>
                  </div>
                </div>
              </div>
            )}
          </div>

          {/* ─── Warning nếu mode reset + có trips cũ ─── */}
          {hasExistingTrips && mode === "reset" && (
            <div className="flex items-start gap-2 p-3 rounded-lg bg-[#FFEBEE] border border-[#FFCDD2] text-xs text-[#C62828]">
              <AlertTriangle size={12} className="flex-shrink-0 mt-0.5" />
              <span>
                Chuyến cũ của tuyến sẽ bị xóa hoàn toàn và không thể khôi phục.
              </span>
            </div>
          )}
        </div>

        {/* ═══════════ FOOTER ═══════════ */}
        <DialogFooter className="px-6 py-4 border-t border-[#E5EAF0] bg-[#F8FAFC]">
          <Button variant="secondary" onClick={onClose} disabled={isGenerating}>
            Hủy
          </Button>
          <Button
            variant="primary"
            onClick={handleGenerate}
            disabled={!canGenerate || isGenerating}
            className="bg-[#169BA2] hover:bg-[#12868C] text-white min-w-[140px]"
          >
            {isGenerating ? (
              <>
                <Loader2 size={14} className="animate-spin" />
                Đang sinh...
              </>
            ) : (
              <>
                <Sparkles size={14} />
                Sinh {preview?.total_count ?? 0} chuyến
              </>
            )}
          </Button>
        </DialogFooter>
      </DialogContent>
    </Dialog>
  );
}
</file>

<file path="frontend/src/admin/components/trips/TripDetailDrawer.jsx">
import { useEffect, useState, useRef, useMemo } from "react";
import {
  X,
  Loader2,
  ToggleLeft,
  ToggleRight,
  MapPin,
  ListOrdered,
  Clock,
} from "lucide-react";
import L from "leaflet";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { useChangeTripStatus } from "@/hooks/useTrips";
import { useRouteOperations } from "@/hooks/useRouteOperations";

// ═══════════════════════════════════════════════════════════════
// Helpers
// ═══════════════════════════════════════════════════════════════
function fmtTime(t) {
  if (!t) return "—";
  return String(t).slice(0, 5);
}

function addSecondsToTime(timeStr, sec) {
  if (!timeStr) return "—";
  const [h, m, s = 0] = String(timeStr).split(":").map(Number);
  let total = h * 3600 + m * 60 + s + sec;
  const hh = Math.floor(total / 3600) % 24;
  const mm = Math.floor((total % 3600) / 60);
  const p = (n) => String(n).padStart(2, "0");
  return `${p(hh)}:${p(mm)}`;
}

function fmtOffset(sec) {
  if (sec == null) return "—";
  const m = Math.floor(sec / 60);
  return `+${m}p`;
}

// ═══════════════════════════════════════════════════════════════
// TAB 1: Lịch trình trạm dừng
// ═══════════════════════════════════════════════════════════════
function TimetableTab({ trip, stopTimes, isLoading }) {
  if (isLoading) {
    return (
      <div className="flex items-center justify-center py-12">
        <Loader2 size={20} className="animate-spin text-[#169BA2]" />
      </div>
    );
  }

  if (!stopTimes || stopTimes.length === 0) {
    return (
      <div className="py-12 text-center text-xs text-[#8A9AAA]">
        Không có lịch trình trạm dừng cho chuyến này
      </div>
    );
  }

  return (
    <div className="space-y-0">
      {/* ─── Header ─── */}
      <div className="grid grid-cols-[40px_1fr_70px_70px] gap-2 px-4 py-2 bg-[#F8FAFC] border-b border-[#E5EAF0] text-[10px] font-bold uppercase tracking-wider text-[#8A9AAA] sticky top-0 z-10">
        <div className="text-center">#</div>
        <div>Trạm dừng</div>
        <div className="text-right">Đến</div>
        <div className="text-right">Đi</div>
      </div>

      {/* ─── Rows ─── */}
      {stopTimes.map((st, idx) => {
        const isDepot = st.stop?.stop_type === 1;
        const arrivalTime = addSecondsToTime(
          trip.start_time,
          st.arrival_offset_seconds,
        );
        const departureTime = addSecondsToTime(
          trip.start_time,
          st.departure_offset_seconds,
        );

        return (
          <div
            key={st.id ?? idx}
            className="grid grid-cols-[40px_1fr_70px_70px] gap-2 px-4 py-2.5 border-b border-[#F0F3F7] last:border-b-0 hover:bg-[#F8FAFC] items-center"
          >
            {/* Số thứ tự */}
            <div className="flex justify-center">
              <span
                className={`w-6 h-6 rounded-full flex items-center justify-center text-[10px] font-bold ${
                  isDepot
                    ? "bg-[#169BA2] text-white"
                    : "bg-[#E6F4F5] text-[#169BA2]"
                }`}
              >
                {st.stop_sequence}
              </span>
            </div>

            {/* Tên trạm */}
            <div className="min-w-0">
              <div className="flex items-center gap-1.5">
                <span className="text-xs font-semibold text-[#1A2332] truncate">
                  {st.stop?.stop_name || `Trạm #${st.stop_id}`}
                </span>
                {isDepot && (
                  <Badge variant="info" className="text-[9px] flex-shrink-0">
                    Depot
                  </Badge>
                )}
              </div>
              <div className="text-[10px] text-[#8A9AAA] font-mono">
                {st.stop?.stop_id || st.stop_id}
              </div>
            </div>

            {/* Giờ đến */}
            <div className="text-right">
              <div className="text-xs font-bold text-[#1A2332] font-mono">
                {arrivalTime}
              </div>
              <div className="text-[9px] text-[#8A9AAA]">
                {fmtOffset(st.arrival_offset_seconds)}
              </div>
            </div>

            {/* Giờ đi */}
            <div className="text-right">
              <div className="text-xs font-bold text-[#1A2332] font-mono">
                {departureTime}
              </div>
              <div className="text-[9px] text-[#8A9AAA]">
                {fmtOffset(st.departure_offset_seconds)}
              </div>
            </div>
          </div>
        );
      })}

      {/* ─── Summary ─── */}
      <div className="px-4 py-3 bg-[#F8FAFC] border-t border-[#E5EAF0] flex items-center justify-between text-[10px]">
        <span className="text-[#8A9AAA]">
          Tổng: <b className="text-[#1A2332]">{stopTimes.length}</b> trạm
        </span>
        <span className="text-[#8A9AAA] font-mono">
          {fmtTime(trip.start_time)} →{" "}
          {stopTimes.length > 0
            ? addSecondsToTime(
                trip.start_time,
                stopTimes[stopTimes.length - 1].departure_offset_seconds,
              )
            : "—"}
        </span>
      </div>
    </div>
  );
}

// ═══════════════════════════════════════════════════════════════
// TAB 2: Bản đồ lộ trình
// ═══════════════════════════════════════════════════════════════
function RouteMapTab({ shape, stops, isLoading }) {
  const containerRef = useRef(null);
  const mapRef = useRef(null);
  const layersRef = useRef(null);

  useEffect(() => {
    if (!containerRef.current || mapRef.current) return;
    if (isLoading || !shape) return;

    const map = L.map(containerRef.current, {
      zoomControl: true,
      attributionControl: false,
    }).setView([10.82, 106.74], 13);

    L.tileLayer(
      "https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png",
      { subdomains: "abcd", maxZoom: 19 },
    ).addTo(map);

    const routeLayer = L.geoJSON(shape, {
      style: { color: "#169BA2", weight: 5, opacity: 0.85 },
    }).addTo(map);

    // Vẽ stops
    const stopMarkers = [];
    (stops || []).forEach((s) => {
      if (!s.latitude || !s.longitude) return;
      const isDepot = s.stop_type === 1;
      const m = L.circleMarker([s.latitude, s.longitude], {
        radius: isDepot ? 7 : 5,
        color: isDepot ? "#E08940" : "#169BA2",
        fillColor: "#fff",
        fillOpacity: 1,
        weight: 2,
      })
        .addTo(map)
        .bindPopup(
          `<div class="bus-popup"><b>${s.stop_name || "Trạm"}</b></div>`,
        );
      stopMarkers.push(m);
    });

    map.fitBounds(routeLayer.getBounds(), { padding: [30, 30] });

    mapRef.current = map;
    layersRef.current = { routeLayer, stopMarkers };

    return () => {
      map.remove();
      mapRef.current = null;
      layersRef.current = null;
    };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [shape, stops, isLoading]);

  if (isLoading) {
    return (
      <div className="flex items-center justify-center py-12">
        <Loader2 size={20} className="animate-spin text-[#169BA2]" />
      </div>
    );
  }

  if (!shape) {
    return (
      <div className="py-12 text-center text-xs text-[#8A9AAA]">
        Không có dữ liệu lộ trình cho chuyến này
      </div>
    );
  }

  return (
    <div className="h-full">
      <div ref={containerRef} className="w-full h-full" />
    </div>
  );
}

// ═══════════════════════════════════════════════════════════════
// MAIN DRAWER
// ═══════════════════════════════════════════════════════════════
export function TripDetailDrawer({
  trip,
  open,
  onClose,
  stopTimes = [],
  routeShape = null,
  routeStops = [],
  isLoadingStops = false,
  isLoadingShape = false,
}) {
  const [tab, setTab] = useState("timetable");
  const statusMut = useChangeTripStatus();

  // Reset tab khi mở
  useEffect(() => {
    if (open) setTab("timetable");
  }, [open, trip?.id]);

  // Đóng khi nhấn ESC
  useEffect(() => {
    if (!open) return;
    const onKey = (e) => {
      if (e.key === "Escape") onClose?.();
    };
    window.addEventListener("keydown", onKey);
    return () => window.removeEventListener("keydown", onKey);
  }, [open, onClose]);

  if (!open || !trip) return null;

  const isActive = trip.is_active !== false;

  const toggleStatus = () => {
    statusMut.mutate({ id: trip.id, is_active: !isActive });
  };

  // Tính thời lượng chuyến
  const travelTimeSec = useMemo(() => {
    if (!stopTimes || stopTimes.length === 0) return null;
    const last = stopTimes[stopTimes.length - 1];
    return last.arrival_offset_seconds;
  }, [stopTimes]);

  const arrivalEndTime = travelTimeSec
    ? addSecondsToTime(trip.start_time, travelTimeSec)
    : "—";

  return (
    <>
      {/* ═══════════ OVERLAY ═══════════ */}
      <div
        className="fixed inset-0 bg-black/30 backdrop-blur-[1px] z-[1000] animate-in fade-in"
        onClick={onClose}
      />

      {/* ═══════════ DRAWER ═══════════ */}
      <div
        className="fixed top-0 right-0 h-screen w-full max-w-[640px] bg-white shadow-2xl z-[1010] flex flex-col animate-in slide-in-from-right"
        style={{ animationDuration: "0.25s" }}
      >
        {/* ═══════ HEADER ═══════ */}
        <header className="flex-shrink-0 border-b border-[#E5EAF0] bg-white">
          <div className="flex items-start gap-3 px-5 py-4">
            {/* Left: Title */}
            <div className="flex-1 min-w-0">
              <div className="flex items-center gap-2 mb-1">
                <span
                  className="w-1 h-5 rounded-full flex-shrink-0"
                  style={{ background: trip.route_color || "#169BA2" }}
                />
                <h2 className="text-base font-bold text-[#1A2332] font-mono truncate">
                  {trip.trip_id}
                </h2>
              </div>
              <div className="flex items-center gap-2 text-xs text-[#6A7A9A] ml-3">
                <span className="font-semibold text-[#169BA2]">
                  {trip.route_short_name}
                </span>
                <span>·</span>
                <span>{trip.direction_id === 0 ? "Chiều đi" : "Chiều về"}</span>
                <span>·</span>
                <span className="font-mono">{fmtTime(trip.start_time)}</span>
              </div>
            </div>

            {/* Right: Toggle + Close */}
            <div className="flex items-center gap-2 flex-shrink-0">
              <button
                type="button"
                onClick={toggleStatus}
                disabled={statusMut.isPending}
                title={isActive ? "Tắt chuyến" : "Bật chuyến"}
                className={`inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-md text-[11px] font-semibold border transition-all cursor-pointer disabled:opacity-50 ${
                  isActive
                    ? "bg-[#F1F8F1] text-[#2E7D32] border-[#A8D5A8] hover:bg-[#E0F0E0]"
                    : "bg-[#F8FAFC] text-[#6A7A9A] border-[#E5EAF0] hover:bg-[#EEF2F6]"
                }`}
              >
                {statusMut.isPending ? (
                  <Loader2 size={12} className="animate-spin" />
                ) : isActive ? (
                  <ToggleRight size={14} />
                ) : (
                  <ToggleLeft size={14} />
                )}
                {isActive ? "Đang hoạt động" : "Đã tắt"}
              </button>

              <button
                type="button"
                onClick={onClose}
                title="Đóng"
                className="w-8 h-8 rounded-md hover:bg-[#F8FAFC] flex items-center justify-center cursor-pointer transition-colors"
              >
                <X size={16} className="text-[#6A7A9A]" />
              </button>
            </div>
          </div>

          {/* ═══════ META ROW ═══════ */}
          <div className="grid grid-cols-3 gap-3 px-5 pb-4">
            <div className="rounded-lg bg-[#F8FAFC] border border-[#E5EAF0] px-3 py-2">
              <div className="text-[9px] font-bold uppercase tracking-wider text-[#8A9AAA] mb-0.5">
                Biển hiệu
              </div>
              <div className="text-xs font-semibold text-[#1A2332] truncate">
                {trip.trip_headsign || "—"}
              </div>
            </div>

            <div className="rounded-lg bg-[#F8FAFC] border border-[#E5EAF0] px-3 py-2">
              <div className="text-[9px] font-bold uppercase tracking-wider text-[#8A9AAA] mb-0.5">
                Lịch áp dụng
              </div>
              <div className="text-xs font-semibold text-[#1A2332] truncate">
                {trip.service_code || "—"}
              </div>
            </div>

            <div className="rounded-lg bg-[#F8FAFC] border border-[#E5EAF0] px-3 py-2">
              <div className="text-[9px] font-bold uppercase tracking-wider text-[#8A9AAA] mb-0.5">
                Kết thúc dự kiến
              </div>
              <div className="text-xs font-semibold text-[#1A2332] font-mono">
                {arrivalEndTime}
              </div>
            </div>
          </div>

          {/* ═══════ TABS ═══════ */}
          <div className="flex border-t border-[#E5EAF0]">
            <button
              type="button"
              onClick={() => setTab("timetable")}
              className={`flex-1 inline-flex items-center justify-center gap-1.5 py-3 text-xs font-semibold border-b-2 transition-colors cursor-pointer ${
                tab === "timetable"
                  ? "text-[#169BA2] border-[#169BA2] bg-[#F0F9FA]"
                  : "text-[#6A7A9A] border-transparent hover:text-[#1A2332] hover:bg-[#F8FAFC]"
              }`}
            >
              <ListOrdered size={13} />
              Lịch trình trạm dừng
            </button>
            <button
              type="button"
              onClick={() => setTab("map")}
              className={`flex-1 inline-flex items-center justify-center gap-1.5 py-3 text-xs font-semibold border-b-2 transition-colors cursor-pointer ${
                tab === "map"
                  ? "text-[#169BA2] border-[#169BA2] bg-[#F0F9FA]"
                  : "text-[#6A7A9A] border-transparent hover:text-[#1A2332] hover:bg-[#F8FAFC]"
              }`}
            >
              <MapPin size={13} />
              Bản đồ lộ trình
            </button>
          </div>
        </header>

        {/* ═══════ BODY ═══════ */}
        <div className="flex-1 overflow-hidden">
          {tab === "timetable" ? (
            <div className="h-full overflow-y-auto scrollbar-thin">
              <TimetableTab
                trip={trip}
                stopTimes={stopTimes}
                isLoading={isLoadingStops}
              />
            </div>
          ) : (
            <RouteMapTab
              shape={routeShape}
              stops={routeStops}
              isLoading={isLoadingShape}
            />
          )}
        </div>
      </div>
    </>
  );
}
