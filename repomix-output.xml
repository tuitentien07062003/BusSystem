// ═══════════════════════════════════════════════════════════════
// MAIN DRAWER
// ═══════════════════════════════════════════════════════════════
export function EmployeeDetailDrawer({ employee, open, onClose }) {
  const [tab, setTab] = useState("overview");

  useEffect(() => {
    if (open) setTab("overview");
  }, [open, employee?.id]);

  useEffect(() => {
    if (!open) return;
    const onKey = (e) => {
      if (e.key === "Escape") onClose?.();
    };
    window.addEventListener("keydown", onKey);
    return () => window.removeEventListener("keydown", onKey);
  }, [open, onClose]);

  if (!open || !employee) return null;

  const typeStyle =
    EMPLOYEE_TYPE_STYLES[employee.type] || EMPLOYEE_TYPE_STYLES.driver;
  const isDriverOrCoDriver =
    employee.type === "driver" || employee.type === "co_driver";

  const TABS = [
    { id: "overview", label: "Tổng quan", icon: Info },
    ...(isDriverOrCoDriver
      ? [
          { id: "schedule", label: "Lịch tuần này", icon: CalendarDays },
          { id: "assignments", label: "Ca chạy", icon: Briefcase },
        ]
      : []),
    ...(employee.type === "driver"
      ? [{ id: "unavailability", label: "Nghỉ phép", icon: AlertTriangle }]
      : []),
  ];

  return (
    <>
      <div
        className="fixed inset-0 bg-black/30 backdrop-blur-[1px] z-[1000] animate-in fade-in"
        onClick={onClose}
      />
      <div
        className="fixed top-0 right-0 h-screen w-full max-w-[520px] bg-white shadow-2xl z-[1010] flex flex-col animate-in slide-in-from-right"
        style={{ animationDuration: "0.25s" }}
      >
        {/* Header */}
        <header className="flex-shrink-0 border-b border-[#E5EAF0] bg-white">
          <div className="flex items-start gap-3 px-5 py-4">
            <EmployeeAvatar employee={employee} size="lg" />
            <div className="flex-1 min-w-0 pt-1">
              <div className="text-base font-bold text-[#1A2332] leading-tight mb-1">
                {employee.full_name}
              </div>
              <div className="flex items-center gap-2 flex-wrap">
                <span className="text-[11px] text-[#8A9AAA] font-mono">
                  {employee.employee_code}
                </span>
                <span
                  className={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider border ${typeStyle.bg} ${typeStyle.text} ${typeStyle.border}`}
                >
                  <span
                    className={`w-1.5 h-1.5 rounded-full ${typeStyle.dot}`}
                  />
                  {EMPLOYEE_TYPE_LABELS[employee.type] || employee.type}
                </span>
                {employee.is_active !== false ? (
                  <span className="inline-flex items-center gap-1 text-[10px] font-semibold text-[#2E7D32]">
                    <span className="w-1.5 h-1.5 rounded-full bg-[#2E7D32]" />
                    Hoạt động
                  </span>
                ) : (
                  <span className="inline-flex items-center gap-1 text-[10px] font-semibold text-[#8A9AAA]">
                    <span className="w-1.5 h-1.5 rounded-full bg-[#8A9AAA]" />
                    Ngưng
                  </span>
                )}
              </div>
            </div>
            <button
              type="button"
              onClick={onClose}
              className="w-8 h-8 rounded-md hover:bg-[#F8FAFC] flex items-center justify-center cursor-pointer flex-shrink-0"
            >
              <X size={16} className="text-[#6A7A9A]" />
            </button>
          </div>

          {/* Tabs */}
          <div className="flex border-t border-[#E5EAF0] overflow-x-auto scrollbar-thin">
            {TABS.map((t) => (
              <button
                key={t.id}
                type="button"
                onClick={() => setTab(t.id)}
                className={`flex-1 min-w-fit inline-flex items-center justify-center gap-1.5 py-3 px-4 text-xs font-semibold border-b-2 transition-colors cursor-pointer whitespace-nowrap ${
                  tab === t.id
                    ? "text-[#169BA2] border-[#169BA2] bg-[#F0F9FA]"
                    : "text-[#6A7A9A] border-transparent hover:text-[#1A2332] hover:bg-[#F8FAFC]"
                }`}
              >
                <t.icon size={13} />
                {t.label}
              </button>
            ))}
          </div>
        </header>

        {/* Body */}
        <div className="flex-1 overflow-y-auto px-5 py-4 scrollbar-thin">
          {tab === "overview" && <OverviewTab employee={employee} />}
          {tab === "schedule" && <ScheduleTab employee={employee} />}
          {tab === "assignments" && <AssignmentsTab employee={employee} />}
          {tab === "unavailability" && (
            <UnavailabilityTab employee={employee} />
          )}
        </div>
      </div>
    </>
  );
}
</file>

<file path="src/admin/components/employees/EmployeeFilterBar.jsx">
import { useEffect, useRef } from "react";
import { Search, RefreshCw, X, LayoutGrid, List } from "lucide-react";
import { Input } from "@/components/ui/input";
import {
  Select,
  SelectTrigger,
  SelectValue,
  SelectContent,
  SelectItem,
} from "@/components/ui/select";
import { EmployeeTypeChips } from "./EmployeeTypeChips";

export function EmployeeFilterBar({
  searchInput,
  typeFilter,
  statusFilter,
  viewMode,
  onSearchChange,
  onTypeChange,
  onStatusChange,
  onViewModeChange,
  onRefresh,
  isFetching,
}) {
  const inputRef = useRef(null);

  useEffect(() => {
    const onKey = (e) => {
      if (
        e.key === "/" &&
        !["INPUT", "TEXTAREA"].includes(document.activeElement?.tagName)
      ) {
        e.preventDefault();
        inputRef.current?.focus();
      }
    };
    window.addEventListener("keydown", onKey);
    return () => window.removeEventListener("keydown", onKey);
  }, []);

  return (
    <div className="bg-white rounded-xl border border-[#E5EAF0] p-3 space-y-3">
      {/* Row 1: Search + status + view */}
      <div className="flex gap-2 items-center">
        <div className="relative flex-1">
          <Search
            size={14}
            className="absolute left-3 top-1/2 -translate-y-1/2 text-[#8A9AAA] pointer-events-none"
          />
          <Input
            ref={inputRef}
            placeholder="Tìm theo mã, tên, SĐT, email...  (nhấn / để focus)"
            value={searchInput}
            onChange={(e) => onSearchChange(e.target.value)}
            className="pl-8 pr-8 h-9"
          />
          {searchInput && (
            <button
              type="button"
              onClick={() => onSearchChange("")}
              className="absolute right-2 top-1/2 -translate-y-1/2 w-5 h-5 rounded flex items-center justify-center text-[#8A9AAA] hover:bg-[#EEF2F6] cursor-pointer"
            >
              <X size={12} />
            </button>
          )}
        </div>

        <Select value={statusFilter} onValueChange={onStatusChange}>
          <SelectTrigger className="w-[150px] h-9">
            <SelectValue />
          </SelectTrigger>
          <SelectContent>
            <SelectItem value="all">Tất cả trạng thái</SelectItem>
            <SelectItem value="true">Đang hoạt động</SelectItem>
            <SelectItem value="false">Ngưng hoạt động</SelectItem>
          </SelectContent>
        </Select>

        {/* View toggle */}
        <div className="inline-flex items-center bg-[#F8FAFC] rounded-md border border-[#E5EAF0] p-0.5">
          <button
            type="button"
            onClick={() => onViewModeChange("grid")}
            title="Dạng thẻ"
            className={`w-8 h-8 rounded flex items-center justify-center cursor-pointer transition-colors ${
              viewMode === "grid"
                ? "bg-white text-[#169BA2] shadow-sm"
                : "text-[#8A9AAA] hover:text-[#4A5A7A]"
            }`}
          >
            <LayoutGrid size={14} />
          </button>
          <button
            type="button"
            onClick={() => onViewModeChange("list")}
            title="Dạng bảng"
            className={`w-8 h-8 rounded flex items-center justify-center cursor-pointer transition-colors ${
              viewMode === "list"
                ? "bg-white text-[#169BA2] shadow-sm"
                : "text-[#8A9AAA] hover:text-[#4A5A7A]"
            }`}
          >
            <List size={14} />
          </button>
        </div>

        <button
          type="button"
          onClick={onRefresh}
          disabled={isFetching}
          title="Tải lại"
          className="h-9 w-9 flex-shrink-0 rounded-md border border-[#D0D7E2] bg-white hover:bg-[#F8FAFC] disabled:opacity-50 flex items-center justify-center cursor-pointer"
        >
          <RefreshCw
            size={14}
            className={
              isFetching ? "animate-spin text-[#169BA2]" : "text-[#4A5A7A]"
            }
          />
        </button>
      </div>

      {/* Row 2: Type chips */}
      <EmployeeTypeChips value={typeFilter} onChange={onTypeChange} />
    </div>
  );
}
</file>

<file path="src/admin/components/employees/EmployeeFormDialog.jsx">
import { useEffect } from "react";
import { useForm, Controller } from "react-hook-form";
import { zodResolver } from "@hookform/resolvers/zod";
import { z } from "zod";
import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
  DialogDescription,
  DialogFooter,
} from "@/components/ui/dialog";
import {
  Select,
  SelectTrigger,
  SelectValue,
  SelectContent,
  SelectItem,
} from "@/components/ui/select";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Button } from "@/components/ui/button";
import { Switch } from "@/components/ui/switch";
import { useCreateEmployee, useUpdateEmployee } from "@/hooks/useEmployees";

const schema = z
  .object({
    employee_code: z.string().trim().min(1, "Mã nhân viên không được để trống"),
    full_name: z.string().trim().min(1, "Họ tên không được để trống"),
    type: z.enum(["driver", "co_driver", "depot_staff", "dispatcher"], {
      message: "Vui lòng chọn loại nhân viên",
    }),
    phone: z
      .string()
      .trim()
      .optional()
      .refine(
        (v) => !v || /^(0|\+84)\d{9,10}$/.test(v.replace(/\s+/g, "")),
        "Số điện thoại không đúng định dạng (VD: 0912345678)",
      ),
    email: z
      .string()
      .trim()
      .optional()
      .refine(
        (v) => !v || /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v),
        "Email không đúng định dạng",
      ),
    license_number: z.string().trim().optional(),
    license_class: z.string().trim().optional(),
    license_expiry: z.string().optional(),
    hire_date: z.string().optional(),
    is_active: z.boolean(),
  })
  .refine(
    (d) => {
      if (d.type === "driver" && d.license_expiry && !d.license_class) {
        return false;
      }
      return true;
    },
    {
      message: "Tài xế có ngày hết hạn bằng lái thì phải nhập hạng bằng",
      path: ["license_class"],
    },
  );

// ═══════════════════════════════════════════════════════════════
// Component
// ═══════════════════════════════════════════════════════════════
export function EmployeeFormDialog({ employee, open, onOpenChange }) {
  const isEdit = !!employee;
  const createMut = useCreateEmployee();
  const updateMut = useUpdateEmployee();

  const {
    register,
    handleSubmit,
    reset,
    watch,
    setValue,
    control,
    formState: { errors, isSubmitting },
  } = useForm({
    resolver: zodResolver(schema),
    defaultValues: {
      employee_code: "",
      full_name: "",
      type: "driver",
      phone: "",
      email: "",
      license_number: "",
      license_class: "",
      license_expiry: "",
      hire_date: "",
      is_active: true,
    },
  });

  useEffect(() => {
    if (open) {
      reset(
        employee
          ? {
              employee_code: employee.employee_code || "",
              full_name: employee.full_name || "",
              type: employee.type || "driver",
              phone: employee.phone || "",
              email: employee.email || "",
              license_number: employee.license_number || "",
              license_class: employee.license_class || "",
              license_expiry: employee.license_expiry || "",
              hire_date: employee.hire_date || "",
              is_active: employee.is_active ?? true,
            }
          : {
              employee_code: "",
              full_name: "",
              type: "driver",
              phone: "",
              email: "",
              license_number: "",
              license_class: "",
              license_expiry: "",
              hire_date: "",
              is_active: true,
            },
      );
    }
  }, [open, employee, reset]);

  const currentType = watch("type");
  const isActive = watch("is_active");
  const showLicenseFields =
    currentType === "driver" || currentType === "co_driver";

  const onSubmit = async (values) => {
    const payload = {
      employee_code: values.employee_code.trim(),
      full_name: values.full_name.trim(),
      type: values.type,
      phone: values.phone?.trim() || null,
      email: values.email?.trim() || null,
      license_number: showLicenseFields
        ? values.license_number?.trim() || null
        : null,
      license_class: showLicenseFields
        ? values.license_class?.trim() || null
        : null,
      license_expiry: showLicenseFields ? values.license_expiry || null : null,
      hire_date: values.hire_date || null,
      is_active: values.is_active,
    };

    if (isEdit) {
      await updateMut.mutateAsync({ id: employee.id, payload });
    } else {
      await createMut.mutateAsync(payload);
    }
    onOpenChange(false);
  };

  return (
    <Dialog open={open} onOpenChange={onOpenChange}>
      <DialogContent className="max-w-2xl">
        <DialogHeader>
          <DialogTitle>
            {isEdit ? `Sửa nhân viên #${employee.id}` : "Thêm nhân viên"}
          </DialogTitle>
          <DialogDescription>
            Trường có dấu <b>*</b> là bắt buộc.
          </DialogDescription>
        </DialogHeader>

        <form onSubmit={handleSubmit(onSubmit)} className="px-5 py-4 space-y-4">
          {/* ─── Hàng 1: Mã + Loại ─── */}
          <div className="grid grid-cols-2 gap-3">
            <div className="space-y-1">
              <Label>
                Mã nhân viên <span className="text-rose-500">*</span>
              </Label>
              <Input
                {...register("employee_code")}
                placeholder="VD: DRV_001"
                disabled={isEdit}
              />
              {errors.employee_code && (
                <p className="text-[11px] text-[#C0392B]">
                  {errors.employee_code.message}
                </p>
              )}
            </div>

            <div className="space-y-1">
              <Label>
                Loại nhân viên <span className="text-rose-500">*</span>
              </Label>
              <Controller
                name="type"
                control={control}
                render={({ field }) => (
                  <Select value={field.value} onValueChange={field.onChange}>
                    <SelectTrigger className="w-full">
                      <SelectValue />
                    </SelectTrigger>
                    <SelectContent>
                      <SelectItem value="driver">Tài xế</SelectItem>
                      <SelectItem value="co_driver">Lơ xe</SelectItem>
                      <SelectItem value="depot_staff">
                        Nhân viên depot
                      </SelectItem>
                      <SelectItem value="dispatcher">Điều độ viên</SelectItem>
                    </SelectContent>
                  </Select>
                )}
              />
              {errors.type && (
                <p className="text-[11px] text-[#C0392B]">
                  {errors.type.message}
                </p>
              )}
            </div>
          </div>

          {/* ─── Hàng 2: Họ tên ─── */}
          <div className="space-y-1">
            <Label>
              Họ và tên <span className="text-rose-500">*</span>
            </Label>
            <Input {...register("full_name")} placeholder="VD: Nguyễn Văn An" />
            {errors.full_name && (
              <p className="text-[11px] text-[#C0392B]">
                {errors.full_name.message}
              </p>
            )}
          </div>

          {/* ─── Hàng 3: SĐT + Email ─── */}
          <div className="grid grid-cols-2 gap-3">
            <div className="space-y-1">
              <Label>Số điện thoại</Label>
              <Input {...register("phone")} placeholder="0912345678" />
              {errors.phone && (
                <p className="text-[11px] text-[#C0392B]">
                  {errors.phone.message}
                </p>
              )}
            </div>

            <div className="space-y-1">
              <Label>Email</Label>
              <Input
                type="email"
                {...register("email")}
                placeholder="ten@tbus.vn"
              />
              {errors.email && (
                <p className="text-[11px] text-[#C0392B]">
                  {errors.email.message}
                </p>
              )}
            </div>
          </div>

          {/* ─── Khối bằng lái — chỉ hiện với tài xế / lơ xe ─── */}
          {showLicenseFields && (
            <div className="pt-3 border-t border-[#EEF2F6] space-y-3">
              <div className="text-[11px] font-semibold uppercase tracking-wider text-[#8A9AAA]">
                Thông tin bằng lái
              </div>

              <div className="grid grid-cols-3 gap-3">
                <div className="space-y-1">
                  <Label>Hạng bằng</Label>
                  <Input
                    {...register("license_class")}
                    placeholder="VD: D, E"
                  />
                  {errors.license_class && (
                    <p className="text-[11px] text-[#C0392B]">
                      {errors.license_class.message}
                    </p>
                  )}
                </div>

                <div className="space-y-1">
                  <Label>Số bằng lái</Label>
                  <Input
                    {...register("license_number")}
                    placeholder="VD: GPLX-001234"
                  />
                </div>

                <div className="space-y-1">
                  <Label>Ngày hết hạn</Label>
                  <Input type="date" {...register("license_expiry")} />
                </div>
              </div>
            </div>
          )}

          {/* ─── Ngày vào làm ─── */}
          <div className="space-y-1">
            <Label>Ngày vào làm</Label>
            <Input type="date" {...register("hire_date")} />
          </div>

          {/* ─── Trạng thái ─── */}
          <div className="flex items-center justify-between py-2 border-t border-[#EEF2F6]">
            <div>
              <Label>Đang hoạt động</Label>
              <div className="text-[11px] text-[#8A9AAA] mt-0.5">
                Nhân viên ngưng hoạt động sẽ không được phân ca
              </div>
            </div>
            <Switch
              checked={isActive}
              onCheckedChange={(v) => setValue("is_active", v)}
            />
          </div>

          <DialogFooter className="-mx-5 -mb-4">
            <Button
              type="button"
              variant="secondary"
              onClick={() => onOpenChange(false)}
              disabled={isSubmitting}
            >
              Hủy
            </Button>
            <Button type="submit" variant="primary" disabled={isSubmitting}>
              {isSubmitting
                ? "Đang lưu..."
                : isEdit
                  ? "Lưu thay đổi"
                  : "Tạo nhân viên"}
            </Button>
          </DialogFooter>
        </form>
      </DialogContent>
    </Dialog>
  );
}
</file>

<file path="src/admin/components/employees/EmployeesTable.jsx">
import { Pencil, Power, PowerOff } from "lucide-react";
import { Badge } from "@/components/ui/badge";
import { DataTable } from "@/components/ui/data-table";
import { useChangeEmployeeStatus } from "@/hooks/useEmployees";
import { EMPLOYEE_TYPE_LABELS } from "./employeeConstants";

function formatDate(s) {
  if (!s) return "—";
  try {
    return new Date(s).toLocaleDateString("vi-VN");
  } catch {
    return "—";
  }
}

function TypeBadge({ type }) {
  const variants = {
    driver: "info",
    co_driver: "success",
    depot_staff: "warning",
    dispatcher: "muted",
  };
  return (
    <Badge variant={variants[type] || "muted"}>
      {EMPLOYEE_TYPE_LABELS[type] || type}
    </Badge>
  );
}

function LicenseCell({ row }) {
  if (row.type !== "driver" && row.type !== "co_driver") {
    return <span className="text-xs text-[#B0BCCA]">—</span>;
  }
  if (!row.license_class && !row.license_number) {
    return <span className="text-xs text-[#B0BCCA]">Chưa có</span>;
  }

  const isExpired =
    row.license_expiry && new Date(row.license_expiry) < new Date();

  return (
    <div className="space-y-0.5">
      <div className="text-xs text-[#1A2332] font-mono">
        {row.license_class || "—"}
        {row.license_number ? ` · ${row.license_number}` : ""}
      </div>
      {row.license_expiry && (
        <div
          className={`text-[10px] ${
            isExpired ? "text-[#C62828] font-semibold" : "text-[#8A9AAA]"
          }`}
        >
          Hết hạn: {formatDate(row.license_expiry)}
        </div>
      )}
    </div>
  );
}

export function EmployeesTable({
  employees,
  isLoading,
  onEdit,
  sortBy,
  sortOrder,
  onSort,
}) {
  const statusMut = useChangeEmployeeStatus();

  const columns = [
    {
      key: "id",
      label: "ID",
      sortable: true,
      width: 60,
      render: (r) => (
        <span className="text-[#6A7A9A] font-mono text-xs">{r.id}</span>
      ),
    },
    {
      key: "employee_code",
      label: "Mã nhân viên",
      sortable: true,
      width: 130,
      render: (r) => (
        <span className="font-mono text-xs text-[#169BA2] font-semibold">
          {r.employee_code}
        </span>
      ),
    },
    {
      key: "full_name",
      label: "Họ tên",
      sortable: true,
      render: (r) => (
        <span className="font-medium text-[#1A2332]">{r.full_name}</span>
      ),
    },
    {
      key: "type",
      label: "Loại",
      align: "center",
      width: 130,
      render: (r) => <TypeBadge type={r.type} />,
    },
    {
      key: "phone",
      label: "Điện thoại",
      width: 120,
      render: (r) => (
        <span className="text-xs text-[#4A5A7A] font-mono">
          {r.phone || "—"}
        </span>
      ),
    },
    {
      key: "email",
      label: "Email",
      render: (r) => (
        <span className="text-xs text-[#4A5A7A] truncate block max-w-[180px]">
          {r.email || "—"}
        </span>
      ),
    },
    {
      key: "license",
      label: "Bằng lái",
      width: 170,
      render: (r) => <LicenseCell row={r} />,
    },
    {
      key: "hire_date",
      label: "Ngày vào làm",
      sortable: true,
      width: 110,
      render: (r) => (
        <span className="text-xs text-[#6A7A9A]">
          {formatDate(r.hire_date)}
        </span>
      ),
    },
    {
      key: "is_active",
      label: "Trạng thái",
      align: "center",
      width: 120,
      render: (r) =>
        r.is_active ? (
          <Badge variant="success">Hoạt động</Badge>
        ) : (
          <Badge variant="danger">Ngưng</Badge>
        ),
    },
    {
      key: "actions",
      label: "Hành động",
      align: "center",
      width: 100,
      render: (r) => (
        <div className="flex items-center justify-center gap-1">
          <button
            type="button"
            onClick={(e) => {
              e.stopPropagation();
              onEdit(r);
            }}
            title="Sửa thông tin"
            className="h-7 w-7 rounded-md border border-[#CBD5E1] bg-white hover:bg-[#EEF2F6] flex items-center justify-center cursor-pointer"
          >
            <Pencil size={12} className="text-[#169BA2]" />
          </button>
          <button
            type="button"
            onClick={(e) => {
              e.stopPropagation();
              statusMut.mutate({ id: r.id, is_active: !r.is_active });
            }}
            disabled={statusMut.isPending}
            title={r.is_active ? "Ngưng hoạt động" : "Kích hoạt"}
            className={`h-7 w-7 rounded-md border flex items-center justify-center cursor-pointer disabled:opacity-50 ${
              r.is_active
                ? "border-[#F5B7B1] bg-white hover:bg-[#FDE8E8]"
                : "border-[#A8D5D8] bg-white hover:bg-[#E6F4F5]"
            }`}
          >
            {r.is_active ? (
              <PowerOff size={12} className="text-[#C0392B]" />
            ) : (
              <Power size={12} className="text-[#169BA2]" />
            )}
          </button>
        </div>
      ),
    },
  ];

  return (
    <DataTable
      columns={columns}
      rows={employees}
      isLoading={isLoading}
      emptyMessage="Chưa có nhân viên nào"
      sortBy={sortBy}
      sortOrder={sortOrder}
      onSort={onSort}
    />
  );
}
</file>

<file path="src/admin/components/employees/EmployeeTypeChips.jsx">
import {
  EMPLOYEE_TYPE_LABELS,
  EMPLOYEE_TYPE_STYLES,
} from "./employeeConstants";

const TYPES = [
  { value: "all", label: "Tất cả" },
  { value: "driver", label: EMPLOYEE_TYPE_LABELS.driver },
  { value: "co_driver", label: EMPLOYEE_TYPE_LABELS.co_driver },
  { value: "depot_staff", label: EMPLOYEE_TYPE_LABELS.depot_staff },
  { value: "dispatcher", label: EMPLOYEE_TYPE_LABELS.dispatcher },
];

export function EmployeeTypeChips({ value, onChange }) {
  return (
    <div className="flex flex-wrap gap-1.5">
      {TYPES.map((t) => {
        const isActive = value === t.value;
        const style = t.value === "all" ? null : EMPLOYEE_TYPE_STYLES[t.value];

        return (
          <button
            key={t.value}
            type="button"
            onClick={() => onChange(t.value)}
            className={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold border transition-all cursor-pointer ${
              isActive
                ? "bg-[#1A2332] text-white border-[#1A2332] shadow-sm"
                : style
                  ? `${style.bg} ${style.text} ${style.border} hover:shadow-sm`
                  : "bg-white text-[#4A5A7A] border-[#D0D7E2] hover:border-[#169BA2]"
            }`}
          >
            {style && (
              <span
                className={`w-1.5 h-1.5 rounded-full ${
                  isActive ? "bg-white" : style.dot
                }`}
              />
            )}
            {t.label}
          </button>
        );
      })}
    </div>
  );
}
