<file path="frontend/src/admin/components/routes/StopSelector.jsx">
import { Search, X, Check, MapPin, Loader2 } from 'lucide-react';
import { Input } from '@/components/ui/input';
import { Checkbox } from '@/components/ui/checkbox';
import { Badge } from '@/components/ui/badge';

export function StopSelector({
  results = [],
  selectedStops = [],
  selectedIds,
  onToggle,
  onClearAll,
  onFocus,
  focusedId,
  hoveredId,
  onHover,
  keyword,
  onKeywordChange,
  isLoading,
  disabled,
}) {
  if (disabled) {
    return (
      <div className="rounded-md border border-dashed border-[#d0d7e2] p-6 text-center text-xs text-[#8a9aaa]">
        Chọn đủ điểm đầu và điểm cuối để hiển thị danh sách trạm
      </div>
    );
  }

  const hasKeyword = keyword.trim().length > 0;
  const resultIds = new Set(results.map((s) => s.id));
  const selectedOnly = hasKeyword
    ? []
    : selectedStops.filter((s) => !resultIds.has(s.id));

  const selectedMatching = hasKeyword
    ? results.filter((s) => selectedIds.has(s.id)).length
    : 0;

  // Click vào cả row → toggle chọn + focus map
  const handleRowClick = (stop) => {
    onToggle(stop);              // tick/bỏ tick
    onFocus?.(stop);             // flyTo stop
  };

  return (
    <div className="flex flex-col border border-[#cbd5e1] rounded-md overflow-hidden bg-white">
      <div className="flex items-center justify-between px-3 py-2 border-b border-[#eef2f6] bg-[#f8fafc]">
        <div className="flex items-center gap-2">
          <span className="text-xs font-semibold text-[#4a5a7a]">Trạm dừng</span>
          {selectedIds.size > 0 && (
            <Badge variant="info">Đã chọn {selectedIds.size}</Badge>
          )}
          {hasKeyword && selectedMatching > 0 && (
            <Badge variant="success">{selectedMatching} khớp keyword</Badge>
          )}
        </div>
        {selectedIds.size > 0 && (
          <button
            onClick={onClearAll}
            className="text-[11px] font-semibold text-[#c0392b] hover:text-[#a93226] cursor-pointer flex items-center gap-1"
          >
            <X size={11} /> Bỏ chọn tất cả
          </button>
        )}
      </div>

      <div className="p-2 border-b border-[#eef2f6]">
        <div className="relative">
          <Search size={12} className="absolute left-2.5 top-1/2 -translate-y-1/2 text-[#8a9aaa]" />
          <Input
            value={keyword}
            onChange={(e) => onKeywordChange(e.target.value)}
            placeholder="Tìm trạm (không cần dấu)..."
            className="h-8 pl-7 pr-7 text-xs"
            autoFocus
          />
          {isLoading && (
            <Loader2
              size={12}
              className="absolute right-2.5 top-1/2 -translate-y-1/2 text-[#169BA2] animate-spin"
            />
          )}
        </div>
        <div className="mt-1 text-[10px] text-[#8a9aaa]">
          {hasKeyword
            ? isLoading ? 'Đang tìm...' : `${results.length} kết quả khớp`
            : `Hiển thị ${results.length} trạm đầu · Gõ để tìm`}
        </div>
      </div>

      <div className="max-h-[320px] overflow-y-auto scrollbar-thin">
        {!hasKeyword && selectedOnly.length > 0 && (
          <>
            <div className="px-3 py-1.5 bg-[#f0f7fc] text-[10px] font-bold uppercase tracking-wider text-[#169BA2] border-b border-[#e5eaf0] sticky top-0 z-10">
              Đã chọn ({selectedOnly.length})
            </div>
            {selectedOnly.map((s) => (
              <StopRow
                key={`sel-${s.id}`}
                stop={s}
                checked={true}
                hovered={hoveredId === s.id}
                focused={focusedId === s.id}
                onClick={() => handleRowClick(s)}
                onHover={onHover}
              />
            ))}
            <div className="px-3 py-1.5 bg-[#f8fafc] text-[10px] font-bold uppercase tracking-wider text-[#8a9aaa] border-y border-[#eef2f6] sticky top-0 z-10">
              Tất cả trạm
            </div>
          </>
        )}

        {results.length === 0 && !isLoading ? (
          <div className="px-3 py-8 text-center text-xs text-[#8a9aaa]">
            {hasKeyword ? 'Không tìm thấy trạm nào khớp' : 'Đang tải danh sách trạm...'}
          </div>
        ) : (
          results.map((s) => (
            <StopRow
              key={s.id}
              stop={s}
              checked={selectedIds.has(s.id)}
              hovered={hoveredId === s.id}
              focused={focusedId === s.id}
              onClick={() => handleRowClick(s)}
              onHover={onHover}
            />
          ))
        )}
      </div>
    </div>
  );
}

function StopRow({ stop, checked, hovered, focused, onClick, onHover }) {
  return (
    <div
      onClick={onClick}
      onMouseEnter={() => onHover?.(stop)}
      onMouseLeave={() => onHover?.(null)}
      className={`flex items-center gap-2 px-3 py-2 cursor-pointer border-b border-[#f3f5f9] last:border-0 transition-colors ${
        checked ? 'bg-[#f0f7fc]' : ''
      } ${hovered ? 'bg-[#fdf2e3]' : 'hover:bg-[#f8fafc]'}`}
    >
      <Checkbox checked={checked} onCheckedChange={() => {}} />
      <div className="flex-1 min-w-0">
        <div className="text-xs font-medium text-[#1a2332] truncate">{stop.stop_name}</div>
        <div className="text-[10px] text-[#8a9aaa] font-mono">{stop.stop_id}</div>
      </div>
      {hovered && !checked && <MapPin size={12} className="text-[#d48c2c] flex-shrink-0" />}
      {checked && !hovered && <Check size={13} className="text-[#169BA2] flex-shrink-0" />}
    </div>
  );
}
</file>

<file path="frontend/src/admin/components/trips/TripFormDialog.jsx">
import { useEffect } from 'react';
import { useForm } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';
import { z } from 'zod';
import {
  Dialog, DialogContent, DialogHeader, DialogTitle, DialogDescription, DialogFooter,
} from '@/components/ui/dialog';
import { Input } from '@/components/ui/input';
import { Label } from '@/components/ui/label';
import { Button } from '@/components/ui/button';
import { Switch } from '@/components/ui/switch';
import { useCreateTrip, useUpdateTrip } from '@/hooks/useTrips';

const schema = z.object({
  trip_id: z.string().trim().min(1, 'Mã chuyến không được để trống'),
  trip_pattern_id: z.coerce.number().int().optional().nullable(),
  service_id: z.coerce.number().int().optional().nullable(),
  start_time: z.string().min(1, 'Giờ xuất bến bắt buộc'),
  is_active: z.boolean(),
});

export function TripFormDialog({ trip, open, onOpenChange }) {
  const isEdit = !!trip;
  const createMut = useCreateTrip();
  const updateMut = useUpdateTrip();

  const { register, handleSubmit, reset, watch, setValue, formState: { errors, isSubmitting } } = useForm({
    resolver: zodResolver(schema),
    defaultValues: {
      trip_id: '', trip_pattern_id: null, service_id: null, start_time: '06:00:00', is_active: true,
    },
  });

  useEffect(() => {
    if (open) {
      reset(
        trip
          ? {
              trip_id: trip.trip_id || '',
              trip_pattern_id: trip.trip_pattern_id ?? null,
              service_id: trip.service_id ?? null,
              start_time: trip.start_time || '06:00:00',
              is_active: trip.is_active ?? true,
            }
          : {
              trip_id: '', trip_pattern_id: null, service_id: null, start_time: '06:00:00', is_active: true,
            }
      );
    }
  }, [open, trip, reset]);

  const isActive = watch('is_active');

  const onSubmit = async (values) => {
    const payload = {
      ...values,
      trip_pattern_id: values.trip_pattern_id || null,
      service_id: values.service_id || null,
    };
    if (isEdit) await updateMut.mutateAsync({ id: trip.id, payload });
    else await createMut.mutateAsync(payload);
    onOpenChange(false);
  };

  return (
    <Dialog open={open} onOpenChange={onOpenChange}>
      <DialogContent className="max-w-lg">
        <DialogHeader>
          <DialogTitle>{isEdit ? `Sửa chuyến #${trip.id}` : 'Thêm chuyến xe'}</DialogTitle>
        </DialogHeader>

        <form onSubmit={handleSubmit(onSubmit)} className="px-5 py-4 space-y-3">
          <div className="space-y-1">
            <Label>Mã chuyến *</Label>
            <Input {...register('trip_id')} placeholder="VD: T_19_GO_01" disabled={isEdit} />
            {errors.trip_id && <p className="text-[11px] text-[#c0392b]">{errors.trip_id.message}</p>}
          </div>

          <div className="grid grid-cols-2 gap-3">
            <div className="space-y-1">
              <Label>Pattern ID</Label>
              <Input type="number" {...register('trip_pattern_id')} placeholder="—" />
            </div>
            <div className="space-y-1">
              <Label>Service ID</Label>
              <Input type="number" {...register('service_id')} placeholder="—" />
            </div>
          </div>

          <div className="space-y-1">
            <Label>Giờ xuất bến * (HH:MM:SS)</Label>
            <Input {...register('start_time')} placeholder="06:00:00" />
            {errors.start_time && <p className="text-[11px] text-[#c0392b]">{errors.start_time.message}</p>}
          </div>

          <div className="flex items-center justify-between py-1">
            <Label>Đang hoạt động</Label>
            <Switch checked={isActive} onCheckedChange={(v) => setValue('is_active', v)} />
          </div>

          <DialogFooter className="-mx-5 -mb-4">
            <Button type="button" variant="secondary" onClick={() => onOpenChange(false)} disabled={isSubmitting}>Hủy</Button>
            <Button type="submit" variant="primary" disabled={isSubmitting}>
              {isSubmitting ? 'Đang lưu...' : isEdit ? 'Lưu' : 'Tạo mới'}
            </Button>
          </DialogFooter>
        </form>
      </DialogContent>
    </Dialog>
  );
}
</file>

<file path="frontend/src/admin/components/trips/TripsTable.jsx">
// src/admin/components/trips/TripsTable.jsx
// Bảng danh sách chuyến — layout dispatch center
// Cột: Mã chuyến | Tuyến | Hướng | Giờ xuất bến | Lịch | Trạng thái | Thao tác
import { Pencil, Power, PowerOff } from "lucide-react";
import { Badge } from "@/components/ui/badge";
import { DataTable } from "@/components/ui/data-table";
import { useChangeTripStatus } from "@/hooks/useTrips";

// ═══════════════════════════════════════════════════════════════
// Helpers
// ═══════════════════════════════════════════════════════════════
function fmtTime(t) {
  if (!t) return "—";
  return String(t).slice(0, 5);
}

function fmtDate(s) {
  if (!s) return "—";
  try {
    return new Date(s).toLocaleDateString("vi-VN", {
      day: "2-digit",
      month: "2-digit",
      year: "numeric",
    });
  } catch {
    return "—";
  }
}

// ─── Badge ngày chạy trong tuần ───
function ServiceDaysBadges({ days }) {
  if (!days) return null;
  const labels = ["T2", "T3", "T4", "T5", "T6", "T7", "CN"];
  const keys = [
    "monday",
    "tuesday",
    "wednesday",
    "thursday",
    "friday",
    "saturday",
    "sunday",
  ];

  return (
    <div className="flex gap-0.5">
      {keys.map((k, i) => (
        <span
          key={k}
          className={`text-[9px] w-4 h-4 rounded flex items-center justify-center font-bold ${
            days[k] ? "bg-[#169BA2] text-white" : "bg-[#F0F3F7] text-[#B0BCCA]"
          }`}
        >
          {labels[i]}
        </span>
      ))}
    </div>
  );
}

// ═══════════════════════════════════════════════════════════════
// MAIN COMPONENT
// ═══════════════════════════════════════════════════════════════
export function TripsTable({
  trips,
  isLoading,
  onEdit,
  onSelect,
  sortBy,
  sortOrder,
  onSort,
}) {
  const statusMut = useChangeTripStatus();

  const columns = [
    // ─── 1. Mã chuyến ───
    {
      key: "trip_id",
      label: "Mã chuyến",
      sortable: true,
      width: 160,
      render: (r) => (
        <button
          type="button"
          onClick={(e) => {
            e.stopPropagation();
            onSelect?.(r);
          }}
          className="font-mono text-[11px] font-semibold text-[#169BA2] hover:underline cursor-pointer text-left truncate max-w-[150px]"
          title={r.trip_id}
        >
          {r.trip_id}
        </button>
      ),
    },

    // ─── 2. Tuyến ───
    {
      key: "route_short_name",
      label: "Tuyến",
      sortable: true,
      width: 140,
      render: (r) => (
        <div className="flex items-center gap-2 min-w-0">
          <span
            className="w-1 h-5 rounded-full flex-shrink-0"
            style={{ background: r.route_color || "#169BA2" }}
          />
          <div className="min-w-0">
            <div className="text-xs font-semibold text-[#1A2332] truncate">
              {r.route_short_name || "—"}
            </div>
            <div className="text-[9px] text-[#8A9AAA] font-mono">
              {r.route_code || "—"}
            </div>
          </div>
        </div>
      ),
    },

    // ─── 3. Hướng (biển hiệu) ───
    {
      key: "trip_headsign",
      label: "Hướng đi",
      render: (r) => (
        <div className="min-w-0 max-w-[240px]">
          <div
            className="text-[11px] text-[#4A5A7A] truncate"
            title={r.trip_headsign}
          >
            {r.trip_headsign || "—"}
          </div>
          {r.direction_id != null && (
            <div className="text-[9px] text-[#8A9AAA] mt-0.5">
              {r.direction_id === 0 ? "Chiều đi" : "Chiều về"}
            </div>
          )}
        </div>
      ),
    },

    // ─── 4. Giờ xuất bến ───
    {
      key: "start_time",
      label: "Xuất bến",
      sortable: true,
      width: 100,
      align: "center",
      render: (r) => (
        <span className="font-mono text-sm font-bold text-[#1A2332]">
          {fmtTime(r.start_time)}
        </span>
      ),
    },

    // ─── 5. Lịch áp dụng ───
    {
      key: "service_code",
      label: "Lịch áp dụng",
      width: 160,
      render: (r) => (
        <div className="space-y-1">
          <div className="text-[11px] font-semibold text-[#1A2332]">
            {r.service_code || "—"}
          </div>
          {r.service_days && <ServiceDaysBadges days={r.service_days} />}
        </div>
      ),
    },

    // ─── 6. Pattern code ───
    {
      key: "pattern_code",
      label: "Pattern",
      width: 120,
      render: (r) => (
        <span className="font-mono text-[10px] text-[#8A9AAA] truncate block">
          {r.pattern_code || "—"}
        </span>
      ),
    },

    // ─── 7. Ngày tạo ───
    {
      key: "created_at",
      label: "Ngày tạo",
      sortable: true,
      width: 100,
      render: (r) => (
        <span className="text-[10px] text-[#8A9AAA] font-mono">
          {fmtDate(r.created_at)}
        </span>
      ),
    },

    // ─── 8. Trạng thái ───
    {
      key: "is_active",
      label: "Trạng thái",
      align: "center",
      width: 120,
      render: (r) =>
        r.is_active !== false ? (
          <Badge variant="success">Hoạt động</Badge>
        ) : (
          <Badge variant="danger">Đã hủy</Badge>
        ),
    },

    // ─── 9. Thao tác ───
    {
      key: "actions",
      label: "Thao tác",
      align: "center",
      width: 100,
      render: (r) => (
        <div className="flex items-center justify-center gap-1">
          <button
            type="button"
            onClick={(e) => {
              e.stopPropagation();
              onEdit?.(r);
            }}
            title="Sửa chuyến"
            className="h-7 w-7 rounded-md border border-[#D0D7E2] bg-white hover:bg-[#F8FAFC] hover:border-[#169BA2] flex items-center justify-center cursor-pointer transition-colors"
          >
            <Pencil size={12} className="text-[#169BA2]" />
          </button>

          <button
            type="button"
            onClick={(e) => {
              e.stopPropagation();
              statusMut.mutate({
                id: r.id,
                is_active: !(r.is_active !== false),
              });
            }}
            disabled={statusMut.isPending}
            title={r.is_active !== false ? "Hủy chuyến" : "Kích hoạt"}
            className={`h-7 w-7 rounded-md border flex items-center justify-center cursor-pointer transition-colors disabled:opacity-50 ${
              r.is_active !== false
                ? "border-[#F5B7B1] bg-white hover:bg-[#FEF2F2]"
                : "border-[#A8D5A8] bg-white hover:bg-[#F1F8F1]"
            }`}
          >
            {r.is_active !== false ? (
              <PowerOff size={12} className="text-[#C62828]" />
            ) : (
              <Power size={12} className="text-[#2E7D32]" />
            )}
          </button>
        </div>
      ),
    },
  ];

  return (
    <DataTable
      columns={columns}
      rows={trips}
      isLoading={isLoading}
      emptyMessage="Chưa có chuyến nào"
      sortBy={sortBy}
      sortOrder={sortOrder}
      onSort={onSort}
      onRowClick={onSelect}
    />
  );
}
</file>

