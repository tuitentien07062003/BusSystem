            <div className="grid grid-cols-2 md:grid-cols-4 gap-3">
              <StatBox label="Tổng chuyến" value={stats.trip_count.total} />
              <StatBox label="Chiều đi" value={stats.trip_count.go} accent />
              <StatBox
                label="Chiều về"
                value={stats.trip_count.return}
