const R = 6371000;

export function haversine(lat1, lng1, lat2, lng2) {
  const toRad = (d) => (d * Math.PI) / 180;
  const dLat = toRad(lat2 - lat1);
  const dLng = toRad(lng2 - lng1);
  const a =
    Math.sin(dLat / 2) ** 2 +
    Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLng / 2) ** 2;
  return 2 * R * Math.asin(Math.sqrt(a));
}

export function cumulativeDistances(points) {
  const dists = [0];
  for (let i = 1; i < points.length; i++) {
    dists.push(
      dists[i - 1] +
        haversine(
          points[i - 1].latitude, points[i - 1].longitude,
          points[i].latitude, points[i].longitude
        )
    );
  }
  return dists;
}

export function cumulativeDistancesCoords(coords) {
  if (!coords?.length) return [];
  const dists = [0];
  for (let i = 1; i < coords.length; i++) {
    dists.push(
      dists[i - 1] +
        haversine(coords[i - 1][1], coords[i - 1][0], coords[i][1], coords[i][0])
    );
  }
  return dists;
}

export function findNearestOnLine(coords, cumDists, lat, lng) {
  if (!coords?.length) return { index: 0, distance_along_m: 0, distance_to_line_m: 0 };

  let bestIdx = 0;
  let bestDistSq = Infinity;
  for (let i = 0; i < coords.length; i++) {
    const dx = coords[i][0] - lng;
    const dy = coords[i][1] - lat;
    const dSq = dx * dx + dy * dy;
    if (dSq < bestDistSq) {
      bestDistSq = dSq;
      bestIdx = i;
    }
  }

  let bestDistAlong = cumDists[bestIdx];
  let bestDistToLine = haversine(lat, lng, coords[bestIdx][1], coords[bestIdx][0]);

  const segIdxCandidates = [bestIdx - 1, bestIdx].filter(
    (i) => i >= 0 && i < coords.length - 1
  );
  for (const si of segIdxCandidates) {
    const p0 = coords[si];
    const p1 = coords[si + 1];
    const dx = p1[0] - p0[0];
    const dy = p1[1] - p0[1];
    const lenSq = dx * dx + dy * dy;
    if (lenSq === 0) continue;
    let t = ((lng - p0[0]) * dx + (lat - p0[1]) * dy) / lenSq;
    t = Math.max(0, Math.min(1, t));
    const projLng = p0[0] + t * dx;
    const projLat = p0[1] + t * dy;
    const distToLine = haversine(lat, lng, projLat, projLng);
    if (distToLine < bestDistToLine) {
      bestDistToLine = distToLine;
      const segLen = cumDists[si + 1] - cumDists[si];
      bestDistAlong = cumDists[si] + segLen * t;
    }
  }

  return {
    index: bestIdx,
    distance_along_m: bestDistAlong,
    distance_to_line_m: bestDistToLine,
  };
}

export function buildLineString(points) {
  return {
    type: "LineString",
    coordinates: points.map((p) => [Number(p.longitude), Number(p.latitude)]),
  };
}
</file>

<file path="RouteService/src/utils/routingUtils.js">
const DEFAULT_OSRM = "https://router.project-osrm.org";

const routeCache = new Map();
const CACHE_TTL_MS = 10 * 60 * 1000;
const CACHE_MAX = 200;

function makeCacheKey(points) {
  return points
    .map((p) => `${Number(p.latitude).toFixed(6)},${Number(p.longitude).toFixed(6)}`)
    .join("|");
}

function getCached(key) {
  const item = routeCache.get(key);
  if (!item) return null;
  if (Date.now() - item.ts > CACHE_TTL_MS) {
    routeCache.delete(key);
    return null;
  }
  return item.data;
}

function setCache(key, data) {
  if (routeCache.size >= CACHE_MAX) {
    const firstKey = routeCache.keys().next().value;
    routeCache.delete(firstKey);
  }
  routeCache.set(key, { data, ts: Date.now() });
}

export async function fetchRouteGeometry(points, options = {}) {
  if (!points || points.length < 2) {
    throw new Error("Cần ít nhất 2 điểm để tính tuyến.");
  }

  const cacheKey = makeCacheKey(points);
  const cached = getCached(cacheKey);
  if (cached) return { ...cached, from_cache: true };

  const baseUrl = options.baseUrl || process.env.OSRM_BASE_URL || DEFAULT_OSRM;
  const timeoutMs = options.timeoutMs || 15000;

  const coordsParam = points
    .map((p) => `${Number(p.longitude)},${Number(p.latitude)}`)
    .join(";");

  const url =
    `${baseUrl}/route/v1/driving/${coordsParam}` +
    `?geometries=geojson&overview=full&steps=false&annotations=false`;

  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), timeoutMs);

  try {
    const res = await fetch(url, { signal: controller.signal });
    if (!res.ok) throw new Error(`OSRM HTTP ${res.status}`);
    const data = await res.json();

    if (data.code !== "Ok" || !data.routes?.length) {
      throw new Error(`OSRM trả về lỗi: ${data.code || "no route"}`);
    }

    const route = data.routes[0];
    const result = {
      geometry: route.geometry,
      distance_m: route.distance,
      duration_sec: route.duration,
    };
    setCache(cacheKey, result);
    return { ...result, from_cache: false };
  } finally {
    clearTimeout(timer);
  }
}

export function getCacheStats() {
  return { size: routeCache.size, max: CACHE_MAX };
}
</file>

<file path="RouteService/src/server.js">
import express from "express";
import cors from "cors";
import dotenv from "dotenv";
import sequelize from "./config/database.js";
import "./models/associations.js";
import routes from "./routes/index.js";

dotenv.config();

const app = express();

app.use(cors());
app.use(express.json());
app.use(express.urlencoded({ extended: true }));

app.get("/", (req, res) => {
  res.json({ status: "ok", service: "RouteService Backend" });
});

app.use("/tbus", routes);

app.use((req, res) => {
  res.status(404).json({ error: "Endpoint không tồn tại." });
});

app.use((err, req, res, next) => {
  console.error("[Server Error]", err);
  res.status(err.status || 500).json({ error: err.message || "Lỗi server." });
});

const PORT = process.env.PORT || 3000;

async function start() {
  try {
    await sequelize.authenticate();
    console.log("[DB] Kết nối PostgreSQL thành công.");

    app.listen(PORT, () => {
      console.log(`[Server] Đang chạy tại http://localhost:${PORT}`);
    });
  } catch (err) {
    console.error("[DB] Không kết nối được database:", err.message);
    process.exit(1);
  }
}

start();
</file>

