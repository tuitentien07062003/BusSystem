<file path="src/admin/pages/EmployeesAdminPage.jsx">
import { useState, useEffect, useMemo, useCallback } from "react";
import { Plus, Users } from "lucide-react";
import { Button } from "@/components/ui/button";
import { PageHeader } from "../components/PageHeader";
import { EmployeeFilterBar } from "../components/employees/EmployeeFilterBar";
import { EmployeesTable } from "../components/employees/EmployeesTable";
import { EmployeeCard } from "../components/employees/EmployeeCard";
import { EmployeeDetailDrawer } from "../components/employees/EmployeeDetailDrawer";
import { EmployeeFormDialog } from "../components/employees/EmployeeFormDialog";
import { useEmployeesList } from "@/hooks/useEmployees";

const PAGE_SIZE = 24;
const NUMERIC_COLS = new Set(["id"]);

function compareRows(a, b, col, order) {
  const av = a[col];
  const bv = b[col];
  if (av == null) return 1;
  if (bv == null) return -1;
  if (NUMERIC_COLS.has(col)) {
    return order === "asc" ? Number(av) - Number(bv) : Number(bv) - Number(av);
  }
  const as = String(av).toLowerCase();
  const bs = String(bv).toLowerCase();
  return order === "asc"
    ? as.localeCompare(bs, "vi")
    : bs.localeCompare(as, "vi");
}

export function EmployeesAdminPage() {
  const [page, setPage] = useState(1);
  const [searchInput, setSearchInput] = useState("");
  const [keyword, setKeyword] = useState("");
  const [typeFilter, setTypeFilter] = useState("all");
  const [statusFilter, setStatusFilter] = useState("all");
  const [viewMode, setViewMode] = useState("grid");
  const [sortBy, setSortBy] = useState("id");
  const [sortOrder, setSortOrder] = useState("asc");

  const [editing, setEditing] = useState(null);
  const [formOpen, setFormOpen] = useState(false);
  const [viewing, setViewing] = useState(null);

  // Debounce
  useEffect(() => {
    const t = setTimeout(() => {
      setKeyword(searchInput);
      setPage(1);
    }, 300);
    return () => clearTimeout(t);
  }, [searchInput]);

  useEffect(() => {
    setPage(1);
  }, [typeFilter, statusFilter]);

  const typeParam = typeFilter === "all" ? undefined : typeFilter;
  const isActiveParam =
    statusFilter === "all" ? undefined : statusFilter === "true";

  const { data, isLoading, isFetching, refetch } = useEmployeesList({
    page,
    limit: PAGE_SIZE,
    type: typeParam,
    is_active: isActiveParam,
    q: keyword,
  });

  const raw = data?.data ?? [];
  const total = data?.total ?? 0;
  const totalPages = data?.totalPages ?? 1;

  const employees = useMemo(() => {
    const list = [...raw];
    list.sort((a, b) => compareRows(a, b, sortBy, sortOrder));
    return list;
  }, [raw, sortBy, sortOrder]);

  const handleSort = useCallback(
    (field) => {
      if (sortBy === field) setSortOrder((o) => (o === "asc" ? "desc" : "asc"));
      else {
        setSortBy(field);
        setSortOrder("asc");
      }
    },
    [sortBy],
  );

  const handleOpenCreate = () => {
    setEditing(null);
    setFormOpen(true);
  };

  const handleOpenEdit = (row) => {
    setEditing(row);
    setFormOpen(true);
  };

  const handleView = (row) => setViewing(row);

  return (
    <div className="h-full overflow-y-auto bg-[#EEF2F6]">
      <div className="max-w-[1400px] mx-auto px-6 py-6 space-y-4">
        {/* Header */}
        <PageHeader
          title="Quản lý nhân viên"
          description="Tài xế, lơ xe, nhân viên depot và điều độ viên"
        >
          <Button variant="primary" onClick={handleOpenCreate}>
            <Plus size={14} />
            Thêm nhân viên
          </Button>
        </PageHeader>

        {/* Filter */}
        <EmployeeFilterBar
          searchInput={searchInput}
          typeFilter={typeFilter}
          statusFilter={statusFilter}
          viewMode={viewMode}
          onSearchChange={setSearchInput}
          onTypeChange={setTypeFilter}
          onStatusChange={setStatusFilter}
          onViewModeChange={setViewMode}
          onRefresh={refetch}
          isFetching={isFetching}
        />

        {/* Content */}
        {isLoading ? (
          <div className="bg-white rounded-xl border border-[#E5EAF0] py-16 flex flex-col items-center justify-center">
            <div className="animate-spin rounded-full h-8 w-8 border-2 border-[#169BA2] border-t-transparent mb-3" />
            <p className="text-xs text-[#8A9AAA]">Đang tải nhân viên...</p>
          </div>
        ) : employees.length === 0 ? (
          <div className="bg-white rounded-xl border border-dashed border-[#D0D7E2] py-16 px-6 flex flex-col items-center text-center">
            <div className="w-16 h-16 rounded-full bg-[#F8FAFC] flex items-center justify-center mb-4">
              <Users size={26} className="text-[#B0BCCA]" />
            </div>
            <h3 className="text-sm font-bold text-[#1A2332] mb-1">
              Không có nhân viên nào
            </h3>
            <p className="text-xs text-[#8A9AAA] max-w-sm">
              {keyword || typeFilter !== "all" || statusFilter !== "all"
                ? "Không khớp với bộ lọc hiện tại. Thử đổi từ khóa hoặc bỏ lọc."
                : "Danh sách sẽ hiển thị khi bạn thêm nhân viên đầu tiên."}
            </p>
          </div>
        ) : viewMode === "grid" ? (
          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3">
            {employees.map((e) => (
              <EmployeeCard
                key={e.id}
                employee={e}
                onView={handleView}
                onEdit={handleOpenEdit}
              />
            ))}
          </div>
        ) : (
          <EmployeesTable
            employees={employees}
            isLoading={false}
            onEdit={handleOpenEdit}
            sortBy={sortBy}
            sortOrder={sortOrder}
            onSort={handleSort}
          />
        )}

        {/* Pagination */}
        {totalPages > 1 && (
          <div className="flex items-center justify-between text-xs text-[#6A7A9A]">
            <span>
              Trang <b className="text-[#1A2332]">{page}</b> / {totalPages} ·
              Tổng{" "}
              <b className="text-[#1A2332]">{total.toLocaleString("vi-VN")}</b>{" "}
              nhân viên
            </span>
            <div className="flex gap-2">
              <button
                onClick={() => setPage((p) => p - 1)}
                disabled={page <= 1}
                className="h-8 px-3 rounded-md border border-[#CBD5E1] bg-white text-xs font-semibold disabled:opacity-40 cursor-pointer"
              >
                Trước
              </button>
              <button
                onClick={() => setPage((p) => p + 1)}
                disabled={page >= totalPages}
                className="h-8 px-3 rounded-md border border-[#CBD5E1] bg-white text-xs font-semibold disabled:opacity-40 cursor-pointer"
              >
                Sau
              </button>
            </div>
          </div>
        )}
      </div>

      {/* Drawer chi tiết */}
      <EmployeeDetailDrawer
        employee={viewing}
        open={!!viewing}
        onClose={() => setViewing(null)}
      />

      {/* Dialog tạo/sửa */}
      <EmployeeFormDialog
        employee={editing}
        open={formOpen}
        onOpenChange={(v) => {
          setFormOpen(v);
          if (!v) setEditing(null);
        }}
      />
    </div>
  );
}
</file>

<file path="src/admin/pages/FeedbackAdminPage.jsx">
import { useState, useEffect, useCallback } from "react";
import {
  MessageSquare,
  Loader2,
  CheckCircle2,
  Eye,
  Clock,
  X,
} from "lucide-react";
import { PageHeader } from "../components/PageHeader";
import { toast } from "sonner";
import axios from "axios";
import { format } from "date-fns";

export function FeedbackAdminPage() {
  const [tab, setTab] = useState("new");
  const [data, setData] = useState([]);
  const [isLoading, setIsLoading] = useState(true);
  const [selected, setSelected] = useState(null);
  const [viewImage, setViewImage] = useState(null);
  const [note, setNote] = useState("");
  const [isProcessing, setIsProcessing] = useState(false);

  const fetchData = useCallback(() => {
    setIsLoading(true);
    const token = localStorage.getItem("admin_access_token");
    axios
      .get("/passenger-api/admin/feedbacks", {
        params: { status: tab },
        headers: { Authorization: `Bearer ${token}` },
      })
      .then((res) => {
        const list = res.data?.data ?? res.data?.feedbacks ?? res.data ?? [];
        const normalized = (Array.isArray(list) ? list : []).map((fb) => ({
          ...fb,
          content: fb.content ?? fb.message ?? fb.feedback_content ?? "",
          images: Array.isArray(fb.images)
            ? fb.images
            : typeof fb.images === "string"
              ? (() => {
                  try {
                    return JSON.parse(fb.images);
                  } catch {
                    return [];
                  }
                })()
              : [],
        }));
        setData(normalized);
      })
      .catch(console.error)
      .finally(() => setIsLoading(false));
  }, [tab]);

  useEffect(() => {
    fetchData();
  }, [fetchData]);

  const handleUpdateStatus = async (id, status) => {
    setIsProcessing(true);
    try {
      const token = localStorage.getItem("admin_access_token");
      await axios.patch(
        `/passenger-api/admin/feedbacks/${id}`,
        { status, admin_note: note || null },
        { headers: { Authorization: `Bearer ${token}` } },
      );
      toast.success("Đã cập nhật");
      setSelected(null);
      setNote("");
      fetchData();
    } catch (err) {
      toast.error("Cập nhật thất bại");
    } finally {
      setIsProcessing(false);
    }
  };

  const TABS = [
    { id: "new", label: "Mới" },
    { id: "reviewed", label: "Đã xem" },
    { id: "resolved", label: "Đã xử lý" },
  ];

  return (
    <div className="h-full overflow-y-auto bg-[#EEF2F6]">
      <div className="max-w-[1400px] mx-auto px-6 py-6 space-y-4">
        <PageHeader
          title="Góp ý & Phản hồi"
          description="Xem và xử lý góp ý từ hành khách"
        />

        <div className="bg-white rounded-xl border border-[#E5EAF0]">
          <div className="p-4 border-b border-[#E5EAF0]">
            <div className="inline-flex bg-[#F8FAFC] p-1 rounded-lg border border-[#E5EAF0]">
              {TABS.map((t) => (
                <button
                  key={t.id}
                  onClick={() => setTab(t.id)}
                  className={`px-4 py-1.5 text-sm font-semibold rounded-md transition-colors ${
                    tab === t.id
                      ? "bg-white text-[#169BA2] shadow-sm"
                      : "text-[#6A7A9A] hover:text-[#1A2332]"
                  }`}
                >
                  {t.label}
                </button>
              ))}
            </div>
          </div>

          <div className="divide-y divide-[#F0F3F7]">
            {isLoading ? (
              <div className="py-16 text-center">
                <Loader2
                  size={24}
                  className="animate-spin text-[#169BA2] mx-auto"
                />
              </div>
            ) : data.length === 0 ? (
              <div className="py-16 text-center text-[#8A9AAA]">
                <MessageSquare
                  size={32}
                  className="mx-auto mb-2 text-[#B0BCCA]"
                />
                Không có góp ý nào.
              </div>
            ) : (
              data.map((fb) => (
                <div
                  key={fb.id}
                  onClick={() => setSelected(fb)}
                  className="p-4 hover:bg-[#F8FAFC] cursor-pointer transition-colors"
                >
                  <div className="flex items-start justify-between gap-3 mb-2">
                    <div>
                      <div className="text-sm font-bold text-[#1A2332]">
                        {fb.full_name}
                      </div>
                      <div className="text-xs text-[#8A9AAA] mt-0.5">
                        {fb.email || fb.phone || "Không có liên hệ"}
                        {fb.route_id && ` · Tuyến #${fb.route_id}`}
                      </div>
                    </div>
                    <div className="text-xs text-[#8A9AAA] whitespace-nowrap">
                      {format(new Date(fb.created_at), "dd/MM/yyyy HH:mm")}
                    </div>
                  </div>
                  <div className="text-sm text-[#4A5A7A] line-clamp-2">
                    {fb.content || fb.comment || "(Không có nội dung)"}
                  </div>
                  {fb.images?.length > 0 && (
                    <div className="mt-2 text-[10px] text-[#8A9AAA]">
                      📎 {fb.images.length} ảnh đính kèm
                    </div>
                  )}
                </div>
              ))
            )}
          </div>
        </div>
      </div>

      {selected && (
        <div className="fixed inset-0 z-50 flex justify-end bg-black/50">
          <div className="bg-white w-full max-w-[500px] h-full flex flex-col animate-in slide-in-from-right">
            <div className="p-4 border-b border-[#E5EAF0] flex items-center justify-between">
              <h2 className="text-base font-bold text-[#1A2332]">
                Chi tiết góp ý
              </h2>
              <button
                onClick={() => {
                  setSelected(null);
                  setNote("");
                }}
                className="p-1 rounded-full hover:bg-[#F0F3F7]"
              >
                <X size={20} className="text-[#4A5A7A]" />
              </button>
            </div>
            <div className="flex-1 overflow-y-auto p-5 space-y-4">
              <div>
                <div className="text-xs text-[#8A9AAA] mb-1">Người gửi</div>
                <div className="text-sm font-bold text-[#1A2332]">
                  {selected.full_name}
                </div>
                <div className="text-xs text-[#4A5A7A] mt-1">
                  {selected.email} {selected.phone && `· ${selected.phone}`}
                </div>
              </div>
              <div>
                <div className="text-xs text-[#8A9AAA] mb-1">Nội dung</div>
                <div className="text-sm text-[#1A2332] leading-relaxed bg-[#F8FAFC] p-3 rounded-xl">
                  {selected.content ||
                    selected.comment ||
                    "(Không có nội dung)"}
                </div>
              </div>
              {selected.images?.length > 0 && (
                <div>
                  <div className="text-xs text-[#8A9AAA] mb-2">
                    Ảnh đính kèm
                  </div>
                  <div className="grid grid-cols-3 gap-2">
                    {selected.images.map((img, i) => (
                      <img
                        key={i}
                        src={img}
                        alt=""
                        onClick={() => setViewImage(img)}
                        className="aspect-square object-cover rounded-lg cursor-pointer border border-[#E5EAF0]"
                      />
                    ))}
                  </div>
                </div>
              )}
              <div>
                <div className="text-xs text-[#8A9AAA] mb-1">Ghi chú xử lý</div>
                <textarea
                  value={note}
                  onChange={(e) => setNote(e.target.value)}
                  rows={3}
                  className="w-full p-3 rounded-xl border border-[#D0D7E2] text-sm outline-none focus:border-[#169BA2] resize-none"
                  placeholder="Ghi chú nội bộ..."
                />
              </div>
            </div>
            <div className="p-4 border-t border-[#E5EAF0] flex gap-2">
              <button
                onClick={() => handleUpdateStatus(selected.id, "reviewed")}
                disabled={isProcessing}
                className="flex-1 h-10 rounded-lg bg-[#FEF3E2] text-[#B45309] font-bold text-sm disabled:opacity-50"
              >
                Đã xem
              </button>
              <button
                onClick={() => handleUpdateStatus(selected.id, "resolved")}
                disabled={isProcessing}
                className="flex-1 h-10 rounded-lg bg-[#F1F8F1] text-[#2E7D32] font-bold text-sm disabled:opacity-50"
              >
                Đã xử lý
              </button>
            </div>
          </div>
        </div>
      )}

      {viewImage && (
        <div
          className="fixed inset-0 z-[60] flex items-center justify-center p-4 bg-black/70"
          onClick={() => setViewImage(null)}
        >
          <img
            src={viewImage}
            alt=""
            className="max-h-[80vh] max-w-full object-contain rounded-lg"
          />
        </div>
      )}
    </div>
  );
}
</file>

<file path="src/admin/pages/OrganizationPage.jsx">
import { useForm } from "react-hook-form";
import { useEffect, useState } from "react";
import {
  Building2,
  Globe,
  Clock,
  CheckCircle2,
  Shield,
  Bus,
  Route as RouteIcon,
  MapPin,
  CalendarDays,
  Edit3,
  Save,
  X,
  Loader2,
  Phone,
  Mail,
  MapPinned,
} from "lucide-react";
import { useAgenciesList, useUpdateAgency } from "@/hooks/useAgencies";
import { useRoutesList } from "@/hooks/useRoutes";
import { useStopsList } from "@/hooks/useStops";
import { useCalendarsList } from "@/hooks/useServiceCalendars";
import { useTripsList } from "@/hooks/useTrips";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Badge } from "@/components/ui/badge";
import { toast } from "sonner";

// ═══════════════════════════════════════════════════════════════
// Stat card nhỏ
// ═══════════════════════════════════════════════════════════════
function StatTile({ icon: Icon, label, value, loading }) {
  return (
    <div className="bg-white rounded-xl border border-[#E5EAF0] p-4 flex items-center gap-3">
      <div className="w-11 h-11 rounded-lg bg-[#E6F4F5] flex items-center justify-center flex-shrink-0">
        <Icon size={18} className="text-[#169BA2]" />
      </div>
      <div className="min-w-0">
        <div className="text-[10px] font-semibold uppercase tracking-wider text-[#8A9AAA]">
          {label}
        </div>
        <div className="text-xl font-bold text-[#1A2332] leading-tight">
          {loading ? "—" : (value ?? 0).toLocaleString("vi-VN")}
        </div>
      </div>
    </div>
  );
}

// ═══════════════════════════════════════════════════════════════
// Field (readonly hoặc editable)
// ═══════════════════════════════════════════════════════════════
function Field({ icon: Icon, label, value, editing, register, name, errors }) {
  return (
    <div className="space-y-1.5">
      <div className="flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-[#8A9AAA]">
        <Icon size={12} />
        {label}
      </div>
      {editing ? (
        <Input {...register(name)} placeholder={value || ""} />
      ) : (
        <div className="text-sm text-[#1A2332] font-medium py-2 border-b border-[#E5EAF0]">
          {value || <span className="text-[#B0BCCA]">— Chưa có —</span>}
        </div>
      )}
    </div>
  );
}

// ═══════════════════════════════════════════════════════════════
// MAIN PAGE
// ═══════════════════════════════════════════════════════════════
export function OrganizationPage() {
  const [editing, setEditing] = useState(false);

  // Load dữ liệu
  const { data: agenciesData, isLoading: loadingAgency } = useAgenciesList({
    page: 1,
    limit: 1,
  });
  const agency = agenciesData?.data?.[0];

  // Load stats
  const { data: routesData, isLoading: loadingRoutes } = useRoutesList({
    page: 1,
    limit: 1,
  });
  const { data: stopsData, isLoading: loadingStops } = useStopsList({
    page: 1,
    limit: 1,
  });
  const { data: calendarsData, isLoading: loadingCalendars } = useCalendarsList(
    { page: 1, limit: 1 },
  );
  const { data: tripsData, isLoading: loadingTrips } = useTripsList({
    page: 1,
    limit: 1,
  });

  const updateMut = useUpdateAgency();
  const {
    register,
    handleSubmit,
    reset,
    formState: { errors, isSubmitting },
  } = useForm({
    defaultValues: {
      agency_name: "",
      agency_url: "",
      agency_timezone: "",
    },
  });

  // Load data vào form khi có agency
  useEffect(() => {
    if (agency) {
      reset({
        agency_name: agency.agency_name || "",
        agency_url: agency.agency_url || "",
        agency_timezone: agency.agency_timezone || "",
      });
    }
  }, [agency, reset]);

  const onSubmit = async (values) => {
    if (!agency) return;
    await updateMut.mutateAsync({ id: agency.id, payload: values });
    setEditing(false);
  };

  const handleCancel = () => {
    if (agency) {
      reset({
        agency_name: agency.agency_name || "",
        agency_url: agency.agency_url || "",
        agency_timezone: agency.agency_timezone || "",
      });
    }
    setEditing(false);
  };

  if (loadingAgency) {
    return (
      <div className="h-full flex items-center justify-center">
        <Loader2 size={24} className="animate-spin text-[#169BA2]" />
      </div>
    );
  }

  if (!agency) {
    return (
      <div className="h-full flex items-center justify-center p-6">
        <div className="text-center max-w-md">
          <div className="w-16 h-16 rounded-full bg-[#E6F4F5] flex items-center justify-center mx-auto mb-4">
            <Building2 size={26} className="text-[#169BA2]" />
          </div>
          <h2 className="text-lg font-bold text-[#1A2332] mb-2">
            Chưa có thông tin tổ chức
          </h2>
          <p className="text-sm text-[#6A7A9A]">
            Vui lòng liên hệ quản trị viên hệ thống để thiết lập thông tin.
          </p>
        </div>
      </div>
    );
  }

  return (
    <div className="h-full overflow-y-auto bg-[#EEF2F6] scrollbar-thin">
      {/* ═══════════ HERO BANNER ═══════════ */}
      <div className="relative bg-white border-b border-[#E5EAF0]">
        {/* Nền nhẹ - brand color */}
        <div className="absolute inset-0 bg-[#169BA2] opacity-[0.04]" />

        <div className="relative px-8 py-8">
          <div className="max-w-[1400px] mx-auto">
            <div className="flex items-center gap-6">
              {/* Logo lớn */}
              <div className="w-32 h-32 flex-shrink-0 flex items-center justify-center">
                <img
                  src="/logo/tbus-logo.webp"
                  alt="TBus"
                  className="w-full h-full object-contain drop-shadow-sm"
                />
              </div>

              {/* Info */}
              <div className="min-w-0 flex-1">
                <div className="flex items-center gap-3 mb-2">
                  <h1 className="text-2xl font-bold text-[#1A2332] tracking-tight">
                    {agency.agency_name}
                  </h1>
                  {agency.is_active ? (
                    <Badge variant="success">
                      <CheckCircle2 size={11} />
                      Đang hoạt động
                    </Badge>
                  ) : (
                    <Badge variant="danger">
                      <X size={11} />
                      Ngừng hoạt động
                    </Badge>
                  )}
                </div>

                <div className="text-sm text-[#6A7A9A] leading-relaxed max-w-2xl">
                  Đơn vị vận hành hệ thống xe buýt nội thành — quản lý tuyến,
                  trạm dừng, lịch chạy và điều hành vận tải hành khách công
                  cộng.
                </div>

                <div className="flex items-center gap-4 mt-3 text-xs text-[#8A9AAA]">
                  <span className="inline-flex items-center gap-1.5">
                    <Shield size={12} />
                    Mã:{" "}
                    <span className="font-mono font-semibold text-[#169BA2]">
                      {agency.agency_id}
                    </span>
                  </span>
                </div>
              </div>

              {/* Action */}
              {!editing ? (
                <Button
                  variant="outline"
                  onClick={() => setEditing(true)}
                  className="flex-shrink-0 border-[#169BA2] text-[#169BA2] hover:bg-[#E6F4F5]"
                >
                  <Edit3 size={14} />
                  Chỉnh sửa
                </Button>
              ) : (
                <div className="flex gap-2 flex-shrink-0">
                  <Button
                    variant="secondary"
                    onClick={handleCancel}
                    disabled={isSubmitting}
                  >
                    <X size={14} />
                    Hủy
                  </Button>
                  <Button
                    variant="primary"
                    onClick={handleSubmit(onSubmit)}
                    disabled={isSubmitting}
                    className="bg-[#169BA2] hover:bg-[#12868C]"
                  >
                    {isSubmitting ? (
                      <>
                        <Loader2 size={14} className="animate-spin" /> Đang
                        lưu...
                      </>
                    ) : (
                      <>
                        <Save size={14} /> Lưu thay đổi
                      </>
                    )}
                  </Button>
                </div>
              )}
            </div>
          </div>
        </div>
      </div>

      {/* ═══════════ MAIN CONTENT ═══════════ */}
      <div className="max-w-[1400px] mx-auto px-8 py-8 space-y-6">
        {/* ─── SECTION 1: Thống kê tổng quan ─── */}
        <section>
          <h2 className="text-[11px] font-bold uppercase tracking-[0.1em] text-[#8A9AAA] mb-3">
            Tổng quan hệ thống
          </h2>
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            <StatTile
              icon={RouteIcon}
              label="Tuyến đường"
              value={routesData?.total}
              loading={loadingRoutes}
            />
            <StatTile
              icon={MapPin}
              label="Trạm dừng & Depot"
              value={stopsData?.total}
              loading={loadingStops}
            />
            <StatTile
              icon={Clock}
              label="Chuyến xe"
              value={tripsData?.total}
              loading={loadingTrips}
            />
            <StatTile
              icon={CalendarDays}
              label="Lịch phục vụ"
              value={calendarsData?.total}
              loading={loadingCalendars}
            />
          </div>
        </section>

        {/* ─── SECTION 2: Thông tin tổ chức ─── */}
        <section>
          <h2 className="text-[11px] font-bold uppercase tracking-[0.1em] text-[#8A9AAA] mb-3">
            Thông tin đơn vị
          </h2>

          <div className="bg-white rounded-xl border border-[#E5EAF0] overflow-hidden">
            <div className="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6 p-6">
              <Field
                icon={Building2}
                label="Tên đơn vị"
                value={agency.agency_name}
                editing={editing}
                register={register}
                name="agency_name"
                errors={errors}
              />

              <Field
                icon={Globe}
                label="Website"
                value={agency.agency_url}
                editing={editing}
                register={register}
                name="agency_url"
                errors={errors}
              />

              <Field
                icon={Clock}
                label="Múi giờ"
                value={agency.agency_timezone}
                editing={editing}
                register={register}
                name="agency_timezone"
                errors={errors}
              />

              <div className="space-y-1.5">
                <div className="flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-[#8A9AAA]">
                  <CalendarDays size={12} />
                  Ngày tham gia
                </div>
                <div className="text-sm text-[#1A2332] font-medium py-2 border-b border-[#E5EAF0]">
                  {agency.created_at
                    ? new Date(agency.created_at).toLocaleDateString("vi-VN", {
                        day: "2-digit",
                        month: "2-digit",
                        year: "numeric",
                      })
                    : "—"}
                </div>
              </div>
            </div>
          </div>
        </section>

        {/* ─── SECTION 3: Liên hệ ─── */}
        <section>
          <h2 className="text-[11px] font-bold uppercase tracking-[0.1em] text-[#8A9AAA] mb-3">
            Liên hệ
          </h2>

          <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div className="bg-white rounded-xl border border-[#E5EAF0] p-5 flex items-start gap-3">
              <div className="w-10 h-10 rounded-lg bg-[#E6F4F5] flex items-center justify-center flex-shrink-0">
                <Phone size={16} className="text-[#169BA2]" />
              </div>
              <div className="min-w-0">
                <div className="text-[10px] font-semibold uppercase tracking-wider text-[#8A9AAA] mb-0.5">
                  Hotline
                </div>
                <div className="text-sm font-semibold text-[#1A2332]">
                  1900 6067
                </div>
                <div className="text-[11px] text-[#8A9AAA] mt-0.5">
                  Hỗ trợ 24/7
                </div>
              </div>
            </div>

            <div className="bg-white rounded-xl border border-[#E5EAF0] p-5 flex items-start gap-3">
              <div className="w-10 h-10 rounded-lg bg-[#E6F4F5] flex items-center justify-center flex-shrink-0">
                <Mail size={16} className="text-[#169BA2]" />
              </div>
              <div className="min-w-0">
                <div className="text-[10px] font-semibold uppercase tracking-wider text-[#8A9AAA] mb-0.5">
                  Email
                </div>
                <div className="text-sm font-semibold text-[#1A2332] truncate">
                  contact@tbus.vn
                </div>
                <div className="text-[11px] text-[#8A9AAA] mt-0.5">
                  Phản hồi trong 24h
                </div>
              </div>
            </div>

            <div className="bg-white rounded-xl border border-[#E5EAF0] p-5 flex items-start gap-3">
              <div className="w-10 h-10 rounded-lg bg-[#E6F4F5] flex items-center justify-center flex-shrink-0">
                <MapPinned size={16} className="text-[#169BA2]" />
              </div>
              <div className="min-w-0">
                <div className="text-[10px] font-semibold uppercase tracking-wider text-[#8A9AAA] mb-0.5">
                  Trụ sở
                </div>
                <div className="text-sm font-semibold text-[#1A2332]">
                  TP. Hồ Chí Minh
                </div>
                <div className="text-[11px] text-[#8A9AAA] mt-0.5">
                  Việt Nam
                </div>
              </div>
            </div>
          </div>
        </section>

        {/* ─── FOOTER ─── */}
        <div className="pt-4 pb-2 text-center">
          <div className="text-[11px] text-[#B0BCCA]">
            TBus Vietnam · Hệ thống quản lý vận hành · Phiên bản 1.0.0
          </div>
        </div>
      </div>
    </div>
  );
}
