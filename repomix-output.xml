              <Clock size={13} className="text-[#169BA2]" />
            </div>
            <h3 className="text-sm font-bold text-[#1A2332]">
              Thời gian hoạt động
            </h3>
          </div>

          <div className="grid grid-cols-2 gap-4">
            <Field
              label="Giờ mở tuyến"
