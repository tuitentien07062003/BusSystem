<file path="src/admin/components/routes/RouteComposerDialog.jsx">
import { useEffect, useState, useMemo, useCallback, useRef } from "react";
import {
  ArrowLeft,
  Loader2,
  Save,
  MapPin,
  Search,
  X,
  GripVertical,
  Check,
  Info,
  Ruler,
  Clock,
  ListOrdered,
  ArrowRight,
  Building2,
  AlertTriangle,
  Plus,
  Map as MapIcon,
  Route as RouteIcon,
} from "lucide-react";
import {
  useDepotsForComposer,
  useSearchStopsForComposer,
  usePreviewRoute,
  useSaveComposedRoute,
  useUpdateRoute,
} from "@/hooks/useRoutes";
import { useAgenciesList } from "@/hooks/useAgencies";
