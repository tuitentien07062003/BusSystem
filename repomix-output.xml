// src/admin/components/trips/TripFilterBar.jsx
// Bộ lọc trung tâm cho Dashboard quản lý chuyến xe
import { useEffect, useRef } from "react";
import { Search, X, RefreshCw } from "lucide-react";
import { Input } from "@/components/ui/input";
import {
  Select,
  SelectTrigger,
  SelectValue,
  SelectContent,
  SelectItem,
} from "@/components/ui/select";

// ═══════════════════════════════════════════════════════════════
// MAIN COMPONENT
// ═══════════════════════════════════════════════════════════════
export function TripFilterBar({
  // State values
  date,
  routeId,
  directionId,
  status,
  searchInput,
  // Setters
  onDateChange,
  onRouteChange,
  onDirectionChange,
  onStatusChange,
  onSearchChange,
  // Options
  routes = [],
  // Actions
  onRefresh,
  isFetching,
}) {
  const inputRef = useRef(null);

  // Phím tắt "/" để focus ô tìm kiếm
  useEffect(() => {
    const onKey = (e) => {
      if (
        e.key === "/" &&
        !["INPUT", "TEXTAREA"].includes(document.activeElement?.tagName)
      ) {
        e.preventDefault();
        inputRef.current?.focus();
      }
    };
    window.addEventListener("keydown", onKey);
    return () => window.removeEventListener("keydown", onKey);
  }, []);

  return (
    <div className="bg-white rounded-lg border border-[#E5EAF0] p-3">
      <div className="flex flex-wrap items-center gap-2">
        {/* ─── Ngày ─── */}
        <div className="flex items-center gap-2">
          <label className="text-[11px] font-semibold text-[#6A7A9A] whitespace-nowrap">
            Ngày
          </label>
          <Input
            type="date"
            value={date}
            onChange={(e) => onDateChange(e.target.value)}
            className="w-[150px] font-mono text-sm h-9"
          />
        </div>

        {/* ─── Tuyến ─── */}
        <Select value={routeId} onValueChange={onRouteChange}>
          <SelectTrigger className="w-[180px] h-9">
            <SelectValue placeholder="Tất cả tuyến" />
          </SelectTrigger>
          <SelectContent>
            <SelectItem value="all">Tất cả tuyến</SelectItem>
            {routes.map((r) => (
              <SelectItem key={r.id} value={String(r.id)}>
                {r.route_short_name} ({r.route_id})
              </SelectItem>
            ))}
          </SelectContent>
        </Select>

        {/* ─── Hướng ─── */}
        <Select value={directionId} onValueChange={onDirectionChange}>
          <SelectTrigger className="w-[150px] h-9">
            <SelectValue placeholder="Tất cả hướng" />
          </SelectTrigger>
          <SelectContent>
            <SelectItem value="all">Tất cả hướng</SelectItem>
            <SelectItem value="0">Chiều đi</SelectItem>
            <SelectItem value="1">Chiều về</SelectItem>
          </SelectContent>
        </Select>

        {/* ─── Trạng thái ─── */}
        <Select value={status} onValueChange={onStatusChange}>
          <SelectTrigger className="w-[150px] h-9">
            <SelectValue placeholder="Trạng thái" />
          </SelectTrigger>
          <SelectContent>
            <SelectItem value="all">Tất cả trạng thái</SelectItem>
            <SelectItem value="scheduled">Chưa chạy</SelectItem>
            <SelectItem value="in_progress">Đang chạy</SelectItem>
            <SelectItem value="completed">Hoàn thành</SelectItem>
            <SelectItem value="cancelled">Đã hủy</SelectItem>
          </SelectContent>
        </Select>

        {/* ─── Search ─── */}
        <div className="relative flex-1 min-w-[200px]">
          <Search
            size={13}
            className="absolute left-3 top-1/2 -translate-y-1/2 text-[#8A9AAA] pointer-events-none"
          />
          <Input
            ref={inputRef}
            value={searchInput}
            onChange={(e) => onSearchChange(e.target.value)}
            placeholder="Tìm theo mã chuyến…  (nhấn / để focus)"
            className="h-9 pl-8 pr-8"
          />
          {searchInput && (
            <button
              type="button"
              onClick={() => onSearchChange("")}
              className="absolute right-2 top-1/2 -translate-y-1/2 w-5 h-5 rounded flex items-center justify-center text-[#8A9AAA] hover:bg-[#F0F3F7] hover:text-[#1A2332] cursor-pointer"
            >
              <X size={12} />
            </button>
          )}
        </div>

        {/* ─── Refresh ─── */}
        <button
          type="button"
          onClick={onRefresh}
          disabled={isFetching}
          title="Tải lại"
          className="h-9 w-9 flex-shrink-0 rounded-md border border-[#D0D7E2] bg-white hover:bg-[#F8FAFC] disabled:opacity-50 flex items-center justify-center cursor-pointer"
        >
          <RefreshCw
            size={13}
            className={
              isFetching ? "animate-spin text-[#169BA2]" : "text-[#6A7A9A]"
            }
          />
        </button>
      </div>
    </div>
  );
}
</file>

<file path="src/admin/components/trips/TripFormDialog.jsx">
import { useEffect } from 'react';
import { useForm } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';
import { z } from 'zod';
import {
  Dialog, DialogContent, DialogHeader, DialogTitle, DialogDescription, DialogFooter,
} from '@/components/ui/dialog';
import { Input } from '@/components/ui/input';
import { Label } from '@/components/ui/label';
import { Button } from '@/components/ui/button';
import { Switch } from '@/components/ui/switch';
import { useCreateTrip, useUpdateTrip } from '@/hooks/useTrips';

const schema = z.object({
  trip_id: z.string().trim().min(1, 'Mã chuyến không được để trống'),
  trip_pattern_id: z.coerce.number().int().optional().nullable(),
  service_id: z.coerce.number().int().optional().nullable(),
  start_time: z.string().min(1, 'Giờ xuất bến bắt buộc'),
  is_active: z.boolean(),
});

export function TripFormDialog({ trip, open, onOpenChange }) {
  const isEdit = !!trip;
  const createMut = useCreateTrip();
  const updateMut = useUpdateTrip();

  const { register, handleSubmit, reset, watch, setValue, formState: { errors, isSubmitting } } = useForm({
    resolver: zodResolver(schema),
    defaultValues: {
      trip_id: '', trip_pattern_id: null, service_id: null, start_time: '06:00:00', is_active: true,
    },
  });

  useEffect(() => {
    if (open) {
      reset(
        trip
          ? {
              trip_id: trip.trip_id || '',
              trip_pattern_id: trip.trip_pattern_id ?? null,
              service_id: trip.service_id ?? null,
              start_time: trip.start_time || '06:00:00',
              is_active: trip.is_active ?? true,
            }
          : {
              trip_id: '', trip_pattern_id: null, service_id: null, start_time: '06:00:00', is_active: true,
            }
      );
    }
  }, [open, trip, reset]);

  const isActive = watch('is_active');

  const onSubmit = async (values) => {
    const payload = {
      ...values,
      trip_pattern_id: values.trip_pattern_id || null,
      service_id: values.service_id || null,
    };
    if (isEdit) await updateMut.mutateAsync({ id: trip.id, payload });
    else await createMut.mutateAsync(payload);
    onOpenChange(false);
  };

  return (
    <Dialog open={open} onOpenChange={onOpenChange}>
      <DialogContent className="max-w-lg">
        <DialogHeader>
          <DialogTitle>{isEdit ? `Sửa chuyến #${trip.id}` : 'Thêm chuyến xe'}</DialogTitle>
        </DialogHeader>

        <form onSubmit={handleSubmit(onSubmit)} className="px-5 py-4 space-y-3">
          <div className="space-y-1">
            <Label>Mã chuyến *</Label>
            <Input {...register('trip_id')} placeholder="VD: T_19_GO_01" disabled={isEdit} />
            {errors.trip_id && <p className="text-[11px] text-[#c0392b]">{errors.trip_id.message}</p>}
          </div>

          <div className="grid grid-cols-2 gap-3">
            <div className="space-y-1">
              <Label>Pattern ID</Label>
              <Input type="number" {...register('trip_pattern_id')} placeholder="—" />
            </div>
            <div className="space-y-1">
              <Label>Service ID</Label>
              <Input type="number" {...register('service_id')} placeholder="—" />
            </div>
          </div>

          <div className="space-y-1">
            <Label>Giờ xuất bến * (HH:MM:SS)</Label>
            <Input {...register('start_time')} placeholder="06:00:00" />
            {errors.start_time && <p className="text-[11px] text-[#c0392b]">{errors.start_time.message}</p>}
          </div>

          <div className="flex items-center justify-between py-1">
            <Label>Đang hoạt động</Label>
            <Switch checked={isActive} onCheckedChange={(v) => setValue('is_active', v)} />
          </div>

          <DialogFooter className="-mx-5 -mb-4">
            <Button type="button" variant="secondary" onClick={() => onOpenChange(false)} disabled={isSubmitting}>Hủy</Button>
            <Button type="submit" variant="primary" disabled={isSubmitting}>
              {isSubmitting ? 'Đang lưu...' : isEdit ? 'Lưu' : 'Tạo mới'}
            </Button>
          </DialogFooter>
        </form>
      </DialogContent>
    </Dialog>
  );
}
</file>

