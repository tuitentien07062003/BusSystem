function timeToSec(t) {
  if (!t) return 0;
  const [h, m] = String(t).split(":").map(Number);
  return h * 3600 + m * 60;
}

function secToTime(sec) {
  const h = Math.floor(sec / 3600);
  const m = Math.floor((sec % 3600) / 60);
  const p = (n) => String(n).padStart(2, "0");
  return `${p(h)}:${p(m)}`;
