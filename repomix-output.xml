import { useEffect } from "react";
import { useForm } from "react-hook-form";
import { zodResolver } from "@hookform/resolvers/zod";
import { z } from "zod";
import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
  DialogDescription,
  DialogFooter,
} from "@/components/ui/dialog";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Button } from "@/components/ui/button";
import {
  useCreateCalendar,
  useUpdateCalendar,
} from "@/hooks/useServiceCalendars";

const DAYS = [
  { key: "monday", label: "T2" },
  { key: "tuesday", label: "T3" },
  { key: "wednesday", label: "T4" },
  { key: "thursday", label: "T5" },
  { key: "friday", label: "T6" },
  { key: "saturday", label: "T7" },
  { key: "sunday", label: "CN" },
];

// ═══════════════════════════════════════════════════════════════
// Schema — thêm headway_multiplier
// ═══════════════════════════════════════════════════════════════
const schema = z
  .object({
    service_id: z.string().trim().min(1, "Mã lịch không được để trống"),
    start_date: z.string().min(1, "Ngày bắt đầu bắt buộc"),
    end_date: z.string().min(1, "Ngày kết thúc bắt buộc"),
    monday: z.boolean(),
    tuesday: z.boolean(),
    wednesday: z.boolean(),
    thursday: z.boolean(),
    friday: z.boolean(),
    saturday: z.boolean(),
    sunday: z.boolean(),

    // ─── MỚI ───
    headway_multiplier: z.coerce
      .number()
      .min(0.1, "Hệ số tối thiểu 0.1")
      .max(5.0, "Hệ số tối đa 5.0"),
  })
  .refine((d) => new Date(d.end_date) >= new Date(d.start_date), {
    message: "Ngày kết thúc phải sau ngày bắt đầu",
    path: ["end_date"],
  });

export function CalendarFormDialog({ calendar, open, onOpenChange }) {
  const isEdit = !!calendar;
  const createMut = useCreateCalendar();
  const updateMut = useUpdateCalendar();

  const {
    register,
    handleSubmit,
    reset,
    watch,
    setValue,
    formState: { errors, isSubmitting },
  } = useForm({
    resolver: zodResolver(schema),
    defaultValues: {
      service_id: "",
      start_date: "",
      end_date: "",
      monday: true,
      tuesday: true,
      wednesday: true,
      thursday: true,
      friday: true,
      saturday: false,
      sunday: false,
      headway_multiplier: 1.0, // ← MỚI
    },
  });

  useEffect(() => {
    if (open) {
      reset(
        calendar
          ? {
              service_id: calendar.service_id || "",
              start_date: calendar.start_date || "",
              end_date: calendar.end_date || "",
              monday: !!calendar.monday,
              tuesday: !!calendar.tuesday,
              wednesday: !!calendar.wednesday,
              thursday: !!calendar.thursday,
              friday: !!calendar.friday,
              saturday: !!calendar.saturday,
              sunday: !!calendar.sunday,
              headway_multiplier: calendar.headway_multiplier ?? 1.0, // ← MỚI
            }
          : {
              service_id: "",
              start_date: "",
              end_date: "",
              monday: true,
              tuesday: true,
              wednesday: true,
              thursday: true,
              friday: true,
              saturday: false,
              sunday: false,
              headway_multiplier: 1.0, // ← MỚI
            },
      );
    }
  }, [open, calendar, reset]);

  const onSubmit = async (values) => {
    if (isEdit)
      await updateMut.mutateAsync({ id: calendar.id, payload: values });
    else await createMut.mutateAsync(values);
    onOpenChange(false);
  };

  return (
    <Dialog open={open} onOpenChange={onOpenChange}>
      <DialogContent className="max-w-lg">
        <DialogHeader>
          <DialogTitle>
            {isEdit ? `Sửa lịch #${calendar.id}` : "Thêm lịch phục vụ"}
          </DialogTitle>
          <DialogDescription>
            Chọn các ngày trong tuần và khoảng thời gian áp dụng.
          </DialogDescription>
        </DialogHeader>

        <form onSubmit={handleSubmit(onSubmit)} className="px-5 py-4 space-y-3">
          <div className="space-y-1">
            <Label>Mã lịch *</Label>
            <Input
              {...register("service_id")}
              placeholder="VD: WEEKDAY"
              disabled={isEdit}
            />
            {errors.service_id && (
              <p className="text-[11px] text-[#c0392b]">
                {errors.service_id.message}
              </p>
            )}
          </div>

          <div className="grid grid-cols-2 gap-3">
            <div className="space-y-1">
              <Label>Ngày bắt đầu *</Label>
              <Input type="date" {...register("start_date")} />
              {errors.start_date && (
                <p className="text-[11px] text-[#c0392b]">
                  {errors.start_date.message}
                </p>
              )}
            </div>
            <div className="space-y-1">
              <Label>Ngày kết thúc *</Label>
              <Input type="date" {...register("end_date")} />
              {errors.end_date && (
                <p className="text-[11px] text-[#c0392b]">
                  {errors.end_date.message}
                </p>
              )}
            </div>
          </div>

          <div className="space-y-2">
            <Label>Ngày chạy trong tuần</Label>
            <div className="flex flex-wrap gap-2">
              {DAYS.map((d) => {
                const checked = watch(d.key);
                return (
                  <button
                    key={d.key}
                    type="button"
                    onClick={() => setValue(d.key, !checked)}
                    className={`px-3 py-1.5 rounded-md text-xs font-semibold border transition-colors cursor-pointer ${
                      checked
                        ? "bg-[#169BA2] text-white border-[#169BA2]"
                        : "bg-white text-[#6a7a9a] border-[#cbd5e1] hover:border-[#169BA2]"
                    }`}
                  >
                    {d.label}
                  </button>
                );
              })}
            </div>
          </div>

          {/* ═══════════ HỆ SỐ GIÃN CÁCH — MỚI ═══════════ */}
          <div className="space-y-2 pt-4 border-t border-[#e5eaf0]">
            <Label className="flex items-center gap-1.5">
              Hệ số giãn cách
              <span className="text-[10px] text-[#8a9aaa] font-normal">
                (nhân vào base headway)
              </span>
            </Label>

            <div className="flex items-center gap-3">
              <div className="relative flex-1">
                <Input
                  type="number"
                  step="0.1"
                  min="0.1"
                  max="5.0"
                  {...register("headway_multiplier")}
                  className="pr-14 font-mono font-semibold"
                />
                <span className="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-[#8a9aaa] pointer-events-none">
                  lần
                </span>
              </div>

              {/* Quick presets */}
              <div className="flex gap-1">
                {[
                  { v: 0.8, l: "0.8" },
                  { v: 1.0, l: "1.0" },
                  { v: 1.2, l: "1.2" },
                  { v: 1.5, l: "1.5" },
                ].map((p) => (
                  <button
                    key={p.v}
                    type="button"
                    onClick={() =>
                      setValue("headway_multiplier", p.v, { shouldDirty: true })
                    }
                    className="px-2 py-1 rounded text-[10px] font-semibold bg-[#f8fafc] border border-[#e5eaf0] hover:bg-[#e6f4f5] hover:border-[#a8d5d8] cursor-pointer transition-colors"
                  >
                    {p.l}
                  </button>
                ))}
              </div>
            </div>

            <p className="text-[10px] text-[#8a9aaa] leading-relaxed">
              <b>1.0</b> = bình thường, <b>1.2</b> = giãn 20% (ít chuyến hơn),
              <b> 0.8</b> = dày 20% (nhiều chuyến hơn).
            </p>

            {errors.headway_multiplier && (
              <p className="text-[11px] text-[#c0392b]">
                {errors.headway_multiplier.message}
              </p>
            )}
          </div>

          <DialogFooter className="-mx-5 -mb-4">
            <Button
              type="button"
              variant="secondary"
              onClick={() => onOpenChange(false)}
              disabled={isSubmitting}
            >
              Hủy
            </Button>
            <Button type="submit" variant="primary" disabled={isSubmitting}>
              {isSubmitting
                ? "Đang lưu..."
                : isEdit
                  ? "Lưu thay đổi"
                  : "Tạo mới"}
            </Button>
          </DialogFooter>
        </form>
      </DialogContent>
    </Dialog>
  );
}
</file>

<file path="frontend/src/admin/components/calendars/CalendarsTable.jsx">
import { Pencil, Trash2 } from 'lucide-react';
import { Badge } from '@/components/ui/badge';
import { DataTable } from '@/components/ui/data-table';
import { useDeleteCalendar } from '@/hooks/useServiceCalendars';

const DAY_LABELS = ['T2', 'T3', 'T4', 'T5', 'T6', 'T7', 'CN'];
const DAY_KEYS = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'];

export function CalendarsTable({ calendars, isLoading, onEdit, sortBy, sortOrder, onSort }) {
  const deleteMut = useDeleteCalendar();

  const columns = [
    { key: 'id', label: 'ID', sortable: true, width: 60,
      render: (r) => <span className="text-[#6a7a9a] font-mono text-xs">{r.id}</span> },
    { key: 'service_id', label: 'Mã lịch', sortable: true,
      render: (r) => <span className="font-mono text-xs text-[#169BA2] font-semibold">{r.service_id}</span> },
    { key: 'days', label: 'Ngày chạy',
      render: (r) => (
        <div className="flex gap-0.5">
          {DAY_KEYS.map((k, i) => (
            <span key={k} className={`text-[10px] w-6 h-6 rounded flex items-center justify-center font-bold ${
              r[k] ? 'bg-[#E6F4F5] text-[#169BA2]' : 'bg-[#eef2f6] text-[#b0bcca]'
            }`}>
              {DAY_LABELS[i]}
            </span>
          ))}
        </div>
      ) },
    { key: 'start_date', label: 'Bắt đầu',
      render: (r) => <span className="text-xs text-[#4a5a7a]">{r.start_date}</span> },
    { key: 'end_date', label: 'Kết thúc',
      render: (r) => <span className="text-xs text-[#4a5a7a]">{r.end_date}</span> },
    { key: 'actions', label: 'Hành động', align: 'center', width: 100,
      render: (r) => (
        <div className="flex items-center justify-center gap-1">
          <button onClick={() => onEdit(r)} className="h-7 w-7 rounded-md border border-[#cbd5e1] bg-white hover:bg-[#eef2f6] flex items-center justify-center cursor-pointer">
            <Pencil size={12} className="text-[#169BA2]" />
          </button>
          <button
            onClick={() => { if (confirm(`Xóa lịch "${r.service_id}"?`)) deleteMut.mutate(r.id); }}
            disabled={deleteMut.isPending}
            className="h-7 w-7 rounded-md border border-[#f5b7b1] bg-white hover:bg-[#fde8e8] flex items-center justify-center cursor-pointer disabled:opacity-50"
          >
            <Trash2 size={12} className="text-[#c0392b]" />
          </button>
        </div>
      ) },
  ];

  return (
    <DataTable
      columns={columns}
      rows={calendars}
      isLoading={isLoading}
      emptyMessage="Chưa có lịch phục vụ nào"
      sortBy={sortBy}
      sortOrder={sortOrder}
      onSort={onSort}
    />
  );
}
</file>

<file path="frontend/src/admin/components/routes/DepotSelector.jsx">
import { useState, useMemo } from 'react';
import { Search, MapPin, X } from 'lucide-react';
import { Input } from '@/components/ui/input';
import { matchesSearch } from '@/lib/vietnamese';

function DepotPicker({ depots, value, onChange, placeholder, disabled }) {
  const [open, setOpen] = useState(false);
  const [kw, setKw] = useState('');

  const filtered = useMemo(() => {
    if (!kw.trim()) return depots;
    return depots.filter(
      (d) =>
        matchesSearch(d.stop_name, kw) ||
        matchesSearch(d.stop_id, kw)
    );
  }, [depots, kw]);

  const selected = depots.find((d) => d.id === value);

  return (
    <div className="relative">
      <button
        type="button"
        disabled={disabled}
        onClick={() => setOpen((v) => !v)}
        className={`w-full h-9 px-3 rounded-md border bg-white text-sm text-left flex items-center justify-between gap-2 cursor-pointer transition-colors ${
          disabled
            ? 'border-[#e5eaf0] text-[#b0bcca] cursor-not-allowed'
            : 'border-[#cbd5e1] hover:border-[#169BA2]'
        }`}
      >
        {selected ? (
          <span className="flex items-center gap-1.5 min-w-0">
            <MapPin size={13} className="text-[#169BA2] flex-shrink-0" />
            <span className="truncate font-medium text-[#1a2332]">{selected.stop_name}</span>
            <span className="text-[10px] text-[#8a9aaa] font-mono flex-shrink-0">{selected.stop_id}</span>
          </span>
        ) : (
          <span className="text-[#8a9aaa]">{placeholder}</span>
        )}
        {selected && !disabled && (
          <X
            size={14}
            className="text-[#8a9aaa] hover:text-[#c0392b] flex-shrink-0"
            onClick={(e) => {
              e.stopPropagation();
              onChange(null);
            }}
          />
        )}
      </button>

      {open && !disabled && (
        <>
          <div className="fixed inset-0 z-40" onClick={() => setOpen(false)} />
          <div className="absolute top-full left-0 right-0 mt-1 z-50 bg-white rounded-md border border-[#d0d7e2] shadow-lg overflow-hidden">
            <div className="p-2 border-b border-[#eef2f6]">
              <div className="relative">
                <Search size={12} className="absolute left-2.5 top-1/2 -translate-y-1/2 text-[#8a9aaa]" />
                <Input
                  value={kw}
                  onChange={(e) => setKw(e.target.value)}
                  placeholder="Tìm depot (không cần dấu)..."
                  className="h-8 pl-7 text-xs"
                  autoFocus
                />
              </div>
            </div>
            <div className="max-h-[240px] overflow-y-auto scrollbar-thin">
              {filtered.length === 0 ? (
                <div className="px-3 py-6 text-center text-xs text-[#8a9aaa]">
                  Không tìm thấy depot nào
                </div>
              ) : (
                filtered.map((d) => (
                  <button
                    key={d.id}
                    type="button"
                    onClick={() => {
                      onChange(d.id);
                      setOpen(false);
                      setKw('');
                    }}
                    className={`w-full flex items-center justify-between gap-2 px-3 py-2 text-left text-xs hover:bg-[#eef2f6] cursor-pointer ${
                      value === d.id ? 'bg-[#E6F4F5]' : ''
                    }`}
                  >
                    <span className="flex items-center gap-1.5 min-w-0">
                      <MapPin size={11} className="text-[#169BA2] flex-shrink-0" />
                      <span className="truncate font-medium text-[#1a2332]">{d.stop_name}</span>
                    </span>
                    <span className="text-[10px] text-[#8a9aaa] font-mono flex-shrink-0">{d.stop_id}</span>
                  </button>
                ))
              )}
            </div>
          </div>
        </>
      )}
    </div>
  );
}

export function DepotSelector({ depots, startId, endId, onStartChange, onEndChange }) {
  return (
    <div className="space-y-3">
      <div className="space-y-1">
        <div className="flex items-center gap-1.5">
          <span className="w-5 h-5 rounded-full bg-[#169BA2] text-white text-[10px] font-bold flex items-center justify-center">
            Đ
          </span>
          <span className="text-xs font-semibold text-[#4a5a7a]">Điểm đầu (Depot)</span>
        </div>
        <DepotPicker
          depots={depots}
          value={startId}
          onChange={onStartChange}
          placeholder="Chọn điểm đầu"
        />
      </div>

      <div className="space-y-1">
        <div className="flex items-center gap-1.5">
          <span className="w-5 h-5 rounded-full bg-[#c0392b] text-white text-[10px] font-bold flex items-center justify-center">
            C
          </span>
          <span className="text-xs font-semibold text-[#4a5a7a]">Điểm cuối (Depot)</span>
        </div>
        <DepotPicker
          depots={depots}
          value={endId}
          onChange={onEndChange}
          placeholder="Chọn điểm cuối"
          disabled={!startId}
        />
      </div>

      {startId && endId && startId === endId && (
        <div className="text-[11px] text-[#c0392b] bg-[#fde8e8] border border-[#f5b7b1] rounded px-2 py-1.5">
          ⚠ Điểm đầu và điểm cuối phải khác nhau
        </div>
      )}
    </div>
  );
}
</file>

<file path="frontend/src/admin/components/routes/RoadPickerDialog.jsx">
import { useState, useEffect } from "react";
import { X, Check, Loader2, Map, RotateCcw, Search } from "lucide-react";
import {
  useNearbyRoads,
  useSetStopOverride,
  useRemoveStopOverride,
} from "@/hooks/useStops";

const HIGHWAY_LABELS = {
  trunk: {
    label: "Quốc lộ",
    color: "bg-blue-50 text-blue-700 border-blue-200",
  },
  trunk_link: {
    label: "Nhánh QL",
    color: "bg-blue-50 text-blue-600 border-blue-200",
  },
  primary: {
    label: "Đường chính",
    color: "bg-teal-50 text-teal-700 border-teal-200",
  },
  primary_link: {
    label: "Nhánh chính",
    color: "bg-teal-50 text-teal-600 border-teal-200",
  },
  secondary: {
    label: "Đường phụ",
    color: "bg-slate-50 text-slate-700 border-slate-200",
  },
  secondary_link: {
    label: "Nhánh phụ",
    color: "bg-slate-50 text-slate-600 border-slate-200",
  },
  tertiary: {
    label: "Đường nhánh",
    color: "bg-slate-50 text-slate-600 border-slate-200",
  },
  tertiary_link: {
    label: "Nhánh nhỏ",
    color: "bg-slate-50 text-slate-500 border-slate-200",
  },
};

function HighwayBadge({ highway }) {
  const meta = HIGHWAY_LABELS[highway] || {
    label: highway,
    color: "bg-slate-50 text-slate-600 border-slate-200",
  };
  return (
    <span
      className={`inline-flex items-center px-1.5 py-0.5 rounded border text-[9px] font-bold uppercase tracking-wide ${meta.color}`}
    >
      {meta.label}
    </span>
  );
}

export function RoadPickerDialog({
  open,
  stop,
  currentOverride,
  onClose,
  onSaved,
}) {
  const [keyword, setKeyword] = useState("");
  const [selectedRoadId, setSelectedRoadId] = useState(null);

  const { data: roads = [], isLoading } = useNearbyRoads(
    stop?.id,
    300,
    open && !!stop?.id,
  );
  const setMut = useSetStopOverride();
  const removeMut = useRemoveStopOverride();

  useEffect(() => {
    if (open) {
      setKeyword("");
      setSelectedRoadId(currentOverride?.road_id ?? null);
    }
  }, [open, currentOverride]);

  const filtered = roads.filter((r) => {
    if (!keyword.trim()) return true;
    const k = keyword.toLowerCase();
    return (r.name || "").toLowerCase().includes(k);
  });

  const handleSave = async () => {
    if (!selectedRoadId || !stop) return;
    await setMut.mutateAsync({ stopId: stop.id, roadId: selectedRoadId });
    onSaved?.();
    onClose();
  };

  const handleRemove = async () => {
    if (!stop) return;
    await removeMut.mutateAsync(stop.id);
    onSaved?.();
    onClose();
  };

  if (!open || !stop) return null;

  return (
    <div className="fixed inset-0 z-[9997] flex items-center justify-center p-4">
      {/* Overlay */}
      <div
        className="absolute inset-0 bg-slate-900/40 backdrop-blur-sm z-[9998]"
        onClick={onClose}
      />

      {/* Dialog */}
      <div className="relative w-full max-w-2xl bg-white rounded-2xl shadow-2xl border border-slate-200 flex flex-col max-h-[85vh] z-[9999]">
        {/* Header */}
        <div className="flex items-start justify-between gap-3 px-5 py-4 border-b border-slate-100">
          <div className="flex items-center gap-3 min-w-0">
            <div className="w-10 h-10 rounded-xl bg-teal-50 flex items-center justify-center flex-shrink-0">
              <Map size={18} className="text-teal-700" />
            </div>
            <div className="min-w-0">
              <div className="text-sm font-bold text-slate-900 leading-tight">
                Chọn đường cho trạm
              </div>
              <div className="text-xs text-slate-500 truncate">
                {stop.stop_name}
              </div>
            </div>
          </div>
          <button
            type="button"
            onClick={onClose}
            className="w-8 h-8 rounded-lg hover:bg-slate-100 flex items-center justify-center text-slate-500 hover:text-slate-900 cursor-pointer flex-shrink-0"
          >
            <X size={16} />
          </button>
        </div>

        {/* Current override */}
        {currentOverride && (
          <div className="px-5 py-3 bg-amber-50/50 border-b border-amber-100">
            <div className="flex items-center gap-2 text-[11px]">
              <span className="font-semibold text-amber-800">
                Đang override:
              </span>
              <span className="text-slate-900 font-medium">
                {currentOverride.road_name}
              </span>
              <HighwayBadge highway={currentOverride.highway} />
              <span className="text-slate-500">
                · {currentOverride.distance_m}m
              </span>
            </div>
          </div>
        )}

        {/* Search */}
        <div className="px-5 py-3 border-b border-slate-100">
          <div className="relative">
            <Search
              size={14}
              className="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none"
            />
            <input
              value={keyword}
              onChange={(e) => setKeyword(e.target.value)}
              placeholder="Tìm theo tên đường..."
              className="w-full h-9 pl-9 pr-3 rounded-lg border border-slate-200 bg-white text-sm outline-none focus:border-teal-600 focus:ring-2 focus:ring-teal-600/20"
            />
          </div>
        </div>

        {/* Road list */}
        <div className="flex-1 overflow-y-auto">
          {isLoading ? (
            <div className="py-12 flex flex-col items-center justify-center gap-2 text-slate-400">
              <Loader2 size={20} className="animate-spin text-teal-700" />
              <span className="text-xs">Đang tải danh sách đường...</span>
            </div>
          ) : filtered.length === 0 ? (
            <div className="py-12 text-center text-sm text-slate-400">
              {keyword
                ? "Không có đường khớp"
                : "Không có đường nào trong 300m"}
            </div>
          ) : (
            <div className="p-2">
              {filtered.map((r) => {
                const isSelected = selectedRoadId === r.id;
                return (
                  <button
                    key={r.id}
                    type="button"
                    onClick={() => setSelectedRoadId(r.id)}
                    className={`w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-left transition-colors mb-1 ${
                      isSelected
                        ? "bg-teal-50 border-l-2 border-l-teal-700"
                        : "hover:bg-slate-50 border-l-2 border-l-transparent"
                    }`}
                  >
                    <div
                      className={`w-4 h-4 rounded-full border-2 flex items-center justify-center flex-shrink-0 ${
                        isSelected
                          ? "border-teal-700 bg-teal-700"
                          : "border-slate-300"
                      }`}
                    >
                      {isSelected && (
                        <Check
                          size={10}
                          className="text-white"
                          strokeWidth={3}
                        />
                      )}
                    </div>

                    <div className="flex-1 min-w-0">
                      <div className="flex items-center gap-2 mb-0.5">
                        <span className="text-sm font-semibold text-slate-900 truncate">
                          {r.name || "(không tên)"}
                        </span>
                        <HighwayBadge highway={r.highway} />
                      </div>
                      <div className="text-[10px] text-slate-500 flex items-center gap-2">
                        <span>Cách {r.distance_m}m</span>
                        {r.oneway && r.oneway !== "no" && (
                          <>
                            <span>·</span>
                            <span className="text-amber-700 font-medium">
                              1 chiều
                            </span>
                          </>
                        )}
                        {r.lanes && (
                          <>
                            <span>·</span>
                            <span>{r.lanes} làn</span>
                          </>
                        )}
                      </div>
                    </div>
                  </button>
                );
              })}
            </div>
          )}
        </div>

        {/* Footer */}
        <div className="flex items-center gap-2 px-5 py-4 border-t border-slate-100 bg-slate-50/50">
          {currentOverride && (
            <button
              type="button"
              onClick={handleRemove}
              disabled={removeMut.isPending}
              className="h-10 px-4 rounded-lg border border-rose-200 bg-white text-xs font-semibold text-rose-600 hover:bg-rose-50 transition-colors disabled:opacity-50 cursor-pointer flex items-center gap-1.5"
            >
              <RotateCcw size={12} />
              Xoá override
            </button>
          )}

          <div className="flex-1" />

          <button
            type="button"
            onClick={onClose}
            className="h-10 px-4 rounded-lg border border-slate-200 bg-white text-sm font-semibold text-slate-700 hover:bg-slate-100 transition-colors cursor-pointer"
          >
            Hủy
          </button>

          <button
            type="button"
            onClick={handleSave}
            disabled={!selectedRoadId || setMut.isPending}
            className="h-10 px-5 rounded-lg bg-teal-700 hover:bg-teal-800 text-white text-sm font-semibold flex items-center gap-2 transition-all disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer shadow-sm"
          >
            {setMut.isPending ? (
              <>
                <Loader2 size={14} className="animate-spin" /> Đang lưu...
              </>
            ) : (
              <>
                <Check size={14} /> Lưu đường
              </>
            )}
          </button>
        </div>
      </div>
    </div>
  );
}
</file>

