                      {f.comment || "(không có nội dung)"}
                    </div>
                    <div className="text-[10px] text-[#8A9AAA] mt-0.5">
                      {format(new Date(f.created_at), "dd/MM HH:mm")}
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  );
}

function KpiCard({ icon: Icon, label, value, color, small }) {
